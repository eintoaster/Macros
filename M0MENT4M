{
}

; during the run-up W is sent again and again, the way a held key repeats (so the game always sees W held)
BBhopKeepW()
{
    global BBhopPhase
    if (BBhopPhase != 1) {
        SetTimer(BBhopKeepW, 0)
        return
    }
    SendInput("{Blind}{w down}")
}

; you let go of W during the run-up: the macro presses W again at once (some games read the keyboard in a way that still sees
; your release, so swallowing it alone is not enough)
BBhopWUp(*)
{
    global BBhopPhase
    if (BBhopPhase = 1)
        SendInput("{Blind}{w down}")
}

