; ---------- rendering ----------
; How far the animations move this frame, in 60 fps frames: a slow frame moves them further, so a fade or a scroll takes
; the same time on every PC (they used to take 3 times longer when the menu drew slowly, and kept it busy all that time).
Global NLFrameK := 1.0, NLFrameAt := 0, NLInFrame := false, NLFullDue := true

NLRender()
{
    global NLFrameK, NLFrameAt, NLInFrame
    now := A_TickCount
    dt := now - NLFrameAt
    NLFrameK := (dt > 120 || dt <= 0) ? 1.0 : Max(0.5, Min(3.0, dt / 16.67))      ; (after a pause: one normal step)
    NLFrameAt := now
    NLInFrame := true
    try NLRenderBody()
    finally NLInFrame := false
}

; one step of an ease-out (factor per 60 fps frame), scaled by the frame time
NLEase(factor) => (NLInFrame && NLFrameK != 1.0) ? 1 - (1 - factor) ** NLFrameK : factor

NLRenderBody()
{
    global NLG, NLW, NLH, NLAnimating, NLHits, NLHitsB, NLPageAnim, NLAlphaPage, CurrentTab, NLSubTab
    global NLFontUI, NLFontSm, NLFontTitle, NLFontIcon, NLHoverId, NLStyle, SPDD, SPCust
    if (NLStyle = "sp") {
        SPRender()
        return
    }
    NLAnimating := false
    NLHitsB := []
    NLAlphaPage := 1.0
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", NLG, "UInt", 0)
    NLWinXf()

    ; page fade / slide-in (restarts on every tab change)
    NLPageAnim += (1.0 - NLPageAnim) * NLEase(0.06)
    if (NLPageAnim > 0.985)
        NLPageAnim := 1.0
    else
        NLAnimating := true

    if (NLStyle = "fat") {
        NLRenderFat()
        return
    }
    ; window
    wc := SPCust.Has("panel") ? SPHexArr(SPCust["panel"]) : [9, 12, 21]
    NLRR(0, 0, NLW, NLH, 10, NLC(wc[1], wc[2], wc[3], 238))
    NLRRLine(0, 0, NLW, NLH, 10, NLC(255, 255, 255, 14))

    ; title
    tw := NLTextW("M0MENT4M", NLFontTitle)
    NLText("M0MENT4M", 85 - tw / 2 + 1, 18, NLAccent(), NLFontTitle)
    NLText("M0MENT4M", 85 - tw / 2, 18, NLWhite(), NLFontTitle)

    ; sidebar
    y := 70
    NLText("MOVEMENT", 20, y, NLWhite(128), NLFontSm)
