SPNavItem(n, icon, label, y)
{
    global CurrentTab, NLHoverId, NLFontUI, NLFontB, NLFontIcon, NLG, SPSkin
    id := "tab" n
    t := NLLerp(id, (CurrentTab = n) ? 1 : 0, 0.22)
    hv := NLLerp(id "h", (NLHoverId = id) ? 1 : 0, 0.25)
    if (SPSkin = "sl") {                                      ; (Silentium: a pink fade from the left, a bar on the edge)
        NLRR(12, y, 200, 36, 10, SPCol("Hover", Round(200 * hv * (1 - t))))
