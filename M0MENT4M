        NLText(RDIcons[i], x - 1, ry, col, GSIcon, 20, 24, 1, 1)
        NLText(txt, x + 22, ry, col, GSFont, tw + 10, 24, 0, 1)
        if (r.t > 0.05 && on) {                                   ; the spinning circle while it runs
