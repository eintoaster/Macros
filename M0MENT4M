            NLRR(-5, -29, 10, 8, 2, w)
            NLLineW(15, -15, 21, -21, w, 4)
            NLDisc(0, 4, 25, w)
            NLDisc(0, 4, 20, dark)
            Loop 12 {
                a := (A_Index - 1) * 0.5236
                NLLineW(Cos(a) * 15.5, 4 + Sin(a) * 15.5, Cos(a) * 18.5, 4 + Sin(a) * 18.5, w, Mod(A_Index, 3) = 1 ? 2.2 : 1.2)
            }
            a := -1.5708 + Mod(A_TickCount, 1500) / 1500 * 6.2832     ; (the hand runs)
            NLLineW(0, 4, Cos(a) * 15, 4 + Sin(a) * 15, cc, 3)
            NLDisc(0, 4, 3, cc)
        case 5:
            for xx in [-11, 11] {
                if (neon)
                    NLRR(xx - 10, -27, 20, 54, 7, glow)
                NLRR(xx - 6.5, -23, 13, 46, 4, w)
            }
        case 6:                                               ; (the connection is gone)
            for r in [9, 18, 27] {
                if (neon)
                    DllCall("gdiplus\GdipDrawArc", "Ptr", NLG, "Ptr", NLPen(glow, 9, 1), "Float", -r, "Float", 16 - r, "Float", 2 * r, "Float", 2 * r, "Float", 225, "Float", 90)
                DllCall("gdiplus\GdipDrawArc", "Ptr", NLG, "Ptr", NLPen(w, 4.4, 1), "Float", -r, "Float", 16 - r, "Float", 2 * r, "Float", 2 * r, "Float", 225, "Float", 90)
            }
            NLDisc(0, 16, 4.5, w)
            NLLineW(-24, -20, 22, 26, dark, 9)
            NLLineW(-24, -20, 22, 26, cc, 4.5)
        case 7:                                               ; (a glitching ghost: you "teleport")
            gh := []
            Loop 13 {
                a := 3.1416 + (A_Index - 1) * 0.2618
                gh.Push(Cos(a) * 20, -6 + Sin(a) * 22)
            }
            gh.Push(20, 24, 13, 16, 7, 24, 0, 16, -7, 24, -13, 16, -20, 24)
            KAGlow(gh, c2, neon)
            j := (Mod(A_TickCount // 90, 3) - 1) * 2                     ; (the coloured copies jitter)
            for cp in [[-3 + j, NLC(255, 60, 130, 160)], [3 - j, NLC(60, 220, 255, 160)]] {
                sh := []
                for idx, v in gh
                    sh.Push(Mod(idx, 2) ? v + cp[1] : v)
                HWPoly(sh, cp[2])
            }
            HWPoly(gh, w)
            NLDisc(-7, -6, 3.8, dark)
            NLDisc(7, -6, 3.8, dark)
            NLRR(-26, 4 + j, 16, 3, 1, cc)
            NLRR(12, -14 - j, 14, 3, 1, cc)
        default:                                              ; (high ping: the bars fall, a red X)
            for k, hh in [12, 20, 28, 36] {
                bx := -26 + (k - 1) * 12
                if (neon && k <= 2)
                    NLRR(bx - 3, 26 - hh - 3, 13, hh + 6, 4, glow)
                NLRR(bx, 26 - hh, 8, hh, 2.5, k <= 2 ? w : NLC(255, 255, 255, 70))
            }
            if (neon)
                NLDisc(17, -16, 15, NLC(255, 70, 90, 70))
            NLDisc(17, -16, 11, NLC(255, 70, 90))
            NLLineW(12, -21, 22, -11, w, 2.8)
            NLLineW(22, -21, 12, -11, w, 2.8)
    }
}

; the icon in the middle: 1 skull, 2 crossed batons, 3 crosshair, 4 flame, 5 lightning, 6 star, 7 burst
KAIcon(i, c2, neon)
{
    global NLG
    w := NLC(255, 255, 255), dark := NLC(16, 16, 26)
    switch i {
        case 1:
            if (neon)
                NLDisc(0, 0, 26, NLC(c2[1], c2[2], c2[3], 50))
            NLDisc(0, -5, 20, w)
            NLRR(-11, 6, 22, 15, 4, w)
            NLDisc(-7.5, -6, 5.8, dark), NLDisc(7.5, -6, 5.8, dark)
            HWPoly([0, 1, -3.5, 8, 3.5, 8], dark)
            for xx in [-6, 0, 6]
                NLLineW(xx, 14, xx, 21, dark, 1.8)
        case 2:
            for ex in [22, -22] {
                if (neon)
                    NLLineW(-ex, -22, ex, 22, NLC(c2[1], c2[2], c2[3], 70), 14)
                NLLineW(-ex, -22, ex, 22, w, 7)
                NLLineW(ex * 0.5, 11, ex * 0.78, 17, dark, 7.5)
                NLDisc(ex, 22, 5.2, w)
                NLDisc(-ex, -22, 4.2, w)
            }
        case 3:
            if (neon)
                DllCall("gdiplus\GdipDrawEllipse", "Ptr", NLG, "Ptr", NLPen(NLC(c2[1], c2[2], c2[3], 80), 10, 1), "Float", -18, "Float", -18, "Float", 36, "Float", 36)
            DllCall("gdiplus\GdipDrawEllipse", "Ptr", NLG, "Ptr", NLPen(w, 3.6, 1), "Float", -18, "Float", -18, "Float", 36, "Float", 36)
            for d in [[0, -1], [0, 1], [-1, 0], [1, 0]]
                NLLineW(d[1] * 10, d[2] * 10, d[1] * 28, d[2] * 28, w, 3.6)
            NLDisc(0, 0, 3.6, w)
        case 4:
            fl := [0, -32, 10, -14, 19, 3, 15, 20, 0, 29, -15, 20, -19, 3, -9, -9, -4, -18]
            KAGlow(fl, c2, neon)
            HWPoly(fl, w)
            HWPoly([0, -6, 8, 7, 7, 17, 0, 21, -7, 17, -8, 7], NLC(c2[1], c2[2], c2[3]))
        case 5:
            bolt := [7, -32, -15, 5, -2, 5, -9, 33, 15, -7, 2, -7]
            KAGlow(bolt, c2, neon)
            HWPoly(bolt, w)
        case 6:
            st := LAStarPts(0, 0, 27)
            KAGlow(st, c2, neon)
            HWPoly(st, w)
        default:
            bu := []
            Loop 24 {
                a := -1.5708 + (A_Index - 1) * 0.2618, r := Mod(A_Index, 2) ? 30 : 14
                bu.Push(Cos(a) * r, Sin(a) * r)
            }
            KAGlow(bu, c2, neon)
            HWPoly(bu, w)
            NLDisc(0, 0, 7, NLC(c2[1], c2[2], c2[3]))
    }
}

