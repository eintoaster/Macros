; ---------- dropdown list (opens under the selector, animated) ----------
Global SPDD := 0
Global SPNavScroll := 0.0, SPNavScrollT := 0.0, SPNavH := 0
Global SPLogoSel := SPLogoSelC()
SetTimer(SPLogoTick, 66)

SPOpenDD(id, ddl, after, *)
{
    global SPDD, NLAnim
    if (IsObject(SPDD) && SPDD.id = id && SPDD.open) {
        SPDD.open := false
        NLRequest()
        return
    }
    SPDD := {id: id, ddl: ddl, after: after, items: HasProp(ddl, "items") ? ddl.items : ControlGetItems(ddl), open: true, scroll: 0, ax: 0, ay: 0, aw: 190}
    NLAnim["ddx"] := 0.0
    NLRequest()
}

SPCloseDD(*)
{
    global SPDD
    if (IsObject(SPDD))
        SPDD.open := false
    NLRequest()
}

SPPickDD(i, *)
{
    global SPDD
    d := SPDD
    if (!IsObject(d))
        return
    d.open := false
    d.ddl.Choose(i)
    if (d.after)
        d.after.Call()
    NLRequest()
}

SPDrawDD()
{
    global SPDD, NLG, NLW, NLH, NLAlphaPage, NLHoverId, NLFontSm
    if (!IsObject(SPDD))
        return
    d := SPDD
    t := NLLerp("ddx", d.open ? 1 : 0, 0.3)
    if (!d.open && t <= 0.01) {
        SPDD := 0
        return
    }
    n := d.items.Length
    rowH := 30
    vis := Max(1, Min(n, 7))
    fullH := vis * rowH + 8
    h := fullH * t
    x := d.ax, w := d.aw
    y := d.ay + 32
    if (y + fullH > NLH - 8 && d.ay - 4 - fullH > 70)
        y := d.ay - 4 - h
    NLAlphaPage := Min(1.0, t * 1.4)
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", NLG, "Int", Floor(x - 6), "Int", Floor(y - 2), "Int", w + 12, "Int", Ceil(h) + 8, "Int", 0)
    NLRR(x - 1, y + 3, w + 2, fullH, 11, NLC(0, 0, 0, 55))
    NLRR(x, y, w, fullH, 10, SPCol("Card"))
    NLRR(x, y, w, fullH, 10, SPCol("Hover", 140))
    NLRRLine(x, y, w, fullH, 10, SPCol("Border"))
    ; more entries than fit: a scrollbar on the right that can be dragged (or clicked) - not every touchpad scrolls the menu
    maxS := Max(0, (n - vis) * rowH)
    d.scroll := Max(0, Min(maxS, d.scroll))
    sb := (maxS > 0) ? 12 : 0
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", NLG, "Int", Floor(x), "Int", Floor(y + 2), "Int", w, "Int", Max(0, Ceil(Min(h, fullH)) - 4), "Int", 0)   ; (entries stay inside the box)
    Loop n {
        i := A_Index
        iy := y + 4 + (i - 1) * rowH - d.scroll
        if (iy + rowH < y + 2 || iy > y + fullH - 2)
            continue
        sel := (d.ddl.Value = i)
        hv := NLLerp("ddh" i, (NLHoverId = "ddi" i) ? 1 : 0, 0.25)
        NLRR(x + 4, iy, w - 8 - sb, rowH - 2, 7, SPCol("Active", Round(255 * Max(sel ? 0.7 : 0, hv * 0.8))))
        if (d.id = "logo" || d.id = "p_hudgrad") {
            Loop 6 {
                c := SPLogoRGB(i, A_Index, 6)
                NLRR(x + 12 + (A_Index - 1) * 7, iy + 8, 7, 12, 2, NLC(c[1], c[2], c[3]))
            }
            NLText(d.items[i], x + 62, iy, sel ? SPAccMix("Text", 1) : SPCol("Text"), NLFontSm, w - 72 - sb, rowH - 2, 0, 1)
        } else
            NLText(d.items[i], x + 14, iy, sel ? SPAccMix("Text", 1) : SPCol("Text"), NLFontSm, w - 28 - sb, rowH - 2, 0, 1)
    }
    if (sb) {
        global NLDragVert
        tTop := y + 6, tH := fullH - 12
        thH := Max(26, tH * vis / n)
        thY := tTop + (tH - thH) * (d.scroll / maxS)
        hotD := (NLHoverId = "vs_dd" || (IsObject(NLDragVert) && NLDragVert.kind = "dd"))
        NLRR(x + w - 11, tTop, 6, tH, 3, SPCol("Track", 160))
        NLRR(x + w - (hotD ? 12 : 11), thY, hotD ? 8 : 6, thH, hotD ? 4 : 3, NLAccent(hotD ? 255 : 190))
    }
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", NLG, "Int", 0, "Int", 0, "Int", NLW, "Int", NLH, "Int", 0)
    NLAlphaPage := 1.0
    if (d.open) {
        NLAddHit("ddbg", 0, 0, NLW, NLH, SPCloseDD)
        Loop n {
            i := A_Index
            iy := y + 4 + (i - 1) * rowH - d.scroll
            if (iy < y + 2 || iy + rowH > y + fullH)
                continue
            NLAddHit("ddi" i, x + 4, iy, w - 8 - sb, rowH - 2, SPPickDD.Bind(i))
        }
        if (sb)
            NLAddHit("vs_dd", x + w - 18, y + 2, 18, fullH - 4, "vscroll", {kind: "dd", top: tTop, trackH: tH, thumbH: thH, max: maxS})
    }
}

