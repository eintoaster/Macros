RDMakePattern(w, h)
{
    Critical                                                 ; (draws with its own graphics; nothing may interrupt it halfway)
    bmp := 0, g := 0
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", w, "Int", h, "Int", 0, "Int", 0x26200A, "Ptr", 0, "Ptr*", &bmp)
    DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", &g)
    DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", g, "Int", 4)
    seed := 7
    rnd(lo, hi) {
        seed := Mod(seed * 1103515245 + 12345, 2147483648)
        return lo + (hi - lo) * (seed / 2147483648)
    }
    col := (60 << 24) | (92 << 16) | (100 << 8) | 178        ; (a fixed colour: not faded with the page)
    step := 84
    y := 30
    row := 0
    while (y < h - 20) {
        x := 30 + (Mod(row, 2) ? step / 2 : 0)
        while (x < w - 20) {
            px := x + rnd(-16, 16), py := y + rnd(-14, 14)
            if (px > 18 && py > 18 && px < w - 18 && py < h - 18)
                RDDoodle(g, Floor(rnd(0, 7)), px, py, rnd(9, 13), rnd(-25, 25), col)
            x += step
        }
        y += step * 0.78
        row += 1
    }
    DllCall("gdiplus\GdipDeleteGraphics", "Ptr", g)
    return bmp
}

; one thin-line doodle: 0 umbrella, 1 palm, 2 sun, 3 star, 4 ball, 5 sunglasses, 6 ice cream
RDDoodle(g, kind, cx, cy, s, rot, col)
{
    pen := NLPen(col, 1.4, 1)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", g, "Float", cx, "Float", cy, "Int", 0)
    DllCall("gdiplus\GdipRotateWorldTransform", "Ptr", g, "Float", rot, "Int", 0)
    arc(x, y, ww, hh, a0, sweep) => DllCall("gdiplus\GdipDrawArc", "Ptr", g, "Ptr", pen, "Float", x, "Float", y, "Float", ww, "Float", hh, "Float", a0, "Float", sweep)
    ln(x1, y1, x2, y2) => DllCall("gdiplus\GdipDrawLine", "Ptr", g, "Ptr", pen, "Float", x1, "Float", y1, "Float", x2, "Float", y2)
    switch kind {
        case 0:                                               ; umbrella
            arc(-s, -s * 0.8, 2 * s, 1.6 * s, 180, 180)
            Loop 3
                arc(-s + (A_Index - 1) * s * 2 / 3, -s * 0.12, s * 2 / 3, s * 0.4, 180, -180)
            ln(0, -s * 0.8, 0, s * 0.9)
            arc(0, s * 0.6, s * 0.5, s * 0.6, 0, 180)
        case 1:                                               ; palm
            ln(0, s, s * 0.15, 0), ln(s * 0.15, 0, 0, -s * 0.5)
            for a in [-150, -110, -60, -20]
                arc(-s * 0.1 + (a < -90 ? -s : 0), -s * 0.9, s, s * 0.8, a < -90 ? -10 : 190, a < -90 ? -150 : 150)
        case 2:                                               ; sun
            DllCall("gdiplus\GdipDrawEllipse", "Ptr", g, "Ptr", pen, "Float", -s * 0.45, "Float", -s * 0.45, "Float", s * 0.9, "Float", s * 0.9)
            Loop 8 {
                a := A_Index * 0.7854
                ln(Cos(a) * s * 0.7, Sin(a) * s * 0.7, Cos(a) * s, Sin(a) * s)
            }
        case 3:                                               ; star
            pts := Buffer(80, 0)
            Loop 10 {
                a := -1.5708 + (A_Index - 1) * 0.6283, r := Mod(A_Index, 2) ? s : s * 0.45
                NumPut("Float", Cos(a) * r, pts, (A_Index - 1) * 8), NumPut("Float", Sin(a) * r, pts, (A_Index - 1) * 8 + 4)
            }
            DllCall("gdiplus\GdipDrawPolygon", "Ptr", g, "Ptr", pen, "Ptr", pts, "Int", 10)
        case 4:                                               ; beach ball
            DllCall("gdiplus\GdipDrawEllipse", "Ptr", g, "Ptr", pen, "Float", -s, "Float", -s, "Float", 2 * s, "Float", 2 * s)
            arc(-s * 0.5, -s, s, 2 * s, 90, 180)
            arc(-s * 0.2, -s, s * 1.2, 2 * s, 270, 180)
        case 5:                                               ; sunglasses
            DllCall("gdiplus\GdipDrawEllipse", "Ptr", g, "Ptr", pen, "Float", -s, "Float", -s * 0.35, "Float", s * 0.85, "Float", s * 0.7)
            DllCall("gdiplus\GdipDrawEllipse", "Ptr", g, "Ptr", pen, "Float", s * 0.15, "Float", -s * 0.35, "Float", s * 0.85, "Float", s * 0.7)
            arc(-s * 0.15, -s * 0.2, s * 0.3, s * 0.3, 200, 140)
        case 6:                                               ; ice cream
            arc(-s * 0.55, -s, s * 1.1, s * 1.1, 160, 220)
            ln(-s * 0.5, -s * 0.25, 0, s), ln(s * 0.5, -s * 0.25, 0, s)
    }
    DllCall("gdiplus\GdipRotateWorldTransform", "Ptr", g, "Float", -rot, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", g, "Float", -cx, "Float", -cy, "Int", 0)
}

