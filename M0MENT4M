WHudEnsure(wd)
{
    if (IsObject(wd.gui))
        return
    NLGdipInit()
    wd.gui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "M0MENT4M widget " wd.id)
    dc := 0, bmp := 0, g := 0
    VigMakeSurface(Ceil(wd.w * 1.6), Ceil(wd.h * 1.6), &dc, &bmp, &g)
    wd.dc := dc, wd.bmp := bmp, wd.g := g
    wd.thru := true
}

WHudShowOne(wd)
{
    WHudEnsure(wd)
    HAnimStart(wd.id)
    wd.gui.Show("x" wd.x " y" wd.y " w" WHudScaled(wd, wd.w) " h" WHudScaled(wd, wd.h) " NA")
    wd.thru := true
    if (wd.id != "fps")
        LiveEnsure()
    SetTimer(WHudDragTick, 20)
    SetTimer(WHudSecond, 1000)
    WHudRender(wd)
    if (wd.id = "fps" && !FpsBegin()) {
        wd.on := false
        WHudHideOne(wd)
    }
}

WHudHideOne(wd)
{
    if (wd.id = "fps" && !(WMVisible && WMFps && FpsInstalled()))      ; (the watermark bar keeps the counter running for its FPS)
        FpsEnd()
    if (IsObject(wd.gui) && DllCall("IsWindowVisible", "Ptr", wd.gui.Hwnd))
        HAnimLeave(wd.id, WHudHideNow.Bind(wd))
    else
        WHudHideNow(wd)
}

WHudHideNow(wd)
{
    if (wd.on)                                 ; (switched on again in the meantime)
        return
    if (IsObject(wd.gui))
        wd.gui.Hide()
}

WHudToggle(id, *)
{
    global WH
    wd := WH[id]
    wd.on := !wd.on
    if (wd.on)
        WHudShowOne(wd)
    else
        WHudHideOne(wd)
    SPSavePrefs()
