    DllCall('gdiplus\GdipFillClosedCurve2', 'Ptr', G, 'Ptr', Brush(argb), 'Ptr', pts, 'Int', arr.Length, 'Float', 0.7, 'Int', 0)
}

Butterflies(n0, t) {
    n := Max(5, Min(10, Round(n0 / 12)))
    pt := Part(9, n)
    Loop n {
        i := A_Index
        k := pt.k[i]
        sp := 22 + 34 * pt.a[i]
        x := Mod(pt.x[i] + sp * t / 1000, sw + 200) - 100
        y := pt.y[i] + 46 * Sin(t / (1500 + k * 900) + k * 7) + 16 * Sin(t / 430 + k * 3)
        s := 13 + 12 * pt.a[i]
        fl := 0.25 + 0.75 * Abs(Sin(t / (120 + k * 70) + k * 5))
        Disc(x, y, s * 3.4, Argb(16, [255, 150, 185]))
        for side in [-1, 1] {
            FillCurve([[x, y - s * 0.05], [x + side * s * 1.05 * fl, y - s * 0.95], [x + side * s * 1.3 * fl, y - s * 0.3], [x + side * s * 0.45 * fl, y + s * 0.05]], Argb(232, [250, 248, 252]))
            FillCurve([[x, y + s * 0.05], [x + side * s * 0.9 * fl, y + s * 0.2], [x + side * s * 0.72 * fl, y + s * 0.85], [x + side * s * 0.18 * fl, y + s * 0.55]], Argb(214, [244, 238, 246]))
        }
        Disc(x, y - s * 0.12, s * 0.2, Argb(255, [90, 80, 92]))
        Disc(x, y + s * 0.12, s * 0.18, Argb(255, [90, 80, 92]))
    }
}

Ribbons(n0, t) {
