; ===== Misc > Fun: hit effects on a key (no macro, nothing is sent to the game - the key still goes through).
; Every press (for example M1 when you hit a nextbot with the baton) plays the screen effect, the shake and the sound of the
; lagswitch freeze (with your settings from the Lagswitch page, but without freezing anything) and a kill announcer that shows
; a different logo every time: KILL, DOUBLE KILL ... GODLIKE (10), then it starts over. Off by default. =====
FunHit(*)
{
    global FunOn
    if (FunOn)
        FunFire()
}

FunTest(*)
{
    FunFire(true)
}

FunFire(test := false)
{
    global FunVig, FunShake, FunSound, FunAnn, FunDur, VigState, FxHelperPid, FunFxIdx, FunShakeAmt
    static last := 0, lastStyle := 0
    if (A_TickCount - last < 60)                              ; (a double click does not play everything twice)
        return
    last := A_TickCount
    if (FunVig && FunFxIdx < 9) {                             ; the kill screen effects (a random one: never the same twice in a row)
        sty := FunFxIdx
        if (sty = 1) {
            Loop {
                sty := Random(2, 8)
            } until (sty != lastStyle)
        }
        lastStyle := sty
        KFStart(sty)
    } else if (FunVig) {
        if (IsObject(VigState) && VigState.HasOwnProp("fun") && VigState.fun) {
            VigState.hideAt := 0                              ; (already showing from the last hit: it simply stays a bit longer)
            SetTimer(FunVigHide, -FunDur)
        } else if (!IsObject(VigState)) {                     ; (a real lagswitch freeze has its own effect: it is left alone)
            ShowFreezeVignette(0, true)
            SetTimer(FunVigHide, -FunDur)
        }
    }
    if (FunShake)
        FunShakeStart(FunDur, FunShakeAmt)
    if (FunSound)
        FunSoundPlay()
    if (FunAnn)
        FunAnnounce()
}

; The hit shake moves the game window itself a few pixels (and puts it back exactly where it was): the game keeps running.
; (The lagswitch shake shakes a picture of the frozen game instead - that would look like a freeze here.)
Global FunShk := 0

FunShakeStart(len, amt := 40)
{
    global FunShk, GAME_EXE
    hw := WinExist(GAME_EXE)
    if (!hw)
        return
    if (!IsObject(FunShk) || FunShk.hw != hw) {
        try WinGetPos(&x, &y, , , "ahk_id " hw)
        catch
            return
        FunShk := {hw: hw, x: x, y: y}
    }
    FunShk.t0 := A_TickCount, FunShk.len := Max(80, len), FunShk.amt := amt, FunShk.ang := Random(0, 6283) / 1000
    SetTimer(FunShakeTick, 10)
}

FunShakeTick()
{
    global FunShk
    if (!IsObject(FunShk)) {
        SetTimer(FunShakeTick, 0)
        return
    }
    el := A_TickCount - FunShk.t0
    if (el >= FunShk.len || !WinExist("ahk_id " FunShk.hw)) {
        FunShakeRestore()
        return
    }
    global FunShakeStyle
    a0 := 3 + FunShk.amt * 0.18, p := el / FunShk.len
    a := a0 * (1 - p) ** 1.4
    r() => Random(0, 2000) / 1000 - 1
    switch FunShakeStyle {
        case 2:                                               ; Punch: one hard hit in a random direction that springs back
            k := a0 * 1.6 * Exp(-el / 90) * Cos(el / 22)
            dx := Cos(FunShk.ang) * k, dy := Sin(FunShk.ang) * k
        case 3:                                               ; Horizontal: fast left / right
            dx := a * 1.2 * Sin(el / 11), dy := r() * a * 0.15
        case 4:                                               ; Vertical: fast up / down
            dx := r() * a * 0.15, dy := a * 1.2 * Sin(el / 11)
        case 5:                                               ; Earthquake: big, slower rolling that fades late
            e := a0 * 1.3 * (1 - p) ** 0.7
            dx := e * (Sin(el / 41) + 0.5 * Sin(el / 17)) / 1.5 + r() * e * 0.2
            dy := e * (Sin(el / 33 + 1) + 0.5 * Sin(el / 13)) / 1.5 + r() * e * 0.2
        case 6:                                               ; Recoil: kicks up and settles back down
            dy := -a0 * 1.5 * Exp(-el / 75) + r() * a * 0.2, dx := r() * a * 0.3
        default:                                              ; Jitter
            dx := r() * a, dy := r() * a
    }
    dx := Round(dx), dy := Round(dy)
    DllCall("SetWindowPos", "Ptr", FunShk.hw, "Ptr", 0, "Int", FunShk.x + dx, "Int", FunShk.y + dy, "Int", 0, "Int", 0, "UInt", 0x15)
}

FunShakeRestore(*)
{
    global FunShk
    SetTimer(FunShakeTick, 0)
    if (IsObject(FunShk)) {
        try DllCall("SetWindowPos", "Ptr", FunShk.hw, "Ptr", 0, "Int", FunShk.x, "Int", FunShk.y, "Int", 0, "Int", 0, "UInt", 0x15)
        FunShk := 0
    }
}
OnExit(FunShakeRestore)

FunVigHide()
