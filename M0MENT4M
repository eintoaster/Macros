; ===== Lagswitch announcer: a kill-banner style emblem at the bottom of the screen every time you lagswitch (like the kill
; banners in Valorant or the emblems in CrossFire). Every lagswitch builds the streak (no time limit) up to ten: the emblem grows wings,
; the title changes (LAG ... LAG GOD), the stars fill and then turn gold, a crown appears. Colours follow the
; logo gradient. Its own click-through window; off by default (Lagswitch > Announcer). =====
LagAnnounce()
{
    global LAOn, LAStreak, LALast, LAMode, LACur, LALagIcon, LALagFrame
    if (!LAOn)
        return
    LAStreak := (LAStreak < 10) ? LAStreak + 1 : 1             ; (no time limit: every lagswitch counts up; after LAG GOD (10) it starts over)
    LALast := A_TickCount
    Loop {                                                    ; a new logo every time: both the icon and the frame change
        i := Random(1, 8), f := Random(1, 6)
        if (i != LALagIcon && f != LALagFrame)
            break
    }
    LALagIcon := i, LALagFrame := f
    LAMode := "lag", LACur := LAStreak
    LAShow()
}

; shows the banner (the lagswitch one or the kill one of Misc > Fun)
LAShow()
{
    global LAAt, LAGui, LADC, LABmp, LAG, LAW, LAH
    LAAt := A_TickCount
    if (!IsObject(LAGui)) {
        NLGdipInit()
        LAGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "M0MENT4M announcer")
        dc := 0, bmp := 0, g := 0
        VigMakeSurface(LAW, LAH, &dc, &bmp, &g)
        LADC := dc, LABmp := bmp, LAG := g
    }
    LARender()
    LAGui.Show("x" (A_ScreenWidth - LAW) // 2 " y" (A_ScreenHeight - LAH - 60) " w" LAW " h" LAH " NA")
    SetTimer(LATick, 16)
}

LAToggle(*)
{
    global LAOn
    LAOn := !LAOn
    NLRequest()
}

; "Try the announcer": a streak of three, one every 0.7 s
LATest(*)
{
    LATestStep(1)
}

LATestStep(n)
{
    global LAOn
    was := LAOn
    LAOn := true
    LagAnnounce()
    LAOn := was
    if (n < 3)
        SetTimer(LATestStep.Bind(n + 1), -700)
}

LATick()
{
    global LAGui, LAAt
    if (A_TickCount - LAAt > 2400) {
        SetTimer(LATick, 0)
        if (IsObject(LAGui))
            LAGui.Hide()
        return
    }
    LARender()
}

LARender()
{
    pc := A_IsCritical
    Critical
    try LARenderInner()
    finally Critical(pc ? "On" : "Off")
}

LAStarPts(x, y, r)
{
    pts := []
    Loop 10 {
        a := -1.5708 + (A_Index - 1) * 0.6283, rr := Mod(A_Index, 2) ? r : r * 0.45
        pts.Push(x + Cos(a) * rr, y + Sin(a) * rr)
    }
    return pts
}

LAOutline(pts, argb, wd)
{
    n := pts.Length // 2
    Loop n {
        i := A_Index, j := Mod(A_Index, n) + 1
        NLLineW(pts[2 * i - 1], pts[2 * i], pts[2 * j - 1], pts[2 * j], argb, wd)
    }
}

LARenderInner()
{
    global LAStyle
    if (LAStyle = 2)
        LARenderClassic()
    else
        LARenderNeon()
}

