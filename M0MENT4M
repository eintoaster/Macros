; the frame of an emblem as a flat point list: 1 shield, 2 hexagon, 3 round, 4 star badge, 5 diamond, 6 octagon
KAFramePts(f, k := 1.0)
{
    p := []
    switch f {
        case 1:
            p := [0, -50, 40, -30, 36, 22, 0, 52, -36, 22, -40, -30]
        case 2:
            Loop 6 {
                a := -1.5708 + (A_Index - 1) * 1.0472
                p.Push(Cos(a) * 52, Sin(a) * 52)
            }
        case 3:
            Loop 28 {
                a := (A_Index - 1) * 0.2244
                p.Push(Cos(a) * 48, Sin(a) * 48)
            }
        case 4:
            Loop 16 {
                a := -1.5708 + (A_Index - 1) * 0.3927, r := Mod(A_Index, 2) ? 56 : 44
                p.Push(Cos(a) * r, Sin(a) * r)
            }
        case 5:
            p := [0, -58, 58, 0, 0, 58, -58, 0]
        default:
            Loop 8 {
                a := -1.5708 + 0.3927 + (A_Index - 1) * 0.7854
                p.Push(Cos(a) * 52, Sin(a) * 52)
            }
    }
    if (k != 1.0)
        for i, v in p
            p[i] := v * k
    return p
}

KAGlow(pts, c2, neon)
{
