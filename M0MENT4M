; applyColors = false keeps the current colors (used when a config supplies its own).
ApplyDesign(name, applyColors := true)
{
    global DesignPresets, CurrentDesign, PreDesignColors, AccentColor, BgColor, IconBgColor, PanelColor
    global AllTextControls, SideBtns, TikTokBtn, BtnMin, BtnClose, TitleText, TitleShadow, TitleGlow, PageTitles
    global RainbowBarHeight, PanelBorderPx, MainGui, CurrentTab, DesignDDL, SPSkin
    if (!DesignPresets.Has(name))
        return
    d := DesignPresets[name]
    prev := CurrentDesign
    CurrentDesign := name

    global SPCust, SPDesignApplying
    if (applyColors) {
        SPCust.Clear()                  ; colours picked by hand go back to the new design's own look
        SPDesignApplying := true
        try {
            if (IsObject(d["colors"])) {
                if (!IsObject(PreDesignColors) && prev = "Classic")
                    PreDesignColors := [AccentColor, BgColor, IconBgColor, PanelColor]
                c := d["colors"]
                ApplyAccentColor(c[1]), ApplyBgColor(c[2]), ApplyIconBgColor(c[3]), ApplyPanelColor(c[4])
            } else if (IsObject(PreDesignColors)) {
                c := PreDesignColors
                PreDesignColors := ""
                ApplyAccentColor(c[1]), ApplyBgColor(c[2]), ApplyIconBgColor(c[3]), ApplyPanelColor(c[4])
            }
        } finally
            SPDesignApplying := false
    } else if (name = "Classic") {
        PreDesignColors := ""
    }

    ; Fonts. Glyph/icon controls, page titles and checkboxes keep their own fonts.
    skip := Map()
    for c in SideBtns
        skip[c.Hwnd] := true
    for c in [TikTokBtn, BtnMin, BtnClose, TitleText]
        skip[c.Hwnd] := true
    for c in PageTitles
        skip[c.Hwnd] := true
    for pair in CheckPairs()
        skip[pair[1].Hwnd] := true
    for c in AllTextControls {
        if (skip.Has(c.Hwnd))
            continue
        try c.SetFont("s" d["size"] " norm", d["font"])
    }
    for c in [p2sys, p2colHeader, p2k, ConfigTitleLbl, p5patchHeader]
        try c.SetFont("s" d["size"] " Bold", d["font"])
    for c in PageTitles
        try c.SetFont("s" (d["size"] + 2) " Bold", d["font"])
    for c in AllTextControls
        try c.Opt("c" AccentColor)

    ; Title
    if (d["title"] = "small") {
        TitleShadow.Visible := false
        TitleGlow.Visible := false
        TitleText.SetFont("s9 Bold", "Tahoma")
        TitleText.Move(14, 12, 200, 18)
    } else {
        TitleShadow.Visible := true
        TitleGlow.Visible := true
        TitleText.SetFont("s18 Bold", "Arial Black")
        TitleText.Move(6, 4, 280, 30)
    }

    for c in [BtnSlideKey, BtnBhopKey, BtnBhopHoldKey, BtnStrafeKey, BtnComboKey, BtnCSpamKey, BtnClickKey, BtnSpinbotKey, BtnLagKey]
        try c.SetFont(d["layout"] = "skeet" ? "s7 Bold" : "s" d["size"] " norm", d["layout"] = "skeet" ? "Consolas" : d["font"])

    ; Layout (window size, tabs, boxes), frame + rainbow bar
    RainbowBarHeight := d["rainbowH"]
    PanelBorderPx := d["borderPx"]
    oldSkin := (DesignPresets.Has(prev) && DesignPresets[prev]["layout"] = "nl") ? SPSkin : ""
    if (d["layout"] = "nl") {
        SPSkin := d.Has("skin") ? d["skin"] : ""
        NLSetStyle(d.Has("style") ? d["style"] : "nl")
        try NLRequest()
        try CompSkinChanged()
    }
    RDDesignSwitched(oldSkin, d["layout"] = "nl" ? SPSkin : "")
    ApplyLayout(d["layout"])
    MainGui.GetClientPos(, , &cw, &ch)
    if (LayoutMode = "classic")
        LayoutPanel(cw, ch)
    else if (LayoutMode = "skeet")
        LayoutSkeet(cw, ch)
    PositionRainbowBar(cw)
    SPDesignApplying := true
    try ApplyPanelColor(PanelColor)
    finally SPDesignApplying := false

    if (CurrentTab > 7)
        CurrentTab := 4
    SwitchTab(CurrentTab)
    RefreshChecks()
    try DesignDDL.Choose(name)
    DllCall("RedrawWindow", "Ptr", MainGui.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x0185)
}

; ===== Radiance design: the M0MENT4M layout in deep navy and violet, a faint doodle pattern in the window and glowing
; light ribbons behind the menu. Picking it also switches the menu background effect and the macro HUD to their Radiance
; versions; leaving it puts back what was set before (only if it was changed automatically). =====

RDDesignSwitched(oldSkin, newSkin)
{
    global MenuFxIdx, HudStyleIdx, RDAutoFx, RDAutoHud
    if (oldSkin = newSkin)
        return
    if (oldSkin = "rd" || oldSkin = "sl") {                  ; leaving: what was switched on automatically goes back
        if (RDAutoFx && MenuFxIdx = (oldSkin = "rd" ? 8 : 9))
            MenuFxIdx := 1
        if (RDAutoHud && HudStyleIdx = (oldSkin = "rd" ? 4 : 7))
            HudStyleIdx := RDAutoHud
        RDAutoFx := false, RDAutoHud := 0
    }
    if (newSkin = "rd") {
        if (MenuFxIdx = 1)
            MenuFxIdx := 8, RDAutoFx := true
        if (HudStyleIdx != 4)
            RDAutoHud := HudStyleIdx, HudStyleIdx := 4
    } else if (newSkin = "sl") {                             ; Silentium: white ribbons and butterflies behind the menu, its own macro HUD
        if (MenuFxIdx = 1)
            MenuFxIdx := 9, RDAutoFx := true
        if (HudStyleIdx != 7)
            RDAutoHud := HudStyleIdx, HudStyleIdx := 7
    }
    try HudRequest()
}

; the window background of the Silentium design: a soft pink glow behind the top left and a pink glow along the edge
SLWindowFx()
{
    global NLW, NLH
    Loop 7
        NLDisc(110, 30, 250 - A_Index * 30, NLAccent(7))
    Loop 4
        NLRRLine(A_Index - 1, A_Index - 1, NLW - 2 * (A_Index - 1), NLH - 2 * (A_Index - 1), 18 - A_Index + 1, NLAccent(64 - A_Index * 14))
    NLLineW(40, 1, NLW - 40, 1, NLAccent(110), 1.2)
}

; the Silentium logo: "m0ment4m" in a handwritten font, pink with a soft glow, and a little star; returns where it ends
SLLogo(x, y)
{
    global SPLogoIdx, NLG, NLFmt
    static f := 0, fs := 0, fmt := 0, rc := Buffer(16, 0)
    if (!f) {
        f := NLMakeFont("Segoe Script", 16.5, 1)
        if (!f)
            f := NLMakeFont("Gabriola", 24, 1)
        fs := NLMakeFont("Segoe UI Symbol", 12, 0)
    }
    txt := "m0ment4m"
    w := NLTextW(txt, f)
    if (SPLogoIdx = 1) {                                      ; Accent Flow: the pink of the design
        for o in [[-1, 0], [1, 0], [0, -1], [0, 1], [0, 2]]
            NLText(txt, x + o[1], y + o[2], NLAccent(45), f, w + 12, 36, 0, 1)
        NLText(txt, x, y, NLC(255, 132, 168), f, w + 12, 36, 0, 1)
        sc := [255, 190, 210]
    } else {                                                  ; any other logo colour: the script is filled with that (moving) gradient
        stops := SPLogoStops(SPLogoIdx)
        tt := -A_TickCount / 1000 * 0.32
        if (SPLogoIdx = 10)
            SPFlameWord(x, y + 6, w, A_TickCount / 1000)
        if (!fmt) {                                           ; (an own copy of the string format: NLText keeps track of the shared one's alignment)
            DllCall("gdiplus\GdipCloneStringFormat", "Ptr", NLFmt, "Ptr*", &fmt)
            DllCall("gdiplus\GdipSetStringFormatAlign", "Ptr", fmt, "Int", 0)
            DllCall("gdiplus\GdipSetStringFormatLineAlign", "Ptr", fmt, "Int", 1)
        }
        pc := A_IsCritical
        Critical
        for pass in [0.18, 1.0] {                             ; a soft glow first, then the letters
            br := SPGradBrush(x, y, w + 12, 0, stops, tt, pass)
            for o in (pass < 1 ? [[-1, 0], [1, 0], [0, -1], [0, 1], [0, 2]] : [[0, 0]]) {
                NumPut("Float", x + o[1], rc, 0), NumPut("Float", y + o[2], rc, 4), NumPut("Float", w + 12, rc, 8), NumPut("Float", 36, rc, 12)
                DllCall("gdiplus\GdipDrawString", "Ptr", NLG, "WStr", txt, "Int", -1, "Ptr", f, "Ptr", rc, "Ptr", fmt, "Ptr", br)
            }
            DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
        }
        Critical(pc ? "On" : "Off")
        sc := SPStopsSample(stops, 0.1)
    }
    tw := 0.7 + 0.3 * Sin(A_TickCount / 420)
    NLText(Chr(0x2605), x + w - 2, y - 4, NLC(sc[1], sc[2], sc[3], Round(255 * tw)), fs, 16, 16, 1, 1)
    return x + w + 12
}


; the window background of the Radiance design: doodle pattern (drawn once into a picture) and a soft violet glow on the edge
RDWindowFx(sw)
{
    global NLG, NLW, NLH, NLMaxW, NLMaxH, RDPatBmp
    if (!RDPatBmp)                                           ; (made once, as big as the menu can get: resizing only shows more of it)
        RDPatBmp := RDMakePattern(NLMaxW, NLMaxH)
    DllCall("gdiplus\GdipDrawImageRectRectI", "Ptr", NLG, "Ptr", RDPatBmp, "Int", 0, "Int", 0, "Int", NLW, "Int", NLH
        , "Int", 0, "Int", 0, "Int", NLW, "Int", NLH, "Int", 2, "Ptr", 0, "Ptr", 0, "Ptr", 0)
    Loop 4                                                    ; inner glow along the edge
        NLRRLine(A_Index - 1, A_Index - 1, NLW - 2 * (A_Index - 1), NLH - 2 * (A_Index - 1), 18 - A_Index + 1, NLAccent(70 - A_Index * 15))
    NLLineW(40, 1, NLW - 40, 1, NLAccent(120), 1.2)            ; a brighter line on top
