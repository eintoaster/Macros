; a short click on a waifu ("comp" the one on the screen, "peek" the one on the menu): one click makes her talk (a moment later,
; so that a second click can still turn it into petting), two quick clicks pet her
CompClick(who)
{
    global CompPetOn, CompClickAt, CompClickWho
    if (!CompPetOn) {
        CompSayRandomBy(who)
        return
    }
    if (CompClickAt && A_TickCount - CompClickAt < 400 && CompClickWho = who) {
        CompClickAt := 0
        SetTimer(CompClickSay, 0)
        if (who = "peek")
            CompPeekPet()
        else
            CompPet()
        return
    }
    CompClickAt := A_TickCount, CompClickWho := who
    SetTimer(CompClickSay, -400)
}

CompClickSay()
{
    global CompClickAt, CompClickWho
    CompClickAt := 0
    CompSayRandomBy(CompClickWho)
}

CompPetSay(who := "")
{
    global CompPetLinesElf, CompPetLinesBlair
    pool := (CompWho() = "blair") ? CompPetLinesBlair : CompPetLinesElf
    CompSay(pool[Random(1, pool.Length)], 2400, who)
}

; the one on the screen: a random happy pose (never the same twice in a row), hearts, a happy face
CompPet()
{
    global CompPetState, CompPetLast
    Loop {
        k := Random(1, 5)
        if (k != CompPetLast)
            break
    }
    CompPetLast := k
    CompPetState := {t0: A_TickCount, kind: k, dur: 1700, who: "comp"}
    CompPetSay()
}

; the one peeking over the menu: a happy hop and hearts, and sometimes she climbs out and stands on the menu for a moment
CompPeekPet()
{
    global CompPetState, CompPeekStand, CompPeekDuckAt
    CompPetState := {t0: A_TickCount, kind: 0, dur: 1700, who: "peek"}
    CompPetSay("peek")
    if (!IsObject(CompPeekStand) && Random(1, 100) <= 45) {
        CompPeekStand := {t0: A_TickCount}
        CompPeekDuckAt := Max(CompPeekDuckAt, A_TickCount + 6000)
    }
}

CompPetting(who := "") => IsObject(CompPetState) && A_TickCount - CompPetState.t0 < CompPetState.dur && (who = "" || CompPetState.who = who)

; how far she stands up out of the menu (0 = peeking, 1 = standing on the edge; a little overshoot when she gets up)
CompPeekStandAmt()
{
    global CompPeekStand
    if (!IsObject(CompPeekStand))
        return 0
    el := A_TickCount - CompPeekStand.t0
    if (el >= 2700) {
        CompPeekStand := 0
        return 0
    }
    if (el < 450) {
        u := el / 450
        return 1 + 2.2 * (u - 1) ** 3 + 1.2 * (u - 1) ** 2
    }
    if (el < 2250)
        return 1 + 0.035 * Sin((el - 450) / 1800 * 12.566)
    u := (el - 2250) / 450
    return 1 - u * u * (3 - 2 * u)
}

; ... and how far that lifts her (from her chin on the edge to her feet on the edge), in her units
CompPeekStandNow(&lift)
{
    global CompUseImg, CompImgW, CompImgH
    who := CompWho()
    chin := CompUseImg ? (who = "blair" ? 234 : 164) : (who = "blair" ? 234 : 236)
    feet := CompUseImg ? 84 + 300 * CompImgH / Max(1, CompImgW) : 382
    lift := feet - chin
    return CompPeekStandAmt()
}

; the pose: moves, turns or squeezes her around her feet (added to the drawing's transform before she is drawn)
CompPetXf()
{
    global NLG, CompPetState, CompUseImg, CompImgW, CompImgH
    u := Min(1.0, (A_TickCount - CompPetState.t0) / CompPetState.dur)
    px := CompUseImg ? 150 : 120, py := CompUseImg ? 80 + 300 * CompImgH / Max(1, CompImgW) : 380
    dy := 0, rot := 0, sx := 1, sy := 1
    switch CompPetState.kind {
        case 1:                                               ; two happy hops
            dy := -24 * Abs(Sin(u * 6.2832)) * (1 - 0.3 * u)
        case 2:                                               ; a happy wiggle
            rot := 6 * Sin(u * 18.85) * (1 - u)
        case 3:                                               ; a twirl
            sx := Cos(u * 6.2832), dy := -10 * Sin(u * 3.1416)
            if (Abs(sx) < 0.06)
                sx := (sx < 0) ? -0.06 : 0.06
        case 4:                                               ; shy: she squeezes together and tilts her head
            q := Sin(u * 3.1416)
            sx := 1 + 0.05 * q, sy := 1 - 0.07 * q, rot := -4 * q
        case 5:                                               ; a big jump
            q := Sin(u * 3.1416)
            dy := -58 * q, sy := 1 + 0.05 * q, sx := 1 - 0.03 * q
    }
    CompPetState.dy := dy                                     ; (the hearts go up and down with her)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", NLG, "Float", px, "Float", py + dy, "Int", 0)
    if (rot != 0)
        DllCall("gdiplus\GdipRotateWorldTransform", "Ptr", NLG, "Float", rot, "Int", 0)
    if (sx != 1 || sy != 1)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", NLG, "Float", sx, "Float", sy, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", NLG, "Float", -px, "Float", -py, "Int", 0)
}

; hearts floating up from her head (plus sparkles for the twirl and the jump)
CompPetFx(cx, cy, u, kind)
{
    Loop 6 {
        k := A_Index
        v := u * 1.25 - (k - 1) * 0.07
        if (v <= 0 || v >= 1)
            continue
        hx := cx + (k - 3.5) * 16 + 7 * Sin(v * 9 + k)
        hy := cy - v * 80
        sz := (4.5 + Mod(k, 3) * 1.5) * Min(1.0, v * 5)
        a := Round(235 * (1 - v ** 2))
        col := Mod(k, 2) ? NLC(255, 92, 140, a) : NLC(255, 150, 190, a)
        NLDisc(hx - sz * 0.52, hy, sz * 0.62, col)
        NLDisc(hx + sz * 0.52, hy, sz * 0.62, col)
        HWPoly([hx - sz * 1.1, hy + sz * 0.2, hx + sz * 1.1, hy + sz * 0.2, hx, hy + sz * 1.35], col)
    }
    if (kind = 3 || kind = 5) {
        Loop 8 {
            a := A_Index * 0.785 + u * 2
            r := 30 + 60 * u
            sx := cx + Cos(a) * r, sy := cy + 40 + Sin(a) * r * 0.8
            sz := 5 * (1 - u)
            col := NLC(255, 240, 160, Round(230 * (1 - u)))
            NLLineW(sx - sz, sy, sx + sz, sy, col, 1.6)
            NLLineW(sx, sy - sz, sx, sy + sz, col, 1.6)
        }
    }
}

CompDrawBubble()
{
    global NLFontSm, NLAlphaPage, AccentColor, CompBubbleText, CompBubbleStart, CompBubbleUntil, CompW
    if (CompBubbleText != "" && A_TickCount < CompBubbleUntil + 300) {
        a := Min(1.0, (A_TickCount - CompBubbleStart) / 180)
        rem := CompBubbleUntil - A_TickCount
        if (rem < 300)
            a := Max(0.0, rem / 300)
        NLAlphaPage := a
        lines := Min(3, Max(1, Ceil(StrLen(CompBubbleText) / 26)))
        bh := 18 + lines * 15
        bx := CompW / 2 - 106, bw := 212, by := 62 - bh
        NLRR(bx + 1, by + 3, bw, bh, 12, NLC(0, 0, 0, 50))
        NLRR(bx, by, bw, bh, 12, NLC(255, 250, 255, 244))
        NLRRLine(bx, by, bw, bh, 12, NLAccent(220))
        HWPoly([CompW / 2 - 8, by + bh - 1, CompW / 2 + 10, by + bh - 1, CompW / 2, by + bh + 9], NLC(255, 250, 255, 244))
        NLText(CompBubbleText, bx + 12, by + 8, NLC(58, 38, 72), NLFontSm, bw - 24, bh - 12, 1, 0, true)
        NLAlphaPage := 1.0
    }
}

; ===== The waifu peeking over the top edge of the menu (Waifus > Peek over the menu) =====
; Her own small window sits on the menu's top edge; everything below the edge is cut off, so she looks like she is behind
; the menu, holding on to it. She peeks up when the menu opens, ducks now and then and can be dragged along the edge.

CompPeekK() => 0.72 * CompScale / 100

CompPeekStart()
{
    global CompPeekOn
    if (!CompPeekOn)
        return
    CompPrepare()
    SetTimer(CompPeekTick, 33)
}

CompPeekToggle(*)
{
    global CompPeekOn
    CompPeekOn := !CompPeekOn
    if (CompPeekOn)
        CompPeekStart()
    SPSavePrefs()
    NLRequest()
}

CompPeekToggleSticker(*)
{
    global CompPeekSticker, CompPeekShownAt
    CompPeekSticker := !CompPeekSticker
    if (CompPeekSticker)
        CompPeekShownAt := A_TickCount - 450               ; (the sticker pops in again)
    SPSavePrefs()
}

; where the menu is on screen (false while it is closed)
CompPeekMenu(&x, &y, &w, &h)
{
    global NLShown, NLHwnd, MainGui, isAppMinimized
    x := 0, y := 0, w := 0, h := 0
    if (isAppMinimized)
        return false
    hw := (NLShown && NLHwnd) ? NLHwnd : (IsObject(MainGui) ? MainGui.Hwnd : 0)
    if (!hw || !DllCall("IsWindowVisible", "Ptr", hw))
        return false
    try WinGetPos(&x, &y, &w, &h, "ahk_id " hw)
    catch
        return false
    return w > 60
}

CompPeekHide()
{
    global CompPeekGui, CompPeekDrag
    CompPeekDrag := 0
    if (IsObject(CompPeekGui) && DllCall("IsWindowVisible", "Ptr", CompPeekGui.Hwnd))
        CompPeekGui.Hide()
}

CompPeekTick()
{
    global CompPeekOn, CompPeekGui, CompPeekShownAt, CompPeekDuckAt, CompPeekDrag, CompPeekPos, CompPeekW, CompPeekH, CompPeekEdge
    global CompOn, CompBubbleOn, CompReactOn, CompNextChat, CompBubbleUntil, CompPeekDC, CompPeekBmp, CompPeekG
    static wasDown := false, lastZ := 0
    if (!CompPeekOn) {
        SetTimer(CompPeekTick, 0)
        CompPeekHide()
        return
    }
    if (!CompPeekMenu(&mx, &my, &mw, &mh)) {
        CompPeekHide()
        wasDown := false
        return
    }
    k := CompPeekK()
    if (!IsObject(CompPeekGui)) {
        CompPeekGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x08000000 -DPIScale", "M0MENT4M peek")
        dc := 0, bmp := 0, g := 0
        VigMakeSurface(CompPeekW * 2, (CompPeekH + 220) * 2, &dc, &bmp, &g)      ; (room for 200 %, and for standing up on the menu)
        CompPeekDC := dc, CompPeekBmp := bmp, CompPeekG := g
    }
    ; drag her along the edge; a short click and she says something
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    cx := NumGet(pt, 0, "Int"), cy := NumGet(pt, 4, "Int")
    down := (DllCall("GetAsyncKeyState", "Int", 0x01, "Short") & 0x8000) ? true : false
    hx := mx + CompPeekPos * mw, ey := my
    global CompPeekXtra, CompPeekStNow, CompPeekLiftNow
    CompPeekStNow := CompPeekStandNow(&lift), CompPeekLiftNow := lift              ; (petted: she may stand up out of the menu for a moment)
    CompPeekXtra := Min(220, Round(Max(0, CompPeekStNow) * (lift + 20)))          ; (her window grows upwards meanwhile)
    if (IsObject(CompPeekDrag)) {
        if (down)
            CompPeekPos := Max(0.08, Min(0.92, (cx - CompPeekDrag.ox - mx) / mw))
        else {
            if (A_TickCount - CompPeekDrag.t0 < 260 && Abs(cx - CompPeekDrag.x0) < 5)
                CompClick("peek")
            else
                SPSavePrefs()
            CompPeekDrag := 0
        }
    } else if (down && !wasDown && DllCall("IsWindowVisible", "Ptr", CompPeekGui.Hwnd)
        && Abs(cx - hx) < 62 * k && cy > ey - (140 + CompPeekLiftNow * Max(0, CompPeekStNow)) * k && cy < ey + 8)   ; (on her head)
        CompPeekDrag := {ox: cx - hx, t0: A_TickCount, x0: cx}
    wasDown := down
    wx := Round(mx + CompPeekPos * mw - 150 * k), wy := Round(my - (CompPeekEdge + CompPeekXtra) * k)
    if (!DllCall("IsWindowVisible", "Ptr", CompPeekGui.Hwnd)) {
        CompPeekShownAt := A_TickCount, CompPeekDuckAt := A_TickCount + Random(7000, 14000)
        CompPeekRender(wx, wy, k)
        CompPeekGui.Show("x" wx " y" wy " w" Round(CompPeekW * k) " h" Round(CompPeekH * k) " NA")
        lastZ := 0
    }
    if (A_TickCount - lastZ > 300) {                         ; (stays above the menu)
        lastZ := A_TickCount
        DllCall("SetWindowPos", "Ptr", CompPeekGui.Hwnd, "Ptr", -1, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x13)
    }
    if (!CompOn) {                                           ; (the normal waifu is off: this one talks)
        if (CompBubbleOn && CompReactOn)
            CompMacroChat()
        if (CompBubbleOn && A_TickCount > CompNextChat) {
            if (A_TickCount > CompBubbleUntil + 500 && CompNextChat)
                CompSayRandom()
            CompNextChat := A_TickCount + Random(22000, 38000)
        }
    }
    CompPeekRender(wx, wy, k)
}

CompPeekRender(wx, wy, k)
{
    pc := A_IsCritical
    Critical
    try CompPeekRenderInner(wx, wy, k)
    finally Critical(pc ? "On" : "Off")
}

CompPeekRenderInner(wx, wy, k)
{
    global NLG, NLAlphaPage, CompPeekG, CompPeekGui, CompPeekDC, CompUseImg, CompEyeHost, CompOn, CompPeekSticker
    global CompPeekShownAt, CompPeekDuckAt, CompPeekW, CompPeekH, CompPeekEdge, CompPeekXtra, CompPeekStNow, CompPeekLiftNow, CompPetState
    G := CompPeekG
    xt := CompPeekXtra, st := Max(0, CompPeekStNow)
    W := Round(CompPeekW * k), H := Round((CompPeekH + xt) * k), E := CompPeekEdge + xt
    t := A_TickCount / 1000
    ; she peeks up when the menu opens (with a little overshoot) and ducks now and then
    u := Min(1.0, (A_TickCount - CompPeekShownAt) / 520)
    rise := 1 + 2.2 * (u - 1) ** 3 + 1.2 * (u - 1) ** 2
    dy := (1 - rise) * 150 - CompPeekLiftNow * CompPeekStNow                 ; (standing up: lifted until her feet are on the edge)
    if (st <= 0 && CompPetting("peek"))                                       ; (petted: a happy little hop)
        dy -= 8 * Abs(Sin((A_TickCount - CompPetState.t0) / 1700 * 12.566))
    if (st <= 0 && A_TickCount > CompPeekDuckAt) {
        d := (A_TickCount - CompPeekDuckAt) / 900
        if (d >= 1)
            CompPeekDuckAt := A_TickCount + Random(8000, 16000)
        else
            dy += 24 * Sin(d * 3.14159)
    }
    who := CompWho()
    chin := CompUseImg ? (who = "blair" ? 234 : 164) : (who = "blair" ? 234 : 236)   ; (where her chin is in each drawing)
    hx := (CompUseImg && who = "blair") ? 135 : 120
    tx := 150 - hx, ty0 := E - chin - 4
    prevG := NLG, prevA := NLAlphaPage
    NLG := G, NLAlphaPage := 1.0
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", G)
    DllCall("gdiplus\GdipResetClip", "Ptr", G)
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", G, "Int", 0, "Int", 0, "Int", W, "Int", H, "Int", 0)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", G, "UInt", 0)
    ; her, cut off at the menu edge
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", G, "Int", 0, "Int", 0, "Int", W, "Int", Round(E * k), "Int", 0)
    if (CompUseImg)
        CompPeekDrawArt(tx, ty0 + dy, k, t)
    else {
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", G, "Float", k, "Float", k, "Int", 0)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", tx, "Float", ty0 + dy, "Int", 0)
        CompEyeHost := {x: wx + tx * k, y: wy + (ty0 + dy) * k, sc: k}
        global HWCullY
        HWCullY := E - (ty0 + dy) + 2
        try (who = "blair") ? CompDrawBlair(t) : CompDrawElf(t)
        HWCullY := 1e9
        CompEyeHost := 0
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", G)
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", G, "Int", 0, "Int", 0, "Int", W, "Int", H, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", G, "Float", k, "Float", k, "Int", 0)
    ; her hands on the edge (they come up with her)
    ha := CompUseImg ? 0 : Min(1.0, Max(0, (u - 0.45) / 0.4)) * Max(0, 1 - st * 1.6)   ; (hands only on the drawn 3D look; let go while she stands)
    if (ha > 0) {
        NLAlphaPage := ha
        CompPeekHands(150, E, who)
        NLAlphaPage := 1.0
    }
    if (CompPeekSticker) {
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", 0, "Float", xt, "Int", 0)     ; (stays where it was while her window is taller)
        CompPeekStickerDraw(t)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", 0, "Float", -xt, "Int", 0)
    }
    if (CompPetting("peek"))
        CompPetFx(150, ty0 + dy + (CompUseImg ? 100 : 120), (A_TickCount - CompPetState.t0) / CompPetState.dur, 0)
    if (!CompOn || CompBubbleWho = "peek") {                 ; her speech bubble, above her head (her own lines even while the other one is shown)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", tx, "Float", ty0 + 18 - CompPeekLiftNow * st, "Int", 0)
        CompDrawBubble()
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", G)
    NLG := prevG, NLAlphaPage := prevA
    pos := Buffer(8, 0), NumPut("Int", wx, pos, 0), NumPut("Int", wy, pos, 4)
    sz := Buffer(8, 0), NumPut("Int", W, sz, 0), NumPut("Int", H, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", CompPeekGui.Hwnd, "Ptr", 0, "Ptr", pos, "Ptr", sz, "Ptr", CompPeekDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; the 2D artwork at the peeking size (scaled once, then drawn 1:1)
CompPeekDrawArt(tx, ty, k, t)
{
    global CompPeekG, CompPeekArt, CompPeekArtKey, CompImg, CompImgW, CompImgH
    if (!CompImg)
        return
    key := CompImg "|" k
    if (!CompPeekArt || CompPeekArtKey != key) {
        if (CompPeekArt)
            DllCall("gdiplus\GdipDisposeImage", "Ptr", CompPeekArt)
        w := Max(8, Round(300 * k)), h := Max(8, Round(300 * k * CompImgH / CompImgW))
        bmp := 0, g := 0
        DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", w, "Int", h, "Int", 0, "Int", 0x26200A, "Ptr", 0, "Ptr*", &bmp)
        DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", &g)
        DllCall("gdiplus\GdipSetInterpolationMode", "Ptr", g, "Int", 7)
        DllCall("gdiplus\GdipDrawImageRectI", "Ptr", g, "Ptr", CompImg, "Int", 0, "Int", 0, "Int", w, "Int", h)
        DllCall("gdiplus\GdipDeleteGraphics", "Ptr", g)
        CompPeekArt := bmp, CompPeekArtKey := key
    }
    bob := 3 * Sin(t * 1.6)
    DllCall("gdiplus\GdipSetInterpolationMode", "Ptr", CompPeekG, "Int", 6)
    DllCall("gdiplus\GdipDrawImageRect", "Ptr", CompPeekG, "Ptr", CompPeekArt, "Float", tx * k, "Float", (ty + 80 + bob) * k
        , "Float", Round(300 * k), "Float", Round(300 * k * CompImgH / CompImgW))
}

; two little hands holding on to the menu edge
CompPeekHands(cx, ey, who)
{
    global CompUseImg
    skin := (who = "blair") ? (CompUseImg ? NLC(252, 222, 206) : NLC(255, 228, 204)) : (CompUseImg ? NLC(250, 234, 230) : NLC(255, 238, 232))
    line := NLC(150, 96, 96, 150)
    for side in [-1, 1] {
        x := cx + side * 42
        HWOval(x, ey + 1, 16.5, 10.5, line)
        HWOval(x, ey + 1, 15, 9, skin)
        HWOval(x - side * 2, ey - 3, 7, 3, NLC(255, 255, 255, 70))             ; (a soft highlight)
        for f in [-6, 0, 6]
            NLLineW(x + f, ey - 6, x + f, ey + 2, line, 1.2)
    }
}

; the "Stay M0MENT4M" sticker next to her head (pops in after she peeked up)
CompPeekStickerDraw(t)
{
    global CompPeekShownAt, CompPeekG, SPLogoIdx
    static font := 0
    a := (A_TickCount - CompPeekShownAt - 480) / 380
    if (a <= 0)
        return
    if (!font)
        font := NLMakeFont("Segoe UI Black", 21, 2)
    u := Min(1.0, a)
    s := 1 + 2.4 * (u - 1) ** 3 + 1.4 * (u - 1) ** 2
    G := CompPeekG
    txt := "Stay M0MENT4M"
    tw := NLTextW(txt, font)
    bw := tw + 34, bh := 44
    sy := 150 + 3 * Sin(t * 2.2), rot := -9 + 1.5 * Sin(t * 1.7)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", 318, "Float", sy, "Int", 0)
    DllCall("gdiplus\GdipRotateWorldTransform", "Ptr", G, "Float", rot, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", G, "Float", s, "Float", s, "Int", 0)
    NLRR(-bw / 2 + 3, -bh / 2 + 6, bw, bh, 22, NLC(0, 0, 0, 70))                   ; shadow
    HWPoly([-bw / 2 + 14, bh / 2 - 6, -bw / 2 + 42, bh / 2 - 6, -bw / 2 + 2, bh / 2 + 18], NLC(255, 255, 255))   ; tail
    NLRR(-bw / 2 - 4, -bh / 2 - 4, bw + 8, bh + 8, 26, NLC(255, 255, 255))         ; white outline
    SPGradFill(-bw / 2, -bh / 2, bw, bh, 22, SPLogoStops(SPLogoIdx), t * 0.25, 1.0)
    NLText(txt, -bw / 2 + 1, -bh / 2 + 2, NLC(40, 0, 30, 120), font, bw, bh, 1, 1)
    NLText(txt, -bw / 2, -bh / 2, NLC(255, 255, 255), font, bw, bh, 1, 1)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", G, "Float", 1 / s, "Float", 1 / s, "Int", 0)
    DllCall("gdiplus\GdipRotateWorldTransform", "Ptr", G, "Float", -rot, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", G, "Float", -318, "Float", -sy, "Int", 0)
}

