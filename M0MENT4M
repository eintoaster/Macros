ShadeHex(R, G, B, delta)
{
    R := Max(0, Min(255, R + delta))
    G := Max(0, Min(255, G + delta))
    B := Max(0, Min(255, B + delta))
    return Format("{:02X}{:02X}{:02X}", R, G, B)
}

