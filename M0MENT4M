Global CompPetLinesElf := ["Ah... that feels nice.", "Hehe... thank you.", "You're very gentle.", "My head? ...Alright, just a little more.", "That's... rather pleasant.", "I wasn't expecting that. But I like it.", "Mm. You may continue.", "So warm..."]
