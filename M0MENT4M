class FunSoundSelC {
    items := ["Hit marker", "Kill ding", "Headshot", "Beep", "Double beep", "Rising chirp", "Falling chirp", "Soft tick", "Custom file...", "Multiple sounds..."]
    custom := 9
    multi := 10
    Value => FunSoundIdx
    Text {
        get {
            global FunSoundIdx, FunSoundFile, FunMulti
            if (FunSoundIdx = this.custom && FunSoundFile != "") {
                SplitPath(FunSoundFile, &nm)
                return "Custom: " nm
            }
            if (FunSoundIdx = this.multi && FunMulti.Length > 0)
                return "Random of " FunMulti.Length " sounds"
            return this.items[FunSoundIdx]
        }
    }
    Choose(i) {
        global FunSoundIdx, FunSoundFile, FunMulti, NLGui, MenuFxHold
        if (i = this.custom || i = this.multi) {
            try NLGui.Opt("-AlwaysOnTop")
            MenuFxHold := true
            if (i = this.multi)
                paths := FileSelect("M3", , "Choose up to 10 sounds (hold Ctrl to pick several): one plays at random for each hit", "Sounds (*.wav; *.mp3)")
            else
                path := FileSelect(3, , "Choose a sound for the hit effects", "Sounds (*.wav; *.mp3)")
            MenuFxHold := false
            try NLGui.Opt("+AlwaysOnTop")
            if (i = this.multi) {
                if (!IsObject(paths) || paths.Length = 0) {
                    if (FunMulti.Length = 0)
                        return
                } else {
                    FunMulti := []
                    for f in paths
                        if (FunMulti.Length < 10)
                            FunMulti.Push(f)
                }
            } else {
                if (path = "")
                    return
                FunSoundFile := path
            }
        }
        FunSoundIdx := i
        FunSoundPlay()
        NLRequest()
    }
}

; the hit sound at its own volume (the tones are built in memory; files play through Windows)
FunSoundPlay()
{
    global FunSoundIdx, FunSoundFile, FunVol, VigVol, FunMulti
    static lastMulti := 0
    keep := VigVol
    VigVol := FunVol
    try {
        switch {
            case FunSoundIdx = 1:
                VigPlayTones([[2600, 12], [1900, 20]])
            case FunSoundIdx = 2:
                VigPlayTones([[1320, 55], [1760, 120]])
            case FunSoundIdx = 3:
                VigPlayTones([[700, 22], [1100, 22], [1650, 30], [2300, 70]])
            case FunSoundIdx <= 8:
                VigBeepPattern(FunSoundIdx - 3, true)
            case FunSoundIdx = 9:
                if (FunSoundFile != "")
                    VigPlayFile(FunSoundFile)
            default:
                n := FunMulti.Length
                if (n > 0) {
                    k := Random(1, n)
                    if (n > 1 && k = lastMulti)
                        k := (k = n) ? 1 : k + 1
                    lastMulti := k
                    VigPlayFile(FunMulti[k])
                }
        }
    }
    VigVol := keep
}

FunMultiText()
{
    global FunMulti
    t := ""
    for f in FunMulti
        t .= (t = "" ? "" : "|") f
    return t
}

