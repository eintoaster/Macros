LARenderClassic()
{
    global LAG, LADC, LAGui, LAW, LAH, LAAt, LACur, LAMode, KANames, LAFont, LAFontS, NLG, NLAlphaPage, SPLogoIdx
    if (!IsObject(LAGui))
        return
    if (!LAFont)
        LAFont := NLMakeFont("Segoe UI Black", 26, 0), LAFontS := NLMakeFont("Segoe UI", 13, 1)
    el := A_TickCount - LAAt, t := A_TickCount / 1000
    tier := Min(LACur, 10), wt := Min(tier, 5)
    fade := (el < 1950) ? 1.0 : Max(0.0, 1 - (el - 1950) / 420)
    u := Min(1.0, el / 380)
    s := (1 + 2.6 * (u - 1) ** 3 + 1.6 * (u - 1) ** 2) * (1 - 0.12 * (1 - fade)) * (0.86 + 0.05 * wt)
    stops := SPLogoStops(SPLogoIdx)
    c1 := SPStopsSample(stops, t * 0.25), c2 := SPStopsSample(stops, t * 0.25 + 0.45)
    prevG := NLG, prevA := NLAlphaPage
    NLG := LAG, NLAlphaPage := fade
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", LAG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", LAG, "UInt", 0)
    cx := LAW / 2, cy := 112
    ; burst: a ring, rays and sparks fly out when it appears
    if (el < 650) {
        b := el / 650, e := 1 - (1 - b) ** 3
        Loop 3
            NLRRLine(cx - (30 + 150 * e) - A_Index, cy - (30 + 150 * e) - A_Index, 2 * (30 + 150 * e + A_Index), 2 * (30 + 150 * e + A_Index), 30 + 150 * e + A_Index, NLC(c1[1], c1[2], c1[3], Round((210 - A_Index * 50) * (1 - b))))
        Loop 16 {
            a := A_Index * 0.3927 + 0.2
            r0 := 46 + 40 * e, r1 := r0 + 70 * (1 - b)
            NLLineW(cx + Cos(a) * r0, cy + Sin(a) * r0, cx + Cos(a) * r1, cy + Sin(a) * r1, NLC(255, 255, 255, Round(170 * (1 - b))), 2)
        }
        Loop 14 {
            a := A_Index * 0.4488 + LACur
            r := 50 + 170 * e * (0.6 + 0.4 * Mod(A_Index * 7, 5) / 5)
            NLDisc(cx + Cos(a) * r, cy + Sin(a) * r, 3.2 * (1 - b) + 0.5, NLC(c2[1], c2[2], c2[3], Round(230 * (1 - b))))
        }
    }
    ; soft glow behind the emblem (breathes)
    gl := 0.75 + 0.25 * Sin(t * 4)
    Loop 5
        NLDisc(cx, cy, (70 - A_Index * 10) * s, NLC(c1[1], c1[2], c1[3], Round(16 * gl)))
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", LAG, "Float", cx, "Float", cy, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", LAG, "Float", s, "Float", s, "Int", 0)
    ; wings: more and longer feathers the higher the streak
    nf := 1 + wt
    for side in [-1, 1] {
        Loop nf {
            k := A_Index
            ang := (-38 + (k - 1) * (70 / Max(1, nf - 1 + 0.001))) * 0.01745
            ang := (nf = 1) ? -0.2 : ang
            len := 54 + k * 9 + wt * 4
            flap := 0.06 * Sin(t * 5 + k)
            bx := side * 30, by := -4 + k * 3
            tx := bx + side * Cos(ang + flap) * len, ty := by + Sin(ang + flap) * len * 0.8
            mx := bx + side * Cos(ang + flap + 0.22) * len * 0.55, my := by + Sin(ang + flap + 0.22) * len * 0.55 + 8
            px := bx + side * Cos(ang + flap - 0.18) * len * 0.5, py := by + Sin(ang + flap - 0.18) * len * 0.5 - 4
            col := SPStopsSample(stops, t * 0.25 + k * 0.07)
            pts := [bx, by - 6, px, py, tx, ty, mx, my, bx, by + 8]
            HWPoly(pts, NLC(col[1], col[2], col[3], 210))
            LAOutline(pts, NLC(255, 255, 255, 120), 1.2)
        }
    }
    KAEmblem(false, c1, c2)                                   ; (a different logo every time, for kills and for lagswitches)
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", LAG)
    ; the title
    names := (LAMode = "kill") ? KANames : ["LAG", "DOUBLE LAG", "TRIPLE LAG", "QUAD LAG", "PENTA LAG", "HEXA LAG", "LAG FRENZY", "LAG RAMPAGE", "UNSTOPPABLE", "LAG GOD"]
    title := names[tier]
    ta := Min(1.0, Max(0, (el - 120) / 220))
    NLAlphaPage := fade * ta
    ty := cy + 70 + (1 - ta) * 10
    for o in [[-2, 0], [2, 0], [0, -2], [0, 2]]
        NLText(title, o[1], ty + o[2], NLC(c1[1], c1[2], c1[3], 90), LAFont, LAW, 40, 1, 1)
    NLText(title, 2, ty + 3, NLC(0, 0, 0, 150), LAFont, LAW, 40, 1, 1)
    NLText(title, 0, ty, NLC(255, 255, 255), LAFont, LAW, 40, 1, 1)
    ; the streak stars (each one pops in after the other)
    NLAlphaPage := fade
    sy := cy + 128
    Loop 5 {
        k := A_Index, sx := cx + (k - 3) * 34
        if (tier < k) {
            LAOutline(LAStarPts(sx, sy, 11), NLC(255, 255, 255, 70), 1.4)
            continue
        }
        up := (tier >= k + 5), nk := up ? k + 5 : k
        pu := (nk = tier) ? Min(1.0, Max(0, (el - 220) / 260)) : 1.0
        ps := 1 + 2.4 * (pu - 1) ** 3 + 1.4 * (pu - 1) ** 2
        col := up ? [255, 204, 70] : SPStopsSample(stops, t * 0.25 + k * 0.1)
        NLDisc(sx, sy, 16 * ps, NLC(col[1], col[2], col[3], 40))
        HWPoly(LAStarPts(sx, sy, 12 * ps), NLC(col[1], col[2], col[3]))
        LAOutline(LAStarPts(sx, sy, 12 * ps), NLC(255, 255, 255, 170), 1.2)
    }
    NLG := prevG, NLAlphaPage := prevA
    sz := Buffer(8, 0), NumPut("Int", LAW, sz, 0), NumPut("Int", LAH, sz, 4)
