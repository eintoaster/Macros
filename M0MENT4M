}

LARenderNeon()
{
    global LAG, LADC, LAGui, LAW, LAH, LAAt, LACur, LAMode, KANames, LAFont, LAFontS, NLG, NLAlphaPage, SPLogoIdx
    if (!IsObject(LAGui))
        return
    if (!LAFont)
        LAFont := NLMakeFont("Segoe UI Black", 26, 0), LAFontS := NLMakeFont("Segoe UI", 11, 1)
    el := A_TickCount - LAAt, t := A_TickCount / 1000
    tier := Min(LACur, 10), wt := Min(tier, 6)
    gold := (tier >= 10)
    fade := (el < 1950) ? 1.0 : Max(0.0, 1 - (el - 1950) / 420)
    u := Min(1.0, el / 380)
    s := (1 + 2.6 * (u - 1) ** 3 + 1.6 * (u - 1) ** 2) * (1 - 0.12 * (1 - fade)) * (0.84 + 0.035 * tier)
    stops := SPLogoStops(SPLogoIdx)
    c1 := SPStopsSample(stops, t * 0.25), c2 := SPStopsSample(stops, t * 0.25 + 0.45)
    if (gold)                                                 ; (LAG GOD: everything turns gold)
        c1 := [255, 200, 70], c2 := [255, 236, 150]
    prevG := NLG, prevA := NLAlphaPage
    NLG := LAG, NLAlphaPage := fade
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", LAG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", LAG, "UInt", 0)
    cx := LAW / 2, cy := 116
    ; soft light behind everything
    Loop 7
        NLDisc(cx, cy, (150 - A_Index * 18) * s, NLC(c1[1], c1[2], c1[3], Round(7 + tier * 0.8)))
    ; a slowly turning sunburst, brighter with the streak
    ra := Min(1.0, el / 300) * (0.35 + 0.065 * tier)
    Loop 18 {
        a := A_Index * 0.349 + t * 0.35
        r0 := 40 * s, r1 := (120 + 6 * tier) * s
        NLLineW(cx + Cos(a) * r0, cy + Sin(a) * r0, cx + Cos(a) * r1, cy + Sin(a) * r1, NLC(c2[1], c2[2], c2[3], Round(46 * ra)), 6)
        NLLineW(cx + Cos(a) * r0, cy + Sin(a) * r0, cx + Cos(a) * r1 * 0.85, cy + Sin(a) * r1 * 0.85, NLC(255, 255, 255, Round(26 * ra)), 1.5)
    }
    ; shockwave: two rings, rays and sparks when it pops in
    if (el < 700) {
        b := el / 700, e := 1 - (1 - b) ** 3
        for ring in [[1.0, 0], [0.7, 120]] {
            bb := Max(0, Min(1.0, (el - ring[2]) / 580)), ee := 1 - (1 - bb) ** 3
            rr := 30 + 170 * ee * ring[1]
            Loop 4
                NLRRLine(cx - rr - A_Index, cy - rr - A_Index, 2 * (rr + A_Index), 2 * (rr + A_Index), rr + A_Index, NLC(c1[1], c1[2], c1[3], Round((190 - A_Index * 40) * (1 - bb))))
        }
        Loop 16 {
            a := A_Index * 0.3927 + 0.2
            r0 := 50 + 40 * e, r1 := r0 + 80 * (1 - b)
            NLLineW(cx + Cos(a) * r0, cy + Sin(a) * r0, cx + Cos(a) * r1, cy + Sin(a) * r1, NLC(255, 255, 255, Round(190 * (1 - b))), 2.2)
        }
        Loop 18 {
            a := A_Index * 0.349 + LACur
            r := 50 + 190 * e * (0.55 + 0.45 * Mod(A_Index * 7, 5) / 5)
            NLDisc(cx + Cos(a) * r, cy + Sin(a) * r, 5 * (1 - b) + 1.5, NLC(c2[1], c2[2], c2[3], Round(80 * (1 - b))))
            NLDisc(cx + Cos(a) * r, cy + Sin(a) * r, 2.6 * (1 - b) + 0.6, NLC(255, 255, 255, Round(240 * (1 - b))))
        }
    }
    ; from 6 on: sparks orbit around the emblem
    if (tier >= 6) {
        Loop (tier - 3) * 2 {
            a := t * (1.6 + 0.1 * A_Index) + A_Index * 6.2832 / ((tier - 3) * 2)
            ox := cx + Cos(a) * 92 * s, oy := cy + Sin(a) * 34 * s + 6
            NLDisc(ox, oy, 6, NLC(c2[1], c2[2], c2[3], 60))
            NLDisc(ox, oy, 2.4, NLC(255, 255, 255, 230))
        }
    }
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", LAG, "Float", cx, "Float", cy, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", LAG, "Float", s, "Float", s, "Int", 0)
    ; wings: more and longer feathers the higher the streak, each with a glowing edge
    nf := 1 + wt
    for side in [-1, 1] {
        Loop nf {
            k := A_Index
            ang := (nf = 1) ? -0.2 : (-40 + (k - 1) * (74 / (nf - 1))) * 0.01745
            len := 52 + k * 8 + wt * 4
            flap := 0.07 * Sin(t * 5 + k)
            bx := side * 30, by := -4 + k * 3
            tx := bx + side * Cos(ang + flap) * len, ty := by + Sin(ang + flap) * len * 0.8
            mx := bx + side * Cos(ang + flap + 0.22) * len * 0.55, my := by + Sin(ang + flap + 0.22) * len * 0.55 + 8
            px := bx + side * Cos(ang + flap - 0.18) * len * 0.5, py := by + Sin(ang + flap - 0.18) * len * 0.5 - 4
            col := gold ? [255, 190 + k * 6, 60 + k * 10] : SPStopsSample(stops, t * 0.25 + k * 0.07)
            pts := [bx, by - 6, px, py, tx, ty, mx, my, bx, by + 8]
            LAOutline(pts, NLC(col[1], col[2], col[3], 50), 7)          ; (the glow around the feather)
            HWPoly(pts, NLC(col[1], col[2], col[3], 200))
            HWPoly([bx, by - 3, px, py + 2, tx, ty], NLC(255, 255, 255, 50))   ; (a light upper half)
            LAOutline(pts, NLC(255, 255, 255, 150), 1.2)
        }
    }
    KAEmblem(true, c1, c2)                                    ; (a different logo every time, for kills and for lagswitches)
    ; from 7 on: a crown on top
    if (tier >= 7) {
        ca := Min(1.0, Max(0, (el - 160) / 260))
        cyy := -62 - (1 - ca) * 12
        crown := [-18, cyy + 12, -18, cyy - 2, -9, cyy + 5, 0, cyy - 8, 9, cyy + 5, 18, cyy - 2, 18, cyy + 12]
        NLAlphaPage := fade * ca
        LAOutline(crown, NLC(255, 200, 70, 70), 7)
        HWPoly(crown, NLC(255, 206, 80))
        LAOutline(crown, NLC(255, 246, 200), 1.2)
        NLDisc(0, cyy - 10, 2.6, NLC(255, 255, 255))
        NLAlphaPage := fade
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", LAG)
    ; the title, with a glow in the gradient colours and a light bar under it
    names := (LAMode = "kill") ? KANames : ["LAG", "DOUBLE LAG", "TRIPLE LAG", "QUAD LAG", "PENTA LAG", "HEXA LAG", "LAG FRENZY", "LAG RAMPAGE", "UNSTOPPABLE", "LAG GOD"]
    title := names[tier]
    ta := Min(1.0, Max(0, (el - 120) / 220))
    NLAlphaPage := fade * ta
    ty := cy + 72 + (1 - ta) * 10
    for o in [[-3, 0], [3, 0], [0, -3], [0, 3], [-2, -2], [2, 2], [-2, 2], [2, -2]]
        NLText(title, o[1], ty + o[2], NLC(c1[1], c1[2], c1[3], 55), LAFont, LAW, 40, 1, 1)
    NLText(title, 2, ty + 3, NLC(0, 0, 0, 160), LAFont, LAW, 40, 1, 1)
    NLText(title, 0, ty, gold ? NLC(255, 236, 170) : NLC(255, 255, 255), LAFont, LAW, 40, 1, 1)
    bw := (NLTextW(title, LAFont) + 40) * Min(1.0, Max(0, (el - 160) / 300))
    NLRR(cx - bw / 2, ty + 40, bw, 3, 1.5, NLC(c2[1], c2[2], c2[3], 220))
    NLRR(cx - bw / 2 - 6, ty + 38, bw + 12, 7, 3.5, NLC(c1[1], c1[2], c1[3], 50))
    NLText("STREAK " tier "/10", 0, ty + 44, NLC(255, 255, 255, 170), LAFontS, LAW, 20, 1, 1)
    ; the stars: they fill for 1..5, then turn gold one by one for 6..10
    NLAlphaPage := fade
    sy := cy + 160
    Loop 5 {
        k := A_Index, sx := cx + (k - 3) * 32
        lit := (tier >= k), up := (tier >= k + 5)
        if (!lit) {
            LAOutline(LAStarPts(sx, sy, 10), NLC(255, 255, 255, 70), 1.4)
            continue
        }
        nk := up ? k + 5 : k                                     ; (the star that just changed pops)
        pu := (nk = tier) ? Min(1.0, Max(0, (el - 220) / 260)) : 1.0
        ps := 1 + 2.4 * (pu - 1) ** 3 + 1.4 * (pu - 1) ** 2
        col := up ? [255, 204, 70] : SPStopsSample(stops, t * 0.25 + k * 0.1)
        NLDisc(sx, sy, 17 * ps, NLC(col[1], col[2], col[3], 36))
        NLDisc(sx, sy, 11 * ps, NLC(col[1], col[2], col[3], 50))
        HWPoly(LAStarPts(sx, sy, 11 * ps), NLC(col[1], col[2], col[3]))
        LAOutline(LAStarPts(sx, sy, 11 * ps), NLC(255, 255, 255, up ? 230 : 170), 1.2)
    }
    NLG := prevG, NLAlphaPage := prevA
    sz := Buffer(8, 0), NumPut("Int", LAW, sz, 0), NumPut("Int", LAH, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", LAGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", LADC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; ===== Misc > Fun: the kill screen effects (their own full-screen click-through window, about half a second each).
; Styles: hit marker, blood splatter, slash, shatter, anime speed lines, shockwave, neon frame - or a random one every hit.
; An edge vignette can pulse with every hit. Colour, intensity and length are set on the Fun tab. =====
FunCols()
{
    global FunColIdx, FunColor, SPLogoIdx, AccentColor
    t := A_TickCount / 1000
    switch FunColIdx {
        case 2:
            st := SPLogoStops(SPLogoIdx)
            return [SPStopsSample(st, t * 0.3), SPStopsSample(st, t * 0.3 + 0.45)]
        case 3:
            a := SPHexArr(AccentColor)
            return [a, SPShadeArr(a, 0.35)]
        case 4:
            return [[255, 255, 255], [190, 215, 255]]
        case 5:
            a := SPHexArr(FunColor)
            return [a, SPShadeArr(a, 0.35)]
        default:
            return [[255, 36, 56], [255, 128, 96]]
    }
}

