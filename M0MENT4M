    HWPoly(fr, NLC(16, 16, 26, 240))
    HWPoly(KAFramePts(ff, 0.8), NLC(c1[1], c1[2], c1[3], neon ? 70 : 40))
    LAOutline(fr, neon ? NLC(c2[1], c2[2], c2[3]) : NLC(c1[1], c1[2], c1[3]), 3)
    LAOutline(KAFramePts(ff, 0.84), NLC(255, 255, 255, neon ? 90 : 60), 1.2)
    if (neon) {
        NLDisc(0, 0, 30, NLC(c2[1], c2[2], c2[3], 36))
        NLDisc(0, 0, 20, NLC(c2[1], c2[2], c2[3], 44))
