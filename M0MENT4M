FillCurve(arr, argb) {
    pts := Buffer(8 * arr.Length, 0)
    for i, q in arr {
        NumPut('Float', q[1], pts, (i - 1) * 8)
        NumPut('Float', q[2], pts, (i - 1) * 8 + 4)
