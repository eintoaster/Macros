; the emblem of the banner: the kill one (Misc > Fun) or the lagswitch one, each with its own random frame and icon
KAEmblem(neon, c1, c2)
{
    global LAKillFrame, LAKillIcon, LALagFrame, LALagIcon, LAMode
    kill := (LAMode = "kill")
    ff := kill ? LAKillFrame : LALagFrame
    fr := KAFramePts(ff)
    if (neon) {
