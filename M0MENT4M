; BACKWARDS BHOP: holds W for a moment to build speed, then in one moment turns the camera around, lets go of W and starts
; bhopping. It keeps bhopping until the key is pressed again; the camera is not turned back.
ToggleBBhop(*)
{
    global isBBhopRunning, BBhopPhase, BBhopRunMs, isBhopRunning, BhopHeld
    if (!IsBBhopChecked || BBhopKey == "")
        return
    if (isBBhopRunning) {
        BBhopStop()
        ShowStatus("BACKWARDS BHOP: OFF", "0x2A0808", 160)
        return
    }
    if (isBhopRunning) {                                      ; (the normal bhop is taken over)
        isBhopRunning := false, BhopHeld := false
        SetTimer(UltraSpam, 0)
    }
    isBBhopRunning := true, BBhopPhase := 1
    Send("{Blind}{w down}")
    BBhopOwnW(true)                                           ; (from now on the macro decides about W, even while you hold it yourself)
    SetTimer(BBhopKeepW, 60)                                  ; (and keeps pressing it like a held key repeats)
    SetTimer(BBhopGo, -Max(50, BBhopRunMs))
    ShowStatus("BACKWARDS BHOP: ON", "0x082A13", 160)
    UpdateSidebarIndicators()
    BlinkIndicator(2)
}

; the moment it turns: camera around, W up and the first jump together
BBhopGo()
{
    global isBBhopRunning, BBhopPhase, BBhopTurn
    if (!isBBhopRunning || BBhopPhase != 1)
        return
    if (!GameActiveFast()) {
        BBhopStop()
        return
    }
    SetTimer(BBhopKeepW, 0)
    TurnCamera(BBhopTurn)
    Send("{Blind}{w up}")
    BBhopPhase := 2
    UltraSpam()
    SetTimer(UltraSpam, 15)
}

BBhopStop()
{
    global isBBhopRunning, BBhopPhase, isBhopRunning
    SetTimer(BBhopGo, 0)
    SetTimer(BBhopKeepW, 0)
    if (BBhopPhase = 1)
        Send("{Blind}{w up}")
    if (BBhopPhase = 2 && !isBhopRunning) {
        SetTimer(UltraSpam, 0)
        DllCall("keybd_event", "UChar", 0x20, "UChar", 0x39, "UInt", 2, "UPtr", 0) ; Space UP
    }
    isBBhopRunning := false, BBhopPhase := 0
    BBhopOwnW(false)
    UpdateSidebarIndicators()
}

; While Backwards Bhop runs, your own W presses are swallowed: the macro holds W for the run-up even if you let go, and after
; the turn W stays released even if you keep holding it (otherwise the key repeat of your W would press it again).
; When it stops your W works again, and if you are still holding it, it is pressed again at once.
BBhopOwnW(on)
{
    static active := false
    if (on = active)
        return
    active := on
    try Hotkey("*w", BBhopEatW, on ? "On" : "Off")
    try Hotkey("*w up", BBhopWUp, on ? "On" : "Off")
    if (!on && GetKeyState("w", "P"))
        Send("{Blind}{w down}")
}

