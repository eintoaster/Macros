    ok := DllCall("SendMessageTimeoutW", "Ptr", HkHelperHwnd, "UInt", 0x4A, "Ptr", A_ScriptHwnd, "Ptr", cds, "UInt", 2, "UInt", 250, "Ptr*", &res)
    if (!ok || res != 1) {
