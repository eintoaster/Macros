; ===== M0MENT4M design: slide-in notification cards (bottom left) =====
; the look of the cards (Misc > Overlay > Notification style); saved in the configs with the widget looks
Global NotifStyle := {id: "notif", bg: true, border: true, scale: 100, bstyle: 0, grad: 0}
Global TW := 560, TH := 460, TMemDC := 0, TBmp := 0, TG := 0, TGui := "", TList := [], TTimerOn := false

SPToast(text, key := 0, kindOver := "", subOver := "")
{
    global TList, TTimerOn, TH, ShowStatusNotifs
    if (!ShowStatusNotifs)          ; the "Status popups" switch turns every card off
        return
    NLGdipInit()
    t := StrReplace(StrReplace(text, "`r"), "`n", " ")
    title := t, sub := "", kind := "info"
    if (kindOver != "") {
        title := t, sub := subOver, kind := kindOver
    } else if (RegExMatch(t, "^(.*) ALREADY USED: (.*)$", &mm)) {
        title := "Key already used", sub := mm[1] " is bound to " mm[2], kind := "off"
    } else if (RegExMatch(t, "^(.*?):\s*(.+)$", &m)) {
        title := m[1]
        rest := Trim(m[2])
        if (StrUpper(rest) = "ON")
            sub := "Enabled", kind := "on"
        else if (StrUpper(rest) = "OFF")
            sub := "Disabled", kind := "off"
        else if (StrUpper(rest) = "LOCKED")
            title := "Macros locked", sub := "", kind := "off"
        else if (StrUpper(rest) = "RESTORED")
            title := "Macros on", sub := "", kind := "on"
        else
            sub := rest
    }
    if (kindOver = "" && !InStr(t, "ALREADY USED"))
        title := StrTitle(StrLower(Trim(title)))
    if (key) {
        for it in TList {
            if (it.key = key) {
                it.title := title, it.sub := sub, it.kind := kind
                it.t0 := Min(it.t0, A_TickCount - 500) + 0
                it.t0 := A_TickCount - 500
                SPToastStart()
                return
            }
        }
    }
    TList.InsertAt(1, {key: key, title: title, sub: sub, kind: kind, t0: A_TickCount, dur: 2400, y: TH - 72})
    while (TList.Length > 4)
        TList.Pop()
    SPToastStart()
}

SPToastStart()
{
    global TGui, TW, TH, TTimerOn, TMemDC, TBmp, TG
    if (!IsObject(TGui)) {
        TGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "M0MENT4M toasts")
        TMemDC := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
        bi := Buffer(40, 0)
        NumPut("int", 40, bi, 0)
        NumPut("int", TW, bi, 4)
        NumPut("int", -TH, bi, 8)
        NumPut("short", 1, bi, 12)
        NumPut("short", 32, bi, 14)
        pBits := 0
        TBmp := DllCall("CreateDIBSection", "Ptr", TMemDC, "Ptr", bi, "UInt", 0, "Ptr*", &pBits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("SelectObject", "Ptr", TMemDC, "Ptr", TBmp)
        DllCall("gdiplus\GdipCreateFromHDC", "Ptr", TMemDC, "Ptr*", &TG)
        DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", TG, "Int", 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", TG, "Int", 4)
        TGui.Show("x0 y" (A_ScreenHeight - TH - 40) " w" TW " h" TH " NA")
    } else
        TGui.Show("NA")
    if (!TTimerOn) {
        TTimerOn := true
        SetTimer(SPToastTick, 16)
    }
    SPToastRender()
}

SPToastTick()
{
    global TList, TGui, TTimerOn
    Critical
    now := A_TickCount
    i := TList.Length
    while (i >= 1) {
        it := TList[i]
        if (now - it.t0 > it.dur + 420)
            TList.RemoveAt(i)
        i--
    }
    if (TList.Length = 0) {
        SetTimer(SPToastTick, 0)
        TTimerOn := false
        TGui.Hide()
        return
    }
    SPToastRender()
}

; Critical keeps another timer from touching the shared drawing handle halfway through, but it must not
; leak into the thread that called us (it would stop timers from running while that thread sleeps).
SPToastRender()
{
    pc := A_IsCritical
    Critical
    try SPToastRenderInner()
    finally Critical(pc ? "On" : "Off")
}

SPToastRenderInner()
{
    global TList, TG, TW, TH, TMemDC, TGui, NLG, NLAlphaPage, NLFontB, NLFontSm, NLFontIcon, SPSkin, NLStyle
    global NotifLook
    mcc := (NotifLook = 3)                                   ; (Mercury pills)
    rdc := !mcc && (NotifLook = 2 || (SPSkin = "rd" && NLStyle = "sp"))   ; (Radiance chips: picked, or automatic in the Radiance design)
    prevG := NLG, prevA := NLAlphaPage
    NLG := TG
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", TG, "UInt", 0)
    now := A_TickCount
    cw := 316, chh := 58
    ns := NotifStyle
    sc := ns.scale / 100
    gi := ns.grad ? ns.grad : 1
    gst := SPLogoStops(gi)
    nbs := ns.bstyle ? ns.bstyle : 1
    for i, it in TList {
        target := (rdc || mcc) ? TH - 16 - 28 * sc - (i - 1) * 34 * sc : TH - 16 - chh * sc - (i - 1) * 68 * sc
        it.y += (target - it.y) * 0.3
        el := now - it.t0
        tin := Max(0.0, Min(1.0, el / 480))
        e := 1 + 2.70158 * (tin - 1) ** 3 + 1.70158 * (tin - 1) ** 2
        tout := (el > it.dur) ? Min(1.0, (el - it.dur) / 400) : 0.0
        tout := tout * tout
        slide := (cw + 30) * sc
        x := 24 - (1 - e) * slide - tout * slide
        y := it.y
        NLAlphaPage := Min(1.0, tin * 2.5) * (1 - tout)
        DllCall("gdiplus\GdipResetWorldTransform", "Ptr", TG)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", TG, "Float", x, "Float", y, "Int", 0)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", TG, "Float", sc, "Float", sc, "Int", 0)
        x := 0, y := 0
        if (mcc) {
            MCToastPill(it, i)
            continue
        }
        if (rdc) {
            RDToastChip(it)
            continue
        }
        if (ns.bg) {
            NLRR(x - 1, y + 3, cw + 2, chh, 15, NLC(0, 0, 0, 50))
            NLRR(x, y, cw, chh, 14, SPCol("Card"))
        }
        if (ns.border) {
            if (nbs <= 2) {
                NLRRLine(x, y, cw, chh, 14, nbs = 2 ? NLAccent(210) : SPCol("Border"))
            } else {
                if (ns.bg)
                    NLRRLine(x, y, cw, chh, 14, SPCol("Border", 120))
                SPGradBorder(x + 1, y + 1, cw - 2, chh - 2, 13, SPLogoStops(nbs = 4 ? 6 : gi), A_TickCount / 1000 * 0.3, 2)
            }
        }
        ; with a gradient chosen the icon, the title and the time bar take its (moving) colours
        tc := ns.grad ? SPStopsSample(gst, A_TickCount / 1000 * 0.12 + i * 0.1) : 0
        ; icon bubble
        if (it.kind = "off") {
            col := NLC(240, 96, 96), colSoft := NLC(240, 96, 96, 40)
        } else if (tc) {
            col := NLC(tc[1], tc[2], tc[3]), colSoft := NLC(tc[1], tc[2], tc[3], 40)
        } else {
            col := NLAccent(), colSoft := NLAccent(40)
        }
        NLDisc(x + 30, y + 29, 15, colSoft)
        if (it.kind = "on") {
            NLLineW(x + 23, y + 29.5, x + 28, y + 34.5, col, 2.4)
            NLLineW(x + 28, y + 34.5, x + 37.5, y + 23.5, col, 2.4)
        } else if (it.kind = "key") {
            NLRRLine(x + 21, y + 22, 18, 14, 4, col)
            NLLineW(x + 25, y + 31, x + 35, y + 31, col, 2)
        } else if (it.kind = "off") {
            NLLineW(x + 24.5, y + 23.5, x + 35.5, y + 34.5, col, 2.4)
            NLLineW(x + 35.5, y + 23.5, x + 24.5, y + 34.5, col, 2.4)
        } else {
            NLDisc(x + 30, y + 22.5, 1.8, col)
            NLLineW(x + 30, y + 27, x + 30, y + 36, col, 2.4)
        }
        tcol := tc ? NLC(tc[1], tc[2], tc[3]) : SPCol("Text")
        if (it.sub = "") {
            NLText(it.title, x + 58, y + 4, tcol, NLFontB, cw - 72, chh - 8, 0, 1)
        } else {
            NLText(it.title, x + 58, y + 9, tcol, NLFontB, cw - 72, 20, 0, 1)
            NLText(it.sub, x + 58, y + 29, SPCol("Text2"), NLFontSm, cw - 72, 18, 0, 1)
        }
        ; time bar
        rem := Max(0.0, 1 - el / it.dur)
        NLRR(x + 16, y + chh - 6, (cw - 32) * rem, 2.5, 1.25, tc ? NLC(tc[1], tc[2], tc[3], 150) : ((it.kind = "off") ? NLC(240, 96, 96, 150) : NLAccent(150)))
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", TG)
    NLG := prevG
    NLAlphaPage := prevA
    sz := Buffer(8, 0)
    NumPut("Int", TW, sz, 0)
    NumPut("Int", TH, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0)
    NumPut("UChar", 255, bf, 2)
    NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", TGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", TMemDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; ===== Radiance HUDs: small dark navy chips with a violet icon (the macro HUD style "Radiance", the watermark bar and the
; notifications while the Radiance design is on) =====

RDFonts()
{
    global RDFont, RDIcon
    if (!RDFont) {
        NLGdipInit()
        RDFont := NLMakeFont("Segoe UI", 12, 1)
        RDIcon := NLMakeFont("Segoe UI Symbol", 12, 0)
    }
}

RDChipBg(x, y, w, h)
{
    NLRR(x, y + 2, w, h, 7, NLC(0, 0, 0, 60))
    NLRR(x, y, w, h, 7, NLC(24, 26, 56, 228))
    NLRRLine(x, y, w, h, 7, NLC(80, 86, 152, 170))
}

; one chip: an icon and a few pieces of text, each with its own colour ([text, argb], ...); returns its width
RDChipW(icon, parts)
{
    global RDFont
    RDFonts()
    w := 18 + (icon != "" ? 18 : 0)
    for p in parts
        w += NLTextW(p[1], RDFont) + (A_Index > 1 ? 4 : 0)
    return Round(w)
}

RDChip(x, y, icon, parts, h := 24, iconCol := 0)
{
    global RDFont, RDIcon
    w := RDChipW(icon, parts)
    RDChipBg(x, y, w, h)
    cx := x + 9
    if (icon != "") {
        NLText(icon, cx - 2, y, iconCol ? iconCol : NLC(150, 138, 255), RDIcon, 20, h, 1, 1)
        cx += 18
    }
    for p in parts {
        tw := NLTextW(p[1], RDFont)
        NLText(p[1], cx, y, p[2], RDFont, tw + 8, h, 0, 1)
        cx += tw + 4
    }
    return w
}

RDWhite(a := 255) => NLC(236, 236, 255, a)
RDViolet(a := 255) => NLC(158, 146, 255, a)
RDRed(a := 255) => NLC(244, 112, 124, a)

; the macro HUD in the Radiance style: a header chip, then one chip per macro. Switching a macro on makes its chip pop
; (a short bounce, a violet ring that spreads out, the colours fade up and a small accent bar grows); switching it off
; fades it back. In the compact list chips slide in from the left and out again, the others glide to their new places.

; the HUD border setting (Misc > Overlay > HUD border) on the Radiance chips and the Mercury box; "Off" keeps their own look.
; Returns true when the border moves (the HUD then keeps redrawing).
HudStyleBorder(x, y, w, h, r)
{
    global HudBorderIdx, HudGradIdx, HudMoving
    bs := HudMoving ? 4 : HudBorderIdx
    if (bs <= 1)
        return false
    if (bs = 2) {
        NLRRLine(x, y, w, h, r, NLAccent(220))
        return false
    }
    SPGradBorder(x, y, w, h, r, SPLogoStops(bs = 4 ? 6 : HudGradIdx), A_TickCount / 1000 * 0.3, 1.8)
    return true
}

RDMix(c1, c2, t, a := 255) => NLC(Round(c1[1] + (c2[1] - c1[1]) * t), Round(c1[2] + (c2[2] - c1[2]) * t), Round(c1[3] + (c2[3] - c1[3]) * t), a)

RDEase(key, target, sp, &busy)
{
    global HudAnim
    v := HudAnim.Has(key) ? HudAnim[key] : target
    v += (target - v) * sp
    if (Abs(target - v) < 0.01)
        v := target
    else
        busy := true
    HudAnim[key] := v
    return v
}

HudRenderRD(states, labels)
{
    global HudG, HudMemDC, HudGui, HudH, HUDW, HUDMAXH, HudOpacity, HudBusy, HudPosition, HudCustom, HudMoving, NLG, NLAlphaPage, HudShowKeys, HudCompact, RDIcons, RDPrev, RDFlash, HudGradIdx
    now := A_TickCount, busy := false
    rows := [], y := 30, anyOn := false
    Loop states.Length {
        i := A_Index, st := states[i] ? 1 : 0
        if (st)
            anyOn := true
        if (RDPrev.Has(i) && RDPrev[i] != st)
            RDFlash[i] := now
        RDPrev[i] := st
        t := RDEase("rt" i, st, 0.22, &busy)
        e := RDEase("rv" i, HudCompact ? st : 1, 0.2, &busy)
        if (e > 0.01) {
            rows.Push({i: i, t: t, e: e, y: y})
            y += 26 * e
        }
    }
    ia := RDEase("ridle", (HudCompact && !anyOn) ? 1 : 0, 0.2, &busy)
    H := Min(HUDMAXH, Max(34, Round(y + 26 * ia + 4)))
    if (H != HudH) {
        HudH := H
        if (InStr(HudPosition, "Bottom") && !HudCustom && !HudMoving)
            HudGui.Move(, A_ScreenHeight - 8 - H, HUDW, H)
        else
            HudGui.Move(, , HUDW, H)
    }
    prevG := NLG, prevA := NLAlphaPage
    NLG := HudG
    hap := HAnimAp("hud")
    base := Max(0.2, HudOpacity / 255) * hap
    NLAlphaPage := base
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", HudG, "UInt", 0)
    if (hap < 1)
        HAnimXf(HudG, HUDW / 2, H / 2, 1.0, hap)
    ; header: a soft light runs over it while something just changed
    hw := RDChip(4, 4, Chr(0x2726), [["M0MENT4M", RDViolet()]], 22)
    if (HudStyleBorder(4, 4, hw, 22, 7))
        busy := true
    last := 0
    for i, at in RDFlash
        last := Max(last, at)
    if (now - last < 700) {
        u := (now - last) / 700
        sx := 4 + (hw + 30) * u - 20
        NLRR(Max(4, sx), 5, Min(20, 4 + hw - Max(4, sx)), 20, 6, NLC(255, 255, 255, Round(40 * Sin(u * 3.14159))))
        busy := true
    }
    muted := [150, 154, 200], white := [236, 236, 255], violet := [158, 146, 255], red := [244, 112, 124], dim := [120, 124, 170]
    for r in rows {
        i := r.i, on := states[i] ? true : false
        fl := RDFlash.Has(i) ? now - RDFlash[i] : 99999
        if (fl < 620)
            busy := true
        x := 4 - (1 - r.e) * 46, cy := r.y
        NLAlphaPage := base * r.e
        pop := (on && fl < 420) ? 1 + 0.12 * Sin(fl / 420 * 3.14159) * (1 - fl / 420) : 1
        if (pop != 1) {
            DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", HudG, "Float", x, "Float", cy + 11, "Int", 0)
            DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", HudG, "Float", pop, "Float", pop, "Int", 0)
            DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", HudG, "Float", -x, "Float", -(cy + 11), "Int", 0)
        }
        tail := HudShowKeys ? HudKeyFor(i) : (on ? "on" : "off")
        acc := (i = states.Length) ? red : (HudGradIdx > 1) ? SPStopsSample(SPLogoStops(HudGradIdx), now / 1000 * 0.12 + i * 0.11) : violet
        w := RDChip(x, cy, RDIcons[i], [[labels[i], RDMix(muted, white, r.t)], [tail, RDMix(dim, acc, r.t)]], 22, RDMix(dim, violet, r.t))
        if (HudStyleBorder(x, cy, w, 22, 7))
            busy := true
        if (r.t > 0.02)                                           ; the accent bar on the left grows with it
            NLRR(x + 1.5, cy + 11 - 7 * r.t, 2.5, 14 * r.t, 1.25, RDMix(acc, acc, 1, Round(255 * r.t)))
        if (fl < 560) {                                           ; a ring spreads out from the chip (violet on, faint red off)
            u := fl / 560, g := 7 * (1 - (1 - u) ** 3)
            NLRRLine(x - g, cy - g, w + 2 * g, 22 + 2 * g, 7 + g, on ? RDMix(acc, acc, 1, Round(210 * (1 - u))) : NLC(244, 112, 124, Round(110 * (1 - u))))
        }
        if (pop != 1)
            DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    }
    if (ia > 0.01) {
        NLAlphaPage := base * ia
        RDChip(4 - (1 - ia) * 46, y, "", [["no macros running", NLC(150, 154, 200)]], 22)
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    NLG := prevG, NLAlphaPage := prevA
    HudBusy := (hap < 1) || busy
    sz := Buffer(8, 0), NumPut("Int", HUDW, sz, 0), NumPut("Int", H, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", HudGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", HudMemDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; a notification as one chip (like the hit logs): icon, title and the state word in colour
RDToastChip(it)
{
    icon := (it.kind = "on") ? Chr(0x2714) : (it.kind = "off") ? Chr(0x2716) : (it.kind = "key") ? Chr(0x2328) : Chr(0x2726)
    parts := [[it.title, RDWhite()]]
    if (it.sub != "")
        parts.Push([it.sub, (it.kind = "off") ? RDRed() : RDViolet()])
    RDChip(0, 0, icon, parts, 26)
}

; ----- the watermark bar: M0MENT4M | user | FPS | macros on | clock (Misc > Overlay); drag it while the menu is open -----

WMToggle(*)
{
    global WMOn
    WMOn := !WMOn
    if (WMOn)
        WMShow()
    else
        WMHide()
    SPSavePrefs()
}

; "Enable FPS" under the watermark: the bar shows your FPS (the counter needs administrator permission, so it is off until you switch it on)
WMToggleFps(*)
{
    global WMFps, WMVisible, WH
    WMFps := !WMFps
    if (WMFps) {
        if (!FpsInstalled() && !FpsInstall()) {
            WMFps := false
            try NLRequest()
            return
        }
        if (WMVisible && !FpsBegin())
            WMFps := false
    } else if (!WH["fps"].on)
        FpsEnd()
    try WMRender()
    try NLRequest()
}

WMShow()
{
    global WMGui, WMDC, WMBmp, WMG, WMVisible, WMSurfW, WMH
    if (!IsObject(WMGui)) {
        NLGdipInit()
        WMGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "M0MENT4M watermark")
        dc := 0, bmp := 0, g := 0
        VigMakeSurface(WMSurfW, WMH, &dc, &bmp, &g)
        WMDC := dc, WMBmp := bmp, WMG := g
    }
    WMVisible := true
    HAnimStart("wm")
    WMRender()
    WMGui.Show("NA")
    SetTimer(WMTick, 50)
    if (WMFps && FpsInstalled() && !FpsTimerOn)               ; ("Enable FPS": the bar shows the FPS without the FPS HUD)
        FpsBegin()
}

WMHide()
{
    global WMGui, WMVisible, WH
    WMVisible := false
    SetTimer(WMTick, 0)
    if (IsObject(WMGui))
        WMGui.Hide()
    if (!WH["fps"].on)                                        ; (the FPS HUD may still need the counter)
        try FpsEnd()
}

WMParts()
{
    global FpsNow, FpsTimerOn
    global isMacroRunning, isBhopRunning, isStrafeActive, isComboRunning, isCSpamRunning, isClickRunning, isSpinbotRunning, isBBhopRunning
    on := 0
    for v in [isMacroRunning, isBhopRunning, isStrafeActive, isComboRunning, isCSpamRunning, isClickRunning, isSpinbotRunning, isBBhopRunning]
        on += v ? 1 : 0
    chips := [[Chr(0x2726), [["M0MENT4M", RDViolet()]]], [Chr(0x263A), [[A_UserName, RDWhite()]]]]
    if (FpsTimerOn && FpsNow > 0)
        chips.Push([Chr(0x2197), [[Round(FpsNow), RDWhite()], ["Fps", NLC(170, 174, 220)]]])
    chips.Push([Chr(0x26A1), [[on, on ? RDViolet() : RDWhite()], [on = 1 ? "macro on" : "macros on", NLC(170, 174, 220)]]])
    chips.Push([Chr(0x25F7), [[FormatTime(, "HH:mm:ss"), RDWhite()]]])
    return chips
}

WMRender()
{
    pc := A_IsCritical
    Critical
    try WMRenderInner()
    finally Critical(pc ? "On" : "Off")
}

WMRenderInner()
{
    global WMGui, WMDC, WMG, WMW, WMH, WMX, WMY, WMCustom, WMMoving, NLG, NLAlphaPage, HudOpacity
    global WMLook
    prevG := NLG, prevA := NLAlphaPage
    NLG := WMG
    NLAlphaPage := Max(0.2, HudOpacity / 255) * HAnimAp("wm")
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", WMG, "UInt", 0)
    if (WMLook = 2)
        WMRenderMC(&w)
    else if (WMLook = 3)
        WMRenderSL(&w)
    else {
        chips := WMParts()
        w := 4
        for c in chips
            w += RDChipW(c[1], c[2]) + 5
        w := Min(w + 2, 1000)
        x := 3
        for c in chips
            x += RDChip(x, 4, c[1], c[2], 24) + 5
    }
    if (WMMoving)
        NLRRLine(1, 1, w - 2, WMH - 2, 8, RDViolet(200))
    NLG := prevG, NLAlphaPage := prevA
    if (!WMMoving) {
        if (WMCustom)
            px := WMX, py := WMY
        else
            px := (A_ScreenWidth - w) // 2, py := 12
    } else
        WMGui.GetPos(&px, &py)
    WMW := w
    pos := Buffer(8, 0), NumPut("Int", px, pos, 0), NumPut("Int", py, pos, 4)
    sz := Buffer(8, 0), NumPut("Int", w, sz, 0), NumPut("Int", WMH, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", WMGui.Hwnd, "Ptr", 0, "Ptr", pos, "Ptr", sz, "Ptr", WMDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

WMTick()
{
    global WMGui, WMVisible, WMMoving, WMClickThru, WMDragOff, WMX, WMY, WMCustom, WMW, WMH, isAppMinimized
    static wasDown := false, last := 0
    if (!WMVisible || !IsObject(WMGui))
        return
    menuOpen := !isAppMinimized
    if (menuOpen = WMClickThru) {                       ; (click-through while you play, draggable while the menu is open)
        WMClickThru := !menuOpen
        try WinSetExStyle(menuOpen ? "-0x20" : "+0x20", "ahk_id " WMGui.Hwnd)
    }
    if (menuOpen) {
        pt := Buffer(8, 0)
        DllCall("GetCursorPos", "Ptr", pt)
        mx := NumGet(pt, 0, "Int"), my := NumGet(pt, 4, "Int")
        down := (DllCall("GetAsyncKeyState", "Int", 0x01, "Short") & 0x8000) ? true : false
        if (WMMoving) {
            if (down)
                WMGui.Move(Max(0, Min(A_ScreenWidth - WMW, mx - WMDragOff.x)), Max(0, Min(A_ScreenHeight - WMH, my - WMDragOff.y)))
            else {
                WMMoving := false
                WMGui.GetPos(&gx, &gy)
                WMX := gx, WMY := gy, WMCustom := true
                SPSavePrefs()
            }
        } else if (down && !wasDown) {
            WMGui.GetPos(&gx, &gy, &gw, &gh)
            if (mx >= gx && mx < gx + gw && my >= gy && my < gy + gh)
                WMMoving := true, WMDragOff := {x: mx - gx, y: my - gy}
        }
        wasDown := down
    } else
        WMMoving := false, wasDown := false
    if (WMMoving || A_TickCount - last >= 250) {         ; (the clock and the numbers four times a second)
        last := A_TickCount
        WMRender()
    }
}

; ===== Mercury overlay look: dark see-through boxes with a soft lavender glow, light labels and light blue values.
; Picked per HUD: the macro HUD style, the lagswitch pill look, the notification look and the watermark look. =====
MCInitFonts()
{
    global MCFont, MCFontS
    if (!MCFont) {
        NLGdipInit()
        MCFont := NLMakeFont("Segoe UI", 12, 1)
        MCFontS := NLMakeFont("Segoe UI", 11, 0)
    }
    RDFonts()
}

MCTextC(a := 255) => NLC(226, 228, 245, a)
MCValC(a := 255) => NLC(130, 170, 255, a)
MCDimC(a := 255) => NLC(150, 154, 186, a)

MCBox(x, y, w, h, r := 9)
{
    Loop 4 {
        e := A_Index * 1.6
        NLRRLine(x - e, y - e, w + 2 * e, h + 2 * e, r + e, NLC(176, 182, 255, 50 - A_Index * 11))
    }
    NLRR(x, y, w, h, r, NLC(26, 28, 48, 205))
    NLRRLine(x, y, w, h, r, NLC(178, 184, 236, 175))
}

MCPillBg(x, y, w, h, rgb, bright := 1.0)
{
    Loop 3 {
        e := A_Index * 1.5
        NLRRLine(x - e, y - e, w + 2 * e, h + 2 * e, 7 + e, NLC(rgb[1], rgb[2], rgb[3], Round((62 - A_Index * 17) * bright)))
    }
    NLRR(x, y, w, h, 7, NLC(24, 24, 40, Round(160 + 60 * bright)))
    NLRRLine(x, y, w, h, 7, NLC(rgb[1], rgb[2], rgb[3], Round(140 + 90 * bright)))
}

; the macro HUD in the Mercury style: a "Macros" box, a name on the left and on/off (or the key) on the right per row.
; The box grows and shrinks smoothly; a row that switches on slides in, its value lights up and a light runs over it.
HudRenderMC(states, labels)
{
    global HudG, HudMemDC, HudGui, HudH, HUDW, HUDMAXH, HudOpacity, HudBusy, HudPosition, HudCustom, HudMoving, NLG, NLAlphaPage, HudShowKeys, HudCompact, RDPrev, RDFlash, MCFont, MCFontS, RDIcon, HudGradIdx
    MCInitFonts()
    now := A_TickCount, busy := false
    rows := [], y := 40, anyOn := false
    Loop states.Length {
        i := A_Index, st := states[i] ? 1 : 0
        if (st)
            anyOn := true
        if (RDPrev.Has(i) && RDPrev[i] != st)
            RDFlash[i] := now
        RDPrev[i] := st
        t := RDEase("mt" i, st, 0.22, &busy)
        e := RDEase("mv" i, HudCompact ? st : 1, 0.2, &busy)
        if (e > 0.01) {
            rows.Push({i: i, t: t, e: e, y: y})
            y += 21 * e
        }
    }
    ia := RDEase("midle", (HudCompact && !anyOn) ? 1 : 0, 0.2, &busy)
    y += 21 * ia
    bh := RDEase("mbox", y - 6 + 6, 0.25, &busy)
    H := Min(HUDMAXH, Max(52, Round(bh + 10)))
    if (H != HudH) {
        HudH := H
        if (InStr(HudPosition, "Bottom") && !HudCustom && !HudMoving)
            HudGui.Move(, A_ScreenHeight - 8 - H, HUDW, H)
        else
            HudGui.Move(, , HUDW, H)
    }
    prevG := NLG, prevA := NLAlphaPage
    NLG := HudG
    hap := HAnimAp("hud")
    base := Max(0.2, HudOpacity / 255) * hap
    NLAlphaPage := base
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", HudG, "UInt", 0)
    if (hap < 1)
        HAnimXf(HudG, HUDW / 2, H / 2, 1.0, hap)
    bw := HUDW - 14, bx := 7
    MCBox(bx, 7, bw, Min(H - 14, bh - 6), 9)
    if (HudStyleBorder(bx, 7, bw, Min(H - 14, bh - 6), 9))
        busy := true
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", HudG, "Int", bx, "Int", 7, "Int", bw, "Int", Max(1, Round(Min(H - 14, bh - 6))), "Int", 0)
    tw := NLTextW("Macros", MCFont)
    tx := bx + (bw - tw - 18) / 2
    NLText(Chr(0x2726), tx, 10, MCValC(), RDIcon, 16, 22, 1, 1)
    NLText("Macros", tx + 18, 10, MCTextC(), MCFont, tw + 8, 22, 0, 1)
    NLLine(bx + 8, 34, bx + bw - 8, 34, NLC(178, 184, 236, 150))
    for r in rows {
        i := r.i, on := states[i] ? true : false
        fl := RDFlash.Has(i) ? now - RDFlash[i] : 99999
        if (fl < 620)
            busy := true
        NLAlphaPage := base * r.e
        x := bx + 8 - (1 - r.e) * 30, ry := r.y
        if (on && fl < 600) {                                     ; a light runs over the row
            u := fl / 600
            NLRR(bx + 4 + (bw - 30) * u, ry, 26, 19, 5, NLC(176, 190, 255, Round(60 * Sin(u * 3.14159))))
        }
        NLText(labels[i], x, ry, RDMix([150, 154, 186], [226, 228, 245], r.t), MCFontS, bw - 70, 19, 0, 1)
        val := HudShowKeys ? HudKeyFor(i) : (on ? "on" : "off")
        vc := (HudGradIdx > 1) ? SPStopsSample(SPLogoStops(HudGradIdx), now / 1000 * 0.12 + i * 0.11) : [130, 170, 255]
        NLText(val, bx + bw - 70, ry, i = states.Length && on ? NLC(240, 110, 110) : RDMix([120, 124, 160], vc, r.t), MCFontS, 62, 19, 2, 1)
    }
    if (ia > 0.01) {
        NLAlphaPage := base * ia
        NLText("no macros running", bx + 8, y - 21 * ia, MCDimC(), MCFontS, bw - 16, 19, 0, 1)
    }
    DllCall("gdiplus\GdipResetClip", "Ptr", HudG)
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    NLG := prevG, NLAlphaPage := prevA
    HudBusy := (hap < 1) || busy
    sz := Buffer(8, 0), NumPut("Int", HUDW, sz, 0), NumPut("Int", H, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", HudGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", HudMemDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; the macro HUD in the Gamesense style: no box, just bold capital words with an icon and a dark shadow, green while the
; macro runs (with a small spinning circle next to it), dim white while it is off. Rows slide in, fade and glide like the others.
HudRenderGS(states, labels)
{
    global HudG, HudMemDC, HudGui, HudH, HUDW, HUDMAXH, HudOpacity, HudBusy, HudPosition, HudCustom, HudMoving, NLG, NLAlphaPage, HudShowKeys, HudCompact, RDIcons, RDPrev, RDFlash, GSFont, GSIcon, HudGradIdx
    if (!GSFont) {
        NLGdipInit()
        GSFont := NLMakeFont("Segoe UI", 15, 1)
        GSIcon := NLMakeFont("Segoe UI Symbol", 14, 0)
    }
    now := A_TickCount, busy := false
    rows := [], y := 6, anyOn := false
    Loop states.Length {
        i := A_Index, st := states[i] ? 1 : 0
        if (st)
            anyOn := true
        if (RDPrev.Has(i) && RDPrev[i] != st)
            RDFlash[i] := now
        RDPrev[i] := st
        t := RDEase("gt" i, st, 0.22, &busy)
        e := RDEase("gv" i, HudCompact ? st : 1, 0.2, &busy)
        if (e > 0.01) {
            rows.Push({i: i, t: t, e: e, y: y})
            y += 26 * e
        }
    }
    H := Min(HUDMAXH, Max(30, Round(y + 6)))
    if (H != HudH) {
        HudH := H
        if (InStr(HudPosition, "Bottom") && !HudCustom && !HudMoving)
            HudGui.Move(, A_ScreenHeight - 8 - H, HUDW, H)
        else
            HudGui.Move(, , HUDW, H)
    }
    prevG := NLG, prevA := NLAlphaPage
    NLG := HudG
    hap := HAnimAp("hud")
    base := Max(0.2, HudOpacity / 255) * hap
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", HudG, "UInt", 0)
    if (hap < 1)
        HAnimXf(HudG, HUDW / 2, H / 2, 1.0, hap)
    global AccentColor
    white := [196, 196, 206], red := [240, 96, 96]
    gst := SPLogoStops(HudGradIdx)                                ; (running macros take the HUD gradient, Misc > Overlay;
    accRgb := SPHexArr(AccentColor)                               ;  the default "Accent Flow" is the plain accent colour, so it stands out)
    for r in rows {
        i := r.i, on := states[i] ? true : false
        fl := RDFlash.Has(i) ? now - RDFlash[i] : 99999
        if (fl < 500)
            busy := true
        NLAlphaPage := base * r.e * (0.82 + 0.18 * r.t)
        x := 10 - (1 - r.e) * 40, ry := r.y
        if (on && fl < 300)                                       ; a small kick to the right when it switches on
            x += 6 * Sin(fl / 300 * 3.14159)
        acc := (i = states.Length) ? red : (HudGradIdx = 1) ? accRgb : SPStopsSample(gst, now / 1000 * 0.12 + i * 0.11)
        col := RDMix(white, acc, r.t)
        txt := StrUpper(labels[i]) (HudShowKeys ? " [" HudKeyFor(i) "]" : "")
        tw := NLTextW(txt, GSFont)
