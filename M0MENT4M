        }
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    NLG := prevG, NLAlphaPage := prevA
    HudBusy := (hap < 1) || busy
    sz := Buffer(8, 0), NumPut("Int", HUDW, sz, 0), NumPut("Int", H, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", HudGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", HudMemDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; the lagswitch pill in the Mercury look ("Velocity modifier" style): the title over a thin bar that runs out during the
; freeze, green -> yellow -> red; idle it shows the set freeze time with a full green bar
VigPillMC(T, dur, idle)
{
    global VigLastText, MCFont, MCFontS, RDIcon
    MCInitFonts()
    if (dur > 0) {
        span := VigSpan(dur)
        frac := idle ? 1.0 : Max(0.0, Min(1.0, 1 - T / span))
        ms := Round(dur * frac) " ms"
        VigLastText := ms
    } else
        frac := 0.5 + 0.5 * Sin(T / 300), ms := Round(T / 100) / 10 " s"
    g := [118, 222, 96], yl := [236, 206, 72], rd := [240, 92, 82]
    c := (frac >= 0.5) ? [yl[1] + (g[1] - yl[1]) * (frac - 0.5) * 2, yl[2] + (g[2] - yl[2]) * (frac - 0.5) * 2, yl[3] + (g[3] - yl[3]) * (frac - 0.5) * 2]
        : [rd[1] + (yl[1] - rd[1]) * frac * 2, rd[2] + (yl[2] - rd[2]) * frac * 2, rd[3] + (yl[3] - rd[3]) * frac * 2]
    c := [Round(c[1]), Round(c[2]), Round(c[3])]
    MCBox(7, 4, 236, 54, 9)                                   ; the same glowing box as the Mercury macro HUD
    tw := NLTextW("Lagswitch", MCFont)
    NLText(Chr(0x231B), 17, 5, MCValC(), RDIcon, 18, 22, 1, 1)
    NLText("Lagswitch", 36, 5, MCTextC(), MCFont, tw + 8, 22, 0, 1)
    NLText(ms, 150, 5, MCValC(), MCFontS, 84, 22, 2, 1)
    NLLine(15, 29, 235, 29, NLC(178, 184, 236, 150))
    bx := 17, bw := 216, by := 39
    if (!idle)
        NLRR(bx - 3, by - 3, Max(12, bw * frac) + 6, 12, 6, NLC(c[1], c[2], c[3], 50))
    NLRR(bx, by, bw, 6, 3, NLC(44, 46, 64, 230))
    if (frac > 0.01)
        NLRR(bx, by, Max(6, bw * frac), 6, 3, NLC(c[1], c[2], c[3]))
}

