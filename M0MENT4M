; the macro HUD in the Silentium style: a dark glass card with the handwritten name on top; every macro has a small switch
; like the ones in the menu, which glows while it runs, and a running macro gets an accent fade from the left with a bar on
; the edge (like the selected tab). Rows slide in and out (compact) and glide to their places like the other styles.
HudRenderSL(states, labels)
{
    global HudG, HudMemDC, HudGui, HudH, HUDW, HUDMAXH, HudOpacity, HudBusy, HudPosition, HudCustom, HudMoving, NLG, NLAlphaPage, HudShowKeys, HudCompact, RDPrev, RDFlash, MCFontS
    SLFonts()
    now := A_TickCount, busy := false
    rows := [], y := 44, anyOn := false
    Loop states.Length {
        i := A_Index, st := states[i] ? 1 : 0
        if (st)
            anyOn := true
        if (RDPrev.Has(i) && RDPrev[i] != st)
            RDFlash[i] := now
        RDPrev[i] := st
        t := RDEase("st" i, st, 0.22, &busy)
        e := RDEase("sv" i, HudCompact ? st : 1, 0.2, &busy)
        if (e > 0.01) {
            rows.Push({i: i, t: t, e: e, y: y})
            y += 22 * e
        }
    }
    ia := RDEase("sidle", (HudCompact && !anyOn) ? 1 : 0, 0.2, &busy)
    y += 22 * ia
    bh := RDEase("sbox", y + 2, 0.25, &busy)
    H := Min(HUDMAXH, Max(54, Round(bh + 10)))
    if (H != HudH) {
        HudH := H
        if (InStr(HudPosition, "Bottom") && !HudCustom && !HudMoving)
            HudGui.Move(, A_ScreenHeight - 8 - H, HUDW, H)
        else
            HudGui.Move(, , HUDW, H)
    }
    prevG := NLG, prevA := NLAlphaPage
    NLG := HudG
    hap := HAnimAp("hud")
    base := Max(0.2, HudOpacity / 255) * hap
    NLAlphaPage := base
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", HudG, "UInt", 0)
    if (hap < 1)
        HAnimXf(HudG, HUDW / 2, H / 2, 1.0, hap)
    bw := HUDW - 14, bx := 7, boxH := Min(H - 14, bh - 6)
    SLBox(bx, 7, bw, boxH, 10)
    if (HudStyleBorder(bx, 7, bw, boxH, 10))
        busy := true
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", HudG, "Int", bx, "Int", 7, "Int", bw, "Int", Max(1, Round(boxH)), "Int", 0)
    global SLFontScript
    tw := NLTextW("m0ment4m", SLFontScript) + 10
    SLBrand(bx + (bw - tw) / 2, 8, 28)
    ac := SLAccArr()
    hw := (bw - 24) / 2                                       ; (a divider that fades out to both sides)
    VigGradRect(HudG, Round(bx + 12), 38, Round(hw), 1, NLC(ac[1], ac[2], ac[3], 0), NLC(ac[1], ac[2], ac[3], 150), 0)
    VigGradRect(HudG, Round(bx + 12 + hw), 38, Round(hw), 1, NLC(ac[1], ac[2], ac[3], 150), NLC(ac[1], ac[2], ac[3], 0), 0)
    for r in rows {
        i := r.i, on := states[i] ? true : false
        fl := RDFlash.Has(i) ? now - RDFlash[i] : 99999
        if (fl < 620)
            busy := true
        NLAlphaPage := base * r.e
        x := bx + 12 - (1 - r.e) * 30, ry := r.y
        lock := (i = states.Length)
        c := lock ? [244, 96, 112] : SLAccArr(i * 0.11)
        if (r.t > 0.02) {                                     ; running: an accent fade from the left and a bar on the edge
            VigGradRect(HudG, bx + 3, Round(ry + 1), Round(bw * 0.72), 19, NLC(c[1], c[2], c[3], Round(64 * r.t)), NLC(c[1], c[2], c[3], 0), 0)
            NLRR(bx + 3, ry + 4, 2.6, 13, 1.3, NLC(c[1], c[2], c[3], Round(255 * r.t)))
        }
        NLText(labels[i], x, ry, RDMix([150, 150, 162], [246, 246, 250], r.t), MCFontS, bw - 70, 21, 0, 1)
        if (HudShowKeys)
            NLText(HudKeyFor(i), bx + bw - 78, ry, RDMix([118, 118, 130], c, r.t), MCFontS, 68, 21, 2, 1)
        else {                                                ; a little switch like the menu's
            sx := bx + bw - 38, sy := ry + 4.5
            if (on && fl < 600)                               ; (it flashes when the macro starts)
                NLRR(sx - 6, sy - 6, 36, 24, 12, NLC(c[1], c[2], c[3], Round(70 * Sin(fl / 600 * 3.14159))))
            if (r.t > 0.02)
                NLRR(sx - 3, sy - 3, 30, 18, 9, NLC(c[1], c[2], c[3], Round(40 * r.t)))
            NLRR(sx, sy, 24, 12, 6, RDMix([50, 50, 58], c, r.t))
            NLDisc(sx + 6 + 12 * r.t, sy + 6, 4.6, NLC(255, 255, 255, Round(200 + 55 * r.t)))
        }
    }
    if (ia > 0.01) {
        NLAlphaPage := base * ia
        NLText("no macros running", bx + 12, y - 22 * ia, NLC(150, 150, 162), MCFontS, bw - 24, 21, 0, 1)
    }
    DllCall("gdiplus\GdipResetClip", "Ptr", HudG)
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", HudG)
    NLG := prevG, NLAlphaPage := prevA
    HudBusy := (hap < 1) || busy
    sz := Buffer(8, 0), NumPut("Int", HUDW, sz, 0), NumPut("Int", H, sz, 4)
    src := Buffer(8, 0)
    bf := Buffer(4, 0), NumPut("UChar", 255, bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", HudGui.Hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", HudMemDC, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

