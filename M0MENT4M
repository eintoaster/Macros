; the accent (or, with a HUD gradient picked, a colour that drifts along it)
SLAccArr(phase := 0.0)
{
    global HudGradIdx, AccentColor
    if (HudGradIdx > 1)
        return SPStopsSample(SPLogoStops(HudGradIdx), A_TickCount / 1000 * 0.12 + phase)
