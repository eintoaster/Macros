; a row of buttons; each item: [id, text, fn, primary]
UButtonRow(btns) {
    global UCX, UCY, UCW, UHover, UActive, UDown, F_B
    h := 36, gap := 8
    n := btns.Length
    bw := (UCW - 36 - gap * (n - 1)) / n
    x := UCX + 18
    for b in btns {
        hv := ULerp("b" b[1], UHover = b[1] ? 1 : 0, 0.25)
        pr := (UDown && IsObject(UActive) && UActive.id = b[1]) ? 1 : 0
        pk := ULerp("bp" b[1], pr, 0.35)
        ins := 1.5 * pk
        if (b.Length >= 4 && b[4]) {
            UGradFill(x + ins, UCY + 4 + ins, bw - ins * 2, h - ins * 2, 10, GradStops(1), A_TickCount / 1000 * 0.15 * hv, 0.85 + 0.15 * hv, bw * 2)
            if (hv > 0.01)
                URR(x - 2, UCY + 2, bw + 4, h + 4, 12, UAcc(Round(30 * hv)))
            UText(b[2], x, UCY + 4, UC(255, 255, 255), F_B, bw, h, 1, 1)
        } else {
            URR(x + ins, UCY + 4 + ins, bw - ins * 2, h - ins * 2, 10, UMix("Pill", "Hover", hv))
            URRLine(x + ins, UCY + 4 + ins, bw - ins * 2, h - ins * 2, 10, UMix("Border", "Muted", hv * 0.5))
            UText(b[2], x, UCY + 4, UMix("Text2", "Text", hv), F_B, bw, h, 1, 1)
        }
        UHitP(b[1], x, UCY + 4, bw, h, b[3])
        x += bw + gap
    }
    UCY += h + 12
}

; small selectable chips; each item: [id, text, fn, selected]
UChipRow(chips) {
    global UCX, UCY, UCW, UHover, F_Sm
    h := 28, gap := 6
    n := chips.Length
    cw := (UCW - 36 - gap * (n - 1)) / n
    x := UCX + 18
    for c in chips {
        hv := ULerp("c" c[1], UHover = c[1] ? 1 : 0, 0.25)
        st := ULerp("cs" c[1], c[4] ? 1 : 0, 0.2)
        URR(x, UCY + 2, cw, h, 9, UMix("Pill", "Hover", hv))
        if (st > 0.01) {
            URR(x, UCY + 2, cw, h, 9, UAcc(Round(40 * st)))
            URRLine(x, UCY + 2, cw, h, 9, UAcc(Round(200 * st)))
        } else
            URRLine(x, UCY + 2, cw, h, 9, UCol("Border"))
        UText(c[2], x, UCY + 2, st > 0.5 ? UCol("Text") : UMix("Text2", "Text", hv), F_Sm, cw, h, 1, 1)
        UHitP(c[1], x, UCY + 2, cw, h, c[3])
        x += cw + gap
    }
    UCY += h + 12
}

; a label on the left, a value on the right (optionally clickable)
UInfoRow(id, label, value, valCol := "", fn := "") {
    global UCX, UCY, UCW, F_UI, F_Sm
    h := 36
    if (fn)
        URowHover(id, h)
    UText(label, UCX + 18, UCY, UCol("Text2"), F_UI, UCW - 150, h, 0, 1)
    cw := Max(56, UTextW(value, F_Sm) + 22)
    URR(UCX + UCW - 18 - cw, UCY + 7, cw, 22, 11, UCol("Pill"))
    UText(value, UCX + UCW - 18 - cw, UCY + 7, valCol = "" ? UCol("Text") : valCol, F_Sm, cw, 22, 1, 1)
    if (fn)
        UHitP(id, UCX + 6, UCY, UCW - 12, h, fn)
    UCY += h
}

UTextRow(text, col := "", lines := 2, font := 0) {
    global UCX, UCY, UCW, F_Sm
    h := lines * 17 + 8
    UText(text, UCX + 18, UCY + 4, col = "" ? UCol("Muted") : col, font ? font : F_Sm, UCW - 36, h, 0, 0, true)
    UCY += h + 4
}

UStatusRow(text, col) {
    global UCX, UCY, UCW, F_Sm
    URR(UCX + 16, UCY + 4, UCW - 32, 30, 10, UCol("Pill"))
    p := 0.6 + 0.4 * Sin(A_TickCount / 300)
    UDisc(UCX + 32, UCY + 19, 3.5, col)
    UText(text, UCX + 44, UCY + 4, UCol("Text2"), F_Sm, UCW - 70, 30, 0, 1)
    UCY += 42
}

