UShowListening() {
    global UShown, UTimerOn
    if (!UShown)
        return
    URender()
    UTimerOn := false                                        ; (never trust a stale "already running" flag here)
    UReq()
}

class UList {
    __New(items, idx := 1, onChoose := "") {
        this.items := items
        this.idx := items.Length ? idx : 0
        this.onChoose := onChoose
    }
    Value => this.idx
    Text {
        get => (this.idx >= 1 && this.idx <= this.items.Length) ? this.items[this.idx] : ""
        set {
            for i, it in this.items {
                if (it = value) {
                    this.idx := i
                    return
                }
            }
        }
    }
    Choose(i) {
        this.idx := i
        if (this.onChoose)
            this.onChoose.Call(i)
        UReq()
    }
    Delete() {
        this.items := []
        this.idx := 0
    }
    Add(arr) {
        for it in arr
            this.items.Push(it)
        if (!this.idx && this.items.Length)
            this.idx := 1
    }
}

