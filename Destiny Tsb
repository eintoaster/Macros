UGdipInit() {
    global UToken, UFmt, UFmtW, F_UI, F_Sm, F_B, F_H, F_Logo, F_Tiny, F_Icon, F_IconSm, F_Mono
    if (UToken)
        return
    DllCall("LoadLibrary", "Str", "gdiplus")
    si := Buffer(24, 0)
    NumPut("UInt", 1, si, 0)
    tok := 0
    DllCall("gdiplus\GdiplusStartup", "Ptr*", &tok, "Ptr", si, "Ptr", 0)
    UToken := tok
    f := 0
    DllCall("gdiplus\GdipCreateStringFormat", "Int", 0x5000, "Int", 0, "Ptr*", &f)
    UFmt := f
    DllCall("gdiplus\GdipCreateStringFormat", "Int", 0x4000, "Int", 0, "Ptr*", &f)
    UFmtW := f
    F_UI := UMakeFont("Segoe UI", 13.5, 0)
    F_Sm := UMakeFont("Segoe UI", 12, 0)
    F_B := UMakeFont("Segoe UI Semibold", 13.5, 0)
    F_H := UMakeFont("Segoe UI", 21, 1)
    F_Logo := UMakeFont("Segoe UI Black", 22, 0)
    F_Tiny := UMakeFont("Segoe UI", 10.5, 1)
    F_Icon := UMakeFont("Segoe MDL2 Assets", 15, 0)
    F_IconSm := UMakeFont("Segoe MDL2 Assets", 11, 0)
    F_Mono := UMakeFont("Consolas", 12.5, 0)
}

UMakeFont(name, px, style) {
    fam := 0, font := 0
    DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", name, "Ptr", 0, "Ptr*", &fam)
    if (!fam)
        DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", "Segoe UI", "Ptr", 0, "Ptr*", &fam)
    DllCall("gdiplus\GdipCreateFont", "Ptr", fam, "Float", px, "Int", style, "Int", 2, "Ptr*", &font)
    return font
}

; a 32-bit picture with its own GDI+ graphics, for a layered window
UMakeSurface(w, h) {
    dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
    bi := Buffer(40, 0)
    NumPut("Int", 40, bi, 0), NumPut("Int", w, bi, 4), NumPut("Int", -h, bi, 8), NumPut("Short", 1, bi, 12), NumPut("Short", 32, bi, 14)
    bits := 0
    hb := DllCall("CreateDIBSection", "Ptr", dc, "Ptr", bi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
    DllCall("SelectObject", "Ptr", dc, "Ptr", hb)
    g := 0
    DllCall("gdiplus\GdipCreateFromHDC", "Ptr", dc, "Ptr*", &g)
    DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", g, "Int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", g, "Int", 4)
    return {dc: dc, g: g, w: w, h: h}
}

ULayered(hwnd, dc, w, h, alpha := 255) {
    sz := Buffer(8, 0), src := Buffer(8, 0), bf := Buffer(4, 0)
    NumPut("Int", w, sz, 0), NumPut("Int", h, sz, 4)
    NumPut("UChar", Max(0, Min(255, alpha)), bf, 2), NumPut("UChar", 1, bf, 3)
    DllCall("UpdateLayeredWindow", "Ptr", hwnd, "Ptr", 0, "Ptr", 0, "Ptr", sz, "Ptr", dc, "Ptr", src, "UInt", 0, "Ptr", bf, "UInt", 2)
}

; Brushes, pens and paths are cached. Every drawing function runs Critical, so the caches are only emptied at the
; start of a frame, when nothing is holding one of them.
UCacheTrim() {
    global UBrushes, UPens, UPaths
    if (UBrushes.Count > 600) {
        for k, h in UBrushes
            DllCall("gdiplus\GdipDeleteBrush", "Ptr", h)
        UBrushes := Map()
    }
    if (UPens.Count > 300) {
        for k, h in UPens
            DllCall("gdiplus\GdipDeletePen", "Ptr", h)
        UPens := Map()
    }
    if (UPaths.Count > 600) {
        for k, h in UPaths
            DllCall("gdiplus\GdipDeletePath", "Ptr", h)
        UPaths := Map()
    }
}

UBrush(argb) {
    global UBrushes
    if (UBrushes.Has(argb))
        return UBrushes[argb]
    b := 0
    DllCall("gdiplus\GdipCreateSolidFill", "UInt", argb, "Ptr*", &b)
    UBrushes[argb] := b
    return b
}

UPen(argb, wd := 1) {
    global UPens
    key := argb "|" wd
    if (UPens.Has(key))
        return UPens[key]
    p := 0
    DllCall("gdiplus\GdipCreatePen1", "UInt", argb, "Float", wd, "Int", 2, "Ptr*", &p)
    DllCall("gdiplus\GdipSetPenStartCap", "Ptr", p, "Int", 2)
    DllCall("gdiplus\GdipSetPenEndCap", "Ptr", p, "Int", 2)
    UPens[key] := p
    return p
}

UNewPath(x, y, w, h, r) {
    p := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", &p)
    r := Min(r, w / 2, h / 2)
    if (r <= 0.5) {
        DllCall("gdiplus\GdipAddPathRectangle", "Ptr", p, "Float", x, "Float", y, "Float", w, "Float", h)
        return p
    }
    d := r * 2
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x, "Float", y, "Float", d, "Float", d, "Float", 180, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x + w - d, "Float", y, "Float", d, "Float", d, "Float", 270, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x + w - d, "Float", y + h - d, "Float", d, "Float", d, "Float", 0, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x, "Float", y + h - d, "Float", d, "Float", d, "Float", 90, "Float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "Ptr", p)
    return p
}

; rounded rectangle path at its real position (cached)
UPath(x, y, w, h, r) {
    global UPaths
    key := Round(x, 1) "|" Round(y, 1) "|" Round(w, 1) "|" Round(h, 1) "|" r
    if (UPaths.Has(key))
        return UPaths[key]
    p := UNewPath(x, y, w, h, r)
    UPaths[key] := p
    return p
}

URR(x, y, w, h, r, argb) {
    global UG
    if (w <= 0 || h <= 0 || (argb >> 24) = 0)
        return
    if (r <= 0)
        DllCall("gdiplus\GdipFillRectangle", "Ptr", UG, "Ptr", UBrush(argb), "Float", x, "Float", y, "Float", w, "Float", h)
    else
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", UBrush(argb), "Ptr", UPath(x, y, w, h, r))
}

URRLine(x, y, w, h, r, argb, wd := 1) {
    global UG
    if ((argb >> 24) = 0)
        return
    DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", UPen(argb, wd), "Ptr", UPath(x + 0.5, y + 0.5, w - 1, h - 1, r))
}

UDisc(cx, cy, rad, argb) {
    global UG
    if ((argb >> 24) = 0)
        return
    DllCall("gdiplus\GdipFillEllipse", "Ptr", UG, "Ptr", UBrush(argb), "Float", cx - rad, "Float", cy - rad, "Float", rad * 2, "Float", rad * 2)
}

URing(cx, cy, rad, argb, wd := 1.5) {
    global UG
    DllCall("gdiplus\GdipDrawEllipse", "Ptr", UG, "Ptr", UPen(argb, wd), "Float", cx - rad, "Float", cy - rad, "Float", rad * 2, "Float", rad * 2)
}

ULine(x1, y1, x2, y2, argb, wd := 1) {
    global UG
    DllCall("gdiplus\GdipDrawLine", "Ptr", UG, "Ptr", UPen(argb, wd), "Float", x1, "Float", y1, "Float", x2, "Float", y2)
}

; ha: 0 left, 1 centre, 2 right.  va: 0 top, 1 middle.
UText(str, x, y, argb, font, w := 0, h := 0, ha := 0, va := 0, wrap := false) {
    global UG, UFmt, UFmtW
    static lastA := Map(), lastV := Map(), rc := Buffer(16, 0)
    if (str = "" || (argb >> 24) = 0)
        return
    fmt := wrap ? UFmtW : UFmt
    if (lastA.Get(fmt, -1) != ha) {
        DllCall("gdiplus\GdipSetStringFormatAlign", "Ptr", fmt, "Int", ha)
        lastA[fmt] := ha
    }
    if (lastV.Get(fmt, -1) != va) {
        DllCall("gdiplus\GdipSetStringFormatLineAlign", "Ptr", fmt, "Int", va)
        lastV[fmt] := va
    }
    NumPut("Float", x, rc, 0), NumPut("Float", y, rc, 4), NumPut("Float", w ? w : 2000, rc, 8), NumPut("Float", h ? h : 1000, rc, 12)
    DllCall("gdiplus\GdipDrawString", "Ptr", UG, "WStr", String(str), "Int", -1, "Ptr", font, "Ptr", rc, "Ptr", fmt, "Ptr", UBrush(argb))
}

; width of a text (cached)
UTextW(str, font) {
    global UG, UFmt
    static known := Map()
    key := font "|" str
    if (known.Has(key))
        return known[key]
    if (known.Count > 3000)
        known.Clear()
    rc := Buffer(16, 0), out := Buffer(16, 0)
    NumPut("Float", 2000, rc, 8), NumPut("Float", 200, rc, 12)
    DllCall("gdiplus\GdipMeasureString", "Ptr", UG, "WStr", String(str), "Int", -1, "Ptr", font, "Ptr", rc, "Ptr", UFmt, "Ptr", out, "Ptr", 0, "Ptr", 0)
    known[key] := NumGet(out, 8, "Float")
    return known[key]
}

; moving linear gradient brush; the colours repeat every w (and h) pixels, shift moves them along
UGradBrush(x, y, w, h, stops, shift, alpha := 1.0) {
    global UAlpha
    a := Max(0, Min(255, Round(255 * alpha * UAlpha)))
    m := stops.Length, n := m + 1
    cols := Buffer(4 * n), pos := Buffer(4 * n)
    Loop n {
        c := stops[Mod(A_Index - 1, m) + 1]
        NumPut("UInt", (a << 24) | (c[1] << 16) | (c[2] << 8) | c[3], cols, (A_Index - 1) * 4)
        NumPut("Float", (A_Index - 1) / m, pos, (A_Index - 1) * 4)
    }
    w := Max(1, w)
    p1 := Buffer(8), p2 := Buffer(8)
    NumPut("Float", x, p1, 0), NumPut("Float", y, p1, 4), NumPut("Float", x + w, p2, 0), NumPut("Float", y + h, p2, 4)
    br := 0
    DllCall("gdiplus\GdipCreateLineBrush", "Ptr", p1, "Ptr", p2, "UInt", NumGet(cols, 0, "UInt"), "UInt", NumGet(cols, 4 * m, "UInt"), "Int", 0, "Ptr*", &br)
    DllCall("gdiplus\GdipSetLinePresetBlend", "Ptr", br, "Ptr", cols, "Ptr", pos, "Int", n)
    f := shift - Floor(shift)
    if (f)
        DllCall("gdiplus\GdipTranslateLineTransform", "Ptr", br, "Float", -f * w, "Float", -f * h, "Int", 0)
    return br
}

; fill a rounded rectangle with a gradient that spans span pixels (0 = the rectangle's own width)
UGradFill(x, y, w, h, r, stops, shift := 0, alpha := 1.0, span := 0) {
    global UG
    if (w <= 0 || h <= 0 || alpha <= 0.004)
        return
    br := UGradBrush(x, y, span ? span : w, 0, stops, shift, alpha)
    DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", UPath(x, y, w, h, r))
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
}

UGradBorder(x, y, w, h, r, stops, shift, wd := 1.5, alpha := 1.0) {
    global UG
    br := UGradBrush(x, y, w, h, stops, shift, alpha)
    pen := 0
    DllCall("gdiplus\GdipCreatePen2", "Ptr", br, "Float", wd, "Int", 2, "Ptr*", &pen)
    DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", pen, "Ptr", UPath(x + 0.5, y + 0.5, w - 1, h - 1, r))
    DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
}

; soft round glow: full colour in the middle, fading to nothing at the edge
UGlow(cx, cy, rx, ry, rgb, a) {
    global UG
    if (a <= 0)
        return
    path := 0, br := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", &path)
    DllCall("gdiplus\GdipAddPathEllipse", "Ptr", path, "Float", cx - rx, "Float", cy - ry, "Float", rx * 2, "Float", ry * 2)
    DllCall("gdiplus\GdipCreatePathGradientFromPath", "Ptr", path, "Ptr*", &br)
    DllCall("gdiplus\GdipSetPathGradientCenterColor", "Ptr", br, "UInt", (a << 24) | rgb)
    sc := Buffer(4, 0)
    NumPut("UInt", rgb, sc, 0)
    cnt := 1
    DllCall("gdiplus\GdipSetPathGradientSurroundColorsWithCount", "Ptr", br, "Ptr", sc, "Int*", &cnt)
    DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", path)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
    DllCall("gdiplus\GdipDeletePath", "Ptr", path)
}

UClip(x, y, w, h) {
    global UG
    DllCall("gdiplus\GdipSetClipRectI", "Ptr", UG, "Int", Floor(x), "Int", Floor(y), "Int", Ceil(w), "Int", Ceil(h), "Int", 0)
}
UClipReset() {
    global UG
    DllCall("gdiplus\GdipResetClip", "Ptr", UG)
}

; ==============================================================================
;  ANIMATION, HITS & REDRAW
; ==============================================================================

; eases v toward target; f is the share covered per 60 fps frame (scaled by the real frame time)
ULerp(id, target, f) {
    global UAnim, UAnimating, UFrameK
    v := UAnim.Has(id) ? UAnim[id] : target
    v += (target - v) * (1 - (1 - f) ** UFrameK)
    if (Abs(target - v) < 0.003)
        v := target
    else
        UAnimating := true
    UAnim[id] := v
    return v
}

UEase(t) => 1 - (1 - Max(0.0, Min(1.0, t))) ** 3

UHit(id, x, y, w, h, fn, data := "") {
    global UHitsB
    UHitsB.Push({id: id, x: x, y: y, w: w, h: h, fn: fn, data: data})
}

; a hit inside the scrolling page: only the visible part counts
UHitP(id, x, y, w, h, fn, data := "") {
    global UTop, UH
    y1 := Max(y, UTop - 6), y2 := Min(y + h, UH - 14)
    if (y2 > y1)
        UHit(id, x, y1, w, y2 - y1, fn, data)
}

UHitAt(x, y) {
    global UHits
    i := UHits.Length
    while (i >= 1) {
        h := UHits[i]
        if (x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h)
            return h
        i--
    }
    return 0
}

UReq() {
    global UTimerOn, UShown
    if (!UShown || UTimerOn)
        return
    UTimerOn := true
    SetTimer(UTick, 16)
}

UTick() {
    global UShown, UAnimating, UDown, UEdit, UTimerOn
    ; Critical for the whole tick: a click that starts a key bind must not slip in between "timer off" and
    ; "UTimerOn := false". The bind waits in a loop, the tick could not finish, and every redraw request after
    ; that was thrown away (UTimerOn stayed true) - so "press a key" sometimes never showed.
    Critical
    if (!UShown) {
        SetTimer(UTick, 0)
        UTimerOn := false
        return
    }
    URender()
    if (!UAnimating && !UDown && !IsObject(UEdit) && !UListening()) {
        SetTimer(UTick, 0)
        UTimerOn := false
    }
}

; the brand name keeps flowing while the menu is open (a light 15 frames a second)
ULogoTick() {
    global UShown, LogoAnimated, UTimerOn, LogoGrad
    if (UShown && LogoAnimated && !UTimerOn)
        URender()
}

; a key box is waiting for a key
UListening() {
    for b in [BtnK_Ext1, BtnK_Ext2, BtnK_Ext3, BtnK_Ext4, BtnK_JumpBug, BtnK_Lag, BtnK_Lock, BtnK_Min, BtnK_Rel, BtnK_Exit]
        if (InStr(b.Text, "Press"))
            return true
    return false
}

URunHit(fn, *) {
    try fn.Call()
    UReq()
}

; ==============================================================================
;  WINDOW: SHOW / HIDE / INPUT
; ==============================================================================

UShow() {
    global UGui, UHwnd, UShown, UInited, US, UG, UX, UY, UW, UH, UWinTarget, UWinHide, UPageT
    if (!UInited) {
        UGdipInit()
        UGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 -DPIScale", "Destiny // TSB")
        UHwnd := UGui.Hwnd
        US := UMakeSurface(UW, UH)
        UG := US.g
        UInited := true
    }
    UX := Max(0, Min(A_ScreenWidth - 80, UX)), UY := Max(0, Min(A_ScreenHeight - 60, UY))
    UShown := true, UWinTarget := 1, UWinHide := false, UPageT := 0.0
    UAnimSet("win", 0), UAnimSet("page", 0)
    UGui.Show("x" UX " y" UY " w" UW " h" UH)
    SetTimer(UInputTick, 16)
    URender()
    UReq()
    HudRequest()                                             ; (the HUD's idle animation runs while the menu is open)
}

UHide() {
    global UWinTarget, UWinHide
    UEditStop()
    UWinTarget := 0, UWinHide := true
    UReq()
}

UHideNow() {
    global UGui, UShown, UX, UY
    UGui.GetPos(&x, &y)
    UX := x, UY := y
    UShown := false
    UGui.Hide()
    USavePrefs()
}

UOnWheel(wParam, lParam, msg, hwnd) {
    global UHwnd, UScrollT, UContentH, UH, UTop, UDD
    if (hwnd != UHwnd)
        return
    delta := (wParam >> 16) & 0xFFFF
    if (delta > 32767)
        delta -= 65536
    if (IsObject(UDD) && UDD.open) {
        UDD.scroll := Max(0, Min(Max(0, UDD.list.items.Length - 7) * 30, UDD.scroll - delta / 120 * 30))
    } else {
        maxS := Max(0, UContentH - (UH - 14 - UTop))
        UScrollT := Max(0, Min(maxS, UScrollT - delta / 120 * 70))
    }
    UReq()
    return 0
}

; The mouse is read directly (position + button) while the menu is visible: while the game holds the mouse,
; Windows does not send mouse messages to other windows.
UInputTick() {
    global UShown, UGui, UHwnd, UW, UH, UMx, UMy, UHover, UDown, UActive, ULastBtn, UDrag, USlider, UScrollDrag, UEdit
    if (!UShown) {
        SetTimer(UInputTick, 0)
        return
    }
    if (IsObject(UEdit) && WinActive(GAME_EXE))
        UEditStop()
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    sx := NumGet(pt, 0, "Int"), sy := NumGet(pt, 4, "Int")
    UGui.GetPos(&wx, &wy)
    x := sx - wx, y := sy - wy
    inside := (x >= 0 && y >= 0 && x < UW && y < UH) && DllCall("WindowFromPoint", "Int64", (sx & 0xFFFFFFFF) | (sy << 32), "Ptr") = UHwnd
    btn := (DllCall("GetAsyncKeyState", "Int", 1, "Short") & 0x8000) != 0
    h := inside ? UHitAt(x, y) : 0
    nid := IsObject(h) ? h.id : ""
    if (nid != UHover) {
        UHover := nid
        UReq()
    }
    UMx := x, UMy := y
    if (UListening()) {                                     ; a key box takes the next key / button: clicks are not menu clicks
        ULastBtn := btn
        return
    }
    if (btn && !ULastBtn) {
        if (inside) {
            if (IsObject(UEdit) && !(IsObject(h) && h.id = UEdit.id))
                UEditStop()
            UDown := true
            if (!IsObject(h)) {
                UActive := 0
                UDrag := {ox: x, oy: y}
            } else if (Type(h.fn) = "String" && h.fn = "slider") {
                UActive := h
                USlider := h.data
                USliderMove(x)
            } else if (Type(h.fn) = "String" && h.fn = "vscroll") {
                UActive := h
                UScrollDrag := h.data
                UScrollMove(y)
            } else {
                UActive := h
            }
            UReq()
        }
    } else if (!btn && ULastBtn) {
        if (IsObject(UActive) && !IsObject(USlider) && !IsObject(UScrollDrag)) {
            hh := inside ? UHitAt(x, y) : 0
            if (IsObject(hh) && hh.id = UActive.id && IsObject(hh.fn))
                SetTimer(URunHit.Bind(hh.fn), -1)
        }
        if (IsObject(UDrag))
            USavePrefs()
        if (IsObject(USlider))
            UNotify(USlider.label, Format(USlider.fmt, USlider.last), true, "slider")
        UActive := 0, UDrag := 0, USlider := 0, UScrollDrag := 0, UDown := false
        UReq()
    } else if (btn) {
        if (IsObject(USlider)) {
            USliderMove(x)
        } else if (IsObject(UScrollDrag)) {
            UScrollMove(y)
        } else if (IsObject(UDrag)) {
            UGui.Move(sx - UDrag.ox, sy - UDrag.oy)
        }
    }
    ULastBtn := btn
}

USliderMove(x) {
    global USlider
    s := USlider
    v := Round(s.min + Max(0, Min(1, (x - s.tx) / s.tw)) * (s.max - s.min))
    if (v != s.last) {
        s.last := v
        s.setter.Call(v)
    }
    UReq()
}

UScrollMove(y) {
    global UScrollDrag, UScrollT, UScroll
    d := UScrollDrag
    f := Max(0, Min(1, (y - d.top - d.thumbH / 2) / Max(1, d.trackH - d.thumbH)))
    UScrollT := f * d.max, UScroll := UScrollT
    UReq()
}

; ---------- typing into a field (an input hook: the keys go to the field, not to the game) ----------
UEditStart(id, init, kind, setter, *) {
    global UEdit
    UEditStop()
    ih := InputHook("L40", "{Enter}{Esc}{Tab}")
    ih.KeyOpt("{Backspace}", "N")
    ih.OnChar := UEditChar
    ih.OnKeyDown := UEditKey
    ih.OnEnd := UEditEnd
    UEdit := {id: id, buf: String(init), kind: kind, setter: setter, ih: ih}
    ih.Start()
    UReq()
}

UEditChar(ih, ch) {
    global UEdit
    e := UEdit
    if (!IsObject(e) || e.ih != ih || StrLen(e.buf) >= 24)
        return
    isDigit := RegExMatch(ch, "^[0-9]$")                 ; (no >= on "0"/"9": AHK would compare them as numbers and fail on ".")
    if (e.kind = "int" && !isDigit)
        return
    if (e.kind = "float" && !(isDigit || (ch = "." && !InStr(e.buf, "."))))
        return
    if (e.kind = "text" && (Ord(ch) < 32 || InStr("\/:*?`"<>|", ch)))
        return
    e.buf .= ch
    UReq()
}

UEditKey(ih, vk, sc) {
    global UEdit
    if (vk = 8 && IsObject(UEdit) && UEdit.ih = ih)
        UEdit.buf := SubStr(UEdit.buf, 1, -1)
    UReq()
}

UEditEnd(ih) {
    global UEdit
    e := UEdit
    if (!IsObject(e) || e.ih != ih)
        return
    UEdit := 0
    if (!(ih.EndReason = "EndKey" && ih.EndKey = "Escape") && e.buf != "")
        SetTimer(URunHit.Bind(e.setter.Bind(e.buf)), -1)
    UReq()
}

; ends the typing and keeps what was typed
UEditStop() {
    global UEdit
    if (IsObject(UEdit))
        try UEdit.ih.Stop()
}

; ---------- drop-down lists ----------
UOpenDD(id, list, label := "", *) {
    global UDD, UAnim
    if (IsObject(UDD) && UDD.id = id && UDD.open) {
        UDD.open := false
        return
    }
    if (list = ProfileDDL)
        RefreshProfileList()
    UDD := {id: id, list: list, label: label, open: true, scroll: Max(0, (list.Value - 4) * 30), ax: 0, ay: 0, aw: 170}
    UAnim["ddx"] := 0.0
}

UCloseDD(*) {
    global UDD
    if (IsObject(UDD))
        UDD.open := false
}

UPickDD(i, *) {
    global UDD
    d := UDD
    if (!IsObject(d))
        return
    d.open := false
    d.list.Choose(i)
    if (d.list != ProfileDDL && d.label != "")
        UNotify(d.label, d.list.Text, true, "pick")
}

; ---------- a notification card for every change made in the menu ----------
UNotify(label, value, on := true, cat := "system") {
    ShowStatus(label ": " value, on ? "0x082A13" : "0x2A0808", 400, false, cat)
}

UToggleAct(fn, label, was, *) {
    fn.Call()
    UNotify(label, was ? "Disabled" : "Enabled", !was, "toggle")
}

; the bind functions wait for the key themselves: when they return the new key is set
UKeyAct(starter, label, box, *) {
    starter.Call()
    k := box.Text
    UNotify(label, k = "NONE" ? "Unbound" : "Bound to " k, k != "NONE", "key")
}

UDrawDD() {
    global UDD, UW, UH, UAlpha, UHover, F_Sm, F_IconSm, UAnimating
    if (!IsObject(UDD))
        return
    d := UDD
    t := ULerp("ddx", d.open ? 1 : 0, 0.3)
    if (!d.open && t <= 0.01) {
        UDD := 0
        return
    }
    UAnimating := true
    items := d.list.items
    n := items.Length, rowH := 30
    vis := Max(1, Min(n, 7))
    fullH := vis * rowH + 8
    x := d.ax, w := d.aw, y := d.ay + 34
    if (y + fullH > UH - 10)
        y := d.ay - 6 - fullH
    UAlpha := Min(1.0, t * 1.4)
    yo := (1 - t) * -6
    UClip(x - 8, y - 4 + yo, w + 16, fullH * t + 12)
    URR(x - 2, y + 4 + yo, w + 4, fullH, 12, UC(0, 0, 0, 70))
    URR(x, y + yo, w, fullH, 11, UCol("Card"))
    URR(x, y + yo, w, fullH, 11, UCol("Hover", 120))
    URRLine(x, y + yo, w, fullH, 11, UCol("Border"))
    maxS := Max(0, (n - vis) * rowH)
    d.scroll := Max(0, Min(maxS, d.scroll))
    UClip(x, y + 3 + yo, w, Max(0, fullH * t - 6))
    if (n = 0)
        UText("nothing here yet", x + 14, y + 4 + yo, UCol("Muted"), F_Sm, w - 28, rowH, 0, 1)
    Loop n {
        i := A_Index
        iy := y + 4 + (i - 1) * rowH - d.scroll + yo
        if (iy + rowH < y || iy > y + fullH)
            continue
        sel := (d.list.Value = i)
        hv := ULerp("ddh" i, (UHover = "ddi" i) ? 1 : 0, 0.25)
        URR(x + 4, iy, w - 8, rowH - 2, 8, UCol("Hover", Round(255 * Max(sel ? 0.8 : 0, hv))))
        tx := x + 14
        if (d.list = AccentDDL) {
            p := AccentPresets[i]
            a1 := UHexArr(p.a), a2 := UHexArr(p.b)
            UGradFill(x + 14, iy + 8, 26, 12, 6, [a1, a2])
            tx := x + 50
        } else if (d.list = LogoGradDDL || d.list = HudGradDDL) {
            UGradFill(x + 14, iy + 8, 26, 12, 6, GradStops(i))
            tx := x + 50
        }
        UText(items[i], tx, iy, sel ? UAccMix("Text", 0.85) : UCol("Text"), F_Sm, w - (tx - x) - 26, rowH - 2, 0, 1)
        if (sel)
            UText(Chr(0xE73E), x + w - 28, iy, UAcc(), F_IconSm, 16, rowH - 2, 1, 1)
    }
    UClipReset()
    UAlpha := 1.0
    if (d.open && t > 0.9) {
        UHit("ddbg", 0, 0, UW, UH, UCloseDD)
        Loop n {
            iy := y + 4 + (A_Index - 1) * rowH - d.scroll
            if (iy < y + 2 || iy + rowH > y + fullH)
                continue
            UHit("ddi" A_Index, x + 4, iy, w - 8, rowH - 2, UPickDD.Bind(A_Index))
        }
    }
}

; ==============================================================================
;  RENDER
; ==============================================================================

URender() {
    pc := A_IsCritical
    Critical
    try URenderInner()
    finally Critical(pc ? "On" : "Off")
}

URenderInner() {
    global UG, US, UW, UH, USide, UTop, UAnimating, UHits, UHitsB, UAlpha, UFrameK, UFrameAt
    global UWinT, UWinTarget, UWinHide, UPageT, UScroll, UScrollT, UContentH, UHwnd, UHover, UScrollDrag
    global CurrentTab, CurrentSubTab, F_H, F_Sm, F_Icon, F_IconSm, UBgBmp
    now := A_TickCount
    dt := now - UFrameAt
    UFrameK := (dt > 120 || dt <= 0) ? 1.0 : Max(0.5, Min(3.0, dt / 16.67))
    UFrameAt := now
    UCacheTrim()
    UAnimating := false
    UHitsB := []
    UAlpha := 1.0

    ; open / close: fade and a small zoom
    UWinT := ULerp("win", UWinTarget, UWinTarget ? 0.2 : 0.28)
    if (UWinHide && UWinT <= 0.02) {
        UHideNow()
        return
    }
    UPageT := ULerp("page", 1, 0.14)
    UScroll += (UScrollT - UScroll) * (1 - (1 - 0.25) ** UFrameK)
    if (Abs(UScrollT - UScroll) < 0.5)
        UScroll := UScrollT
    else
        UAnimating := true

    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    k := 0.955 + 0.045 * UEase(UWinT)
    if (k < 0.999) {
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", UW / 2, "Float", UH / 2 + (1 - UWinT) * 10, "Int", 0)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -UW / 2, "Float", -UH / 2, "Int", 0)
    }

    UBuildBg()
    DllCall("gdiplus\GdipDrawImageRectI", "Ptr", UG, "Ptr", UBgBmp, "Int", 0, "Int", 0, "Int", UW, "Int", UH)

    UDrawSidebar()
    UDrawTopBar()

    ; page content (scrolls; slides up a little and fades in when the page changes)
    viewTop := UTop - 6, viewBot := UH - 14
    UClip(USide + 1, viewTop, UW - USide - 2, viewBot - viewTop)
    UAlpha := UPageT
    yOff := UTop - UScroll + 14 * (1 - UEase(UPageT))
    bottom := UDrawPage(yOff)
    UContentH := bottom - yOff + 6
    UAlpha := 1.0
    UClipReset()

    ; scrollbar
    viewH := viewBot - UTop
    if (UContentH > viewH) {
        maxS := UContentH - viewH
        if (UScrollT > maxS)
            UScrollT := maxS
        th := Max(34, viewH * viewH / UContentH)
        ty := UTop + (viewH - th) * (UScroll / maxS)
        hot := (UHover = "vs" || IsObject(UScrollDrag))
        URR(UW - 12, UTop, 4, viewH, 2, UCol("Track", 120))
        UGradFill(UW - (hot ? 13 : 12), ty, hot ? 6 : 4, th, 3, GradStops(1), 0, hot ? 1 : 0.75)
        UHit("vs", UW - 20, UTop, 18, viewH, "vscroll", {top: UTop, trackH: viewH, thumbH: th, max: maxS})
    } else if (UScrollT > 0) {
        UScrollT := 0
    }

    UDrawDD()
    UHits := UHitsB
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    ULayered(UHwnd, US.dc, UW, UH, Round(255 * UEase(UWinT)))
}

; window background with the colour grading: drawn once into a picture, again only when the colours change
UBuildBg() {
    global UBgBmp, UBgG, UBgKey, UG, UW, UH, USide, GradeAmt, AccentColor, AccentColor2, UAlpha
    key := AccentColor "|" AccentColor2 "|" GradeAmt
    if (UBgBmp && key = UBgKey)
        return
    if (!UBgBmp) {
        bmp := 0, g := 0
        DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", UW, "Int", UH, "Int", 0, "Int", 0xE200B, "Ptr", 0, "Ptr*", &bmp)
        DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", &g)
        DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", g, "Int", 4)
        UBgBmp := bmp, UBgG := g
    }
    UBgKey := key
    prevG := UG, prevA := UAlpha
    UG := UBgG, UAlpha := 1.0
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UBgG, "UInt", 0)
    k := GradeAmt / 100
    a1 := UHexArr(AccentColor), a2 := UHexArr(AccentColor2)
    rgb1 := (a1[1] << 16) | (a1[2] << 8) | a1[3], rgb2 := (a2[1] << 16) | (a2[2] << 8) | a2[3]

    URR(0, 0, UW, UH, 18, UCol("Win"))
    DllCall("gdiplus\GdipSetClipPath", "Ptr", UBgG, "Ptr", UPath(0, 0, UW, UH, 18), "Int", 0)
    URR(0, 0, USide, UH, 0, UCol("Side"))
    ; diagonal grade: accent from the top left, second accent from the bottom right
    cols := Buffer(16), pos := Buffer(16)
    NumPut("UInt", (Round(46 * k) << 24) | rgb1, cols, 0), NumPut("UInt", rgb1, cols, 4)
    NumPut("UInt", rgb2, cols, 8), NumPut("UInt", (Round(34 * k) << 24) | rgb2, cols, 12)
    NumPut("Float", 0, pos, 0), NumPut("Float", 0.46, pos, 4), NumPut("Float", 0.58, pos, 8), NumPut("Float", 1, pos, 12)
    p1 := Buffer(8), p2 := Buffer(8)
    NumPut("Float", 0, p1, 0), NumPut("Float", 0, p1, 4), NumPut("Float", UW, p2, 0), NumPut("Float", UH, p2, 4)
    br := 0
    DllCall("gdiplus\GdipCreateLineBrush", "Ptr", p1, "Ptr", p2, "UInt", 0, "UInt", 0, "Int", 0, "Ptr*", &br)
    DllCall("gdiplus\GdipSetLinePresetBlend", "Ptr", br, "Ptr", cols, "Ptr", pos, "Int", 4)
    DllCall("gdiplus\GdipFillRectangle", "Ptr", UBgG, "Ptr", br, "Float", 0, "Float", 0, "Float", UW, "Float", UH)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
    ; soft light pools
    UGlow(USide + 150, -30, 380, 230, rgb1, Round(52 * k))
    UGlow(UW + 10, UH + 30, 330, 230, rgb2, Round(40 * k))
    UGlow(70, 40, 190, 130, rgb1, Round(44 * k))
    DllCall("gdiplus\GdipResetClip", "Ptr", UBgG)
    ; edges
    ULine(USide + 0.5, 22, USide + 0.5, UH - 22, UCol("Border"))
    URRLine(0, 0, UW, UH, 18, UCol("Border"))
    UGradFill(60, 0.6, UW - 120, 1.3, 0, GradStops(1), 0, 0.25 + 0.6 * k)
    UG := prevG, UAlpha := prevA
}

; ---------- sidebar ----------
UDrawSidebar() {
    global USide, UH, CurrentTab, CurrentSubTab, UHover, F_Tiny, F_Sm, F_B, F_UI, F_IconSm, IsMacrosLocked
    UDrawLogo(24, 22)
    ; small edition pill
    URR(26, 60, 96, 20, 10, UCol("Pill", 220))
    URRLine(26, 60, 96, 20, 10, UCol("Border"))
    UDisc(37, 70, 3, UAcc())
    UText("TSB EDITION", 45, 60, UCol("Text2"), F_Tiny, 80, 20, 0, 1)

    y := 104
    UText("MAIN", 28, y, UCol("Muted"), F_Tiny, 120, 18, 0, 1)
    y += 22
    y := UNavItem(1, Chr(0xE945), "Macros", y)
    ; the macro sub pages open under "Macros"
    mo := ULerp("macx", CurrentTab = 1 ? 1 : 0, 0.18)
    if (mo > 0.01) {
        subs := ["Extenders", "Backdash", "Movement"]
        UClip(0, y - 2, USide, (subs.Length * 30 + 6) * mo + 2)
        UAlpha := mo
        ULine(38, y, 38, y + (subs.Length * 30 - 4) * mo, UCol("Border"))
        for i, nm in subs {
            iy := y + (i - 1) * 30 * mo
            sel := (CurrentSubTab = i)
            st := ULerp("sub" i, sel ? 1 : 0, 0.2)
            hv := ULerp("subh" i, UHover = "sub" i ? 1 : 0, 0.25)
            URR(50, iy, USide - 64, 26, 8, UCol("Hover", Round(200 * Max(st * 0.9, hv * 0.6))))
            if (st > 0.02)
                UDisc(38, iy + 13, 3.5 * st, UAcc())
            UText(nm, 62, iy, sel ? UCol("Text") : UMix("Muted", "Text2", hv), F_Sm, 120, 26, 0, 1)
            if (mo > 0.9)
                UHit("sub" i, 50, iy, USide - 64, 26, UGoSub.Bind(i))
        }
        UAlpha := 1.0
        UClipReset()
        y += (subs.Length * 30 + 6) * mo
    }
    y := UNavItem(2, Chr(0xEA86), "Misc", y)
    y += 10
    UText("SETUP", 28, y, UCol("Muted"), F_Tiny, 120, 18, 0, 1)
    y += 22
    y := UNavItem(3, Chr(0xE765), "Keybinds", y)
    y := UNavItem(4, Chr(0xE790), "Visuals", y)
    y := UNavItem(5, Chr(0xE713), "Settings", y)
    y := UNavItem(6, Chr(0xE946), "Info", y)

    ; profile card
    fy := UH - 66
    URR(14, fy, USide - 28, 52, 14, UCol("Card", 200))
    URRLine(14, fy, USide - 28, 52, 14, UCol("Border"))
    UGradFill(26, fy + 10, 32, 32, 16, GradStops(LogoGrad), A_TickCount / 1000 * 0.2, 1.0, 64)
    UDisc(42, fy + 26, 13.5, UCol("Card"))
    UText(StrUpper(SubStr(A_UserName, 1, 1)), 26, fy + 10, UCol("Text"), F_B, 32, 32, 1, 1)
    UText(A_UserName, 68, fy + 8, UCol("Text"), F_B, USide - 96, 20, 0, 1)
    armed := UArmedCount()
    if (IsMacrosLocked) {
        UDisc(72, fy + 35, 3, UCol("Red"))
        UText("macros locked", 80, fy + 26, UCol("Red"), F_Sm, 120, 18, 0, 1)
    } else {
        UDisc(72, fy + 35, 3, armed ? UCol("Green") : UCol("Muted"))
        UText(armed " macro" (armed = 1 ? "" : "s") " armed", 80, fy + 26, UCol("Text2"), F_Sm, 120, 18, 0, 1)
    }
}

UArmedCount() {
    n := 0
    for v in [IsExtender1Checked, IsExtender2Checked, IsExtender3Checked, IsExtender4Checked, IsJumpBugChecked, IsLagSwitchChecked]
        n += v ? 1 : 0
    return n
}

UNavItem(n, icon, label, y) {
    global CurrentTab, UHover, USide, F_UI, F_B, F_Icon
    id := "tab" n
    t := ULerp(id, CurrentTab = n ? 1 : 0, 0.2)
    hv := ULerp(id "h", UHover = id ? 1 : 0, 0.25)
    w := USide - 28
    URR(14, y, w, 36, 11, UCol("Hover", Round(170 * hv * (1 - t))))
    if (t > 0.01) {
        URR(14, y, w, 36, 11, UCol("Hover", Round(255 * t)))
        UGradFill(14, y, w * (0.35 + 0.65 * t), 36, 11, [UHexArr(AccentColor), UPal("Hover")], 0, 0.30 * t, w * 2)
        UGradFill(14, y + 9, 3, 18, 1.5, GradStops(1), 0, t)
    }
    UText(icon, 26, y, UMix("Muted", "Text", Max(t, hv * 0.6)), F_Icon, 22, 36, 1, 1)
    if (t > 0.02)
        UText(icon, 26, y, UAcc(Round(255 * t)), F_Icon, 22, 36, 1, 1)
    UText(label, 58, y, UMix("Text2", "Text", Max(t, hv)), t > 0.5 ? F_B : F_UI, 130, 36, 0, 1)
    UHit(id, 14, y, w, 36, UGoTab.Bind(n))
    return y + 40
}

UGoTab(n, *) {
    global CurrentTab, UPageT, UScroll, UScrollT
    if (CurrentTab = n)
        return
    CurrentTab := n
    UPageT := 0.0, UScroll := 0, UScrollT := 0
    UAnimSet("page", 0)
    UCloseDD()
}

UGoSub(i, *) {
    global CurrentSubTab, UScroll, UScrollT
    if (CurrentSubTab = i)
        return
    CurrentSubTab := i
    UScroll := 0, UScrollT := 0
    UAnimSet("page", 0)
}

UAnimSet(id, v) {
    global UAnim
    UAnim[id] := v
}

; the brand: the letters of DESTINY filled from the chosen (moving) gradient
UDrawLogo(x, y) {
    global F_Logo, LogoGrad, LogoAnimated
    txt := "DESTINY", n := StrLen(txt)
    st := GradStops(LogoGrad)
    sh := LogoAnimated ? A_TickCount / 1000 * 0.22 : 0
    cx := x
    Loop n {
        ch := SubStr(txt, A_Index, 1)
        c := GradSample(st, (A_Index - 1) / n * 0.85 - sh)
        UText(ch, cx, y + 2, UC(c[1], c[2], c[3], 55), F_Logo, 40, 34, 0, 1)
        UText(ch, cx, y, UC(c[1], c[2], c[3]), F_Logo, 40, 34, 0, 1)
        cx += UTextW(ch ch, F_Logo) - UTextW(ch, F_Logo) + 1.2
    }
    return cx
}

; ---------- top bar ----------
UDrawTopBar() {
    global CurrentTab, CurrentSubTab, USide, UW, UHover, F_H, F_Sm, F_IconSm, IsMacrosLocked
    titles := ["Macros", "Misc", "Keybinds", "Visuals", "Settings", "Info"]
    subs := ["Combat tech for The Strongest Battlegrounds", "Lagswitch and freeze options", "Bind your macros and the system keys"
        , "HUD, notifications and colour grading", "Configs and camera sensitivity", "About Destiny"]
    x := USide + 28
    UText(titles[CurrentTab], x, 22, UCol("Text"), F_H, 300, 32, 0, 1)
    tw := UTextW(titles[CurrentTab], F_H)
    if (CurrentTab = 1) {
        nm := ["Extenders", "Backdash", "Movement"][CurrentSubTab]
        cw := UTextW(nm, F_Sm) + 22
        URR(x + tw + 4, 28, cw, 22, 11, UAcc(34))
        URRLine(x + tw + 4, 28, cw, 22, 11, UAcc(90))
        UText(nm, x + tw + 4, 28, UAccMix("Text", 0.75), F_Sm, cw, 22, 1, 1)
    }
    UText(subs[CurrentTab], x, 54, UCol("Muted"), F_Sm, 420, 18, 0, 1)

    ; lock chip, minimise, close
    if (IsMacrosLocked) {
        URR(UW - 192, 28, 92, 24, 12, UC(240, 88, 96, 36))
        UText("LOCKED", UW - 192, 28, UCol("Red"), F_Sm, 92, 24, 1, 1)
    }
    for b in [["min", Chr(0xE921), UW - 88], ["close", Chr(0xE8BB), UW - 52]] {
        hv := ULerp(b[1], UHover = b[1] ? 1 : 0, 0.25)
        red := (b[1] = "close")
        URR(b[3], 24, 32, 32, 10, red ? UC(240, 88, 96, Round(200 * hv)) : UCol("Hover", Round(255 * hv)))
        UText(b[2], b[3], 24, red ? UMix("Text2", "Text", hv) : UMix("Muted", "Text", hv), F_IconSm, 32, 32, 1, 1)
        UHit(b[1], b[3], 24, 32, 32, red ? CloseApp : MinimizeApp)
    }
