;  HUD OVERLAY & NOTIFICATIONS


UpdateSidebarIndicators() {
    global HudDots, ShowSidebarIndicators, AccentColor, BlinkTimers
    global isExtender1Running, isExtender2Running, isExtender3Running, isExtender4Running, isLagRunning
    if (!ShowSidebarIndicators)
        return
    states := [isExtender1Running, isExtender2Running, isExtender3Running, isExtender4Running, isLagRunning]
    Loop 5 {
        i := A_Index
        dot := HudDots[i]
        if (states[i]) {
            dot.Opt("Background" AccentColor " cFFFFFF")
        } else {
            if BlinkTimers.Has(i) {
                SetTimer(BlinkTimers[i], 0)
                BlinkTimers.Delete(i)
            }
            dot.Opt("Background" C_ChildBg " c" C_TextDim)
        }
        dot.Redraw()
    }
}

ToggleSidebarIndicators(*) {
    global ShowSidebarIndicators, ChkHudShow, IndicatorHud, HudOpacity
    ShowSidebarIndicators := !ShowSidebarIndicators
    SetCheck(ChkHudShow, ShowSidebarIndicators)
    if (ShowSidebarIndicators) {
        pos := GetHudShowStr()
        IndicatorHud.Show("x" pos.x " y" pos.y " NoActivate")
        WinSetTransparent(HudOpacity, IndicatorHud)
        UpdateSidebarIndicators()
    } else {
        IndicatorHud.Hide()
    }
}

ToggleStatusNotifs(*) {
    global ShowStatusNotifs, ChkNotifShow
    ShowStatusNotifs := !ShowStatusNotifs
    SetCheck(ChkNotifShow, ShowStatusNotifs)
}

BlinkIndicator(dotIndex) {
    global HudDots, ShowSidebarIndicators, AccentColor, BlinkTimers
    if (!ShowSidebarIndicators || dotIndex < 1 || dotIndex > 5)
        return
    if BlinkTimers.Has(dotIndex)
        SetTimer(BlinkTimers[dotIndex], 0)
    dot := HudDots[dotIndex]
    state := {count: 0}
    bf := BlinkStep.Bind(dotIndex, state, dot)
    BlinkTimers[dotIndex] := bf
    SetTimer(bf, 80)
}

BlinkStep(dotIndex, state, dot) {
    global AccentColor, BlinkTimers
    state.count++
    if (state.count > 5) {
        if BlinkTimers.Has(dotIndex)
            SetTimer(BlinkTimers[dotIndex], 0)
        BlinkTimers.Delete(dotIndex)
        dot.Opt("Background" C_ChildBg " c" C_TextDim)
        dot.Redraw()
        return
    }
    dot.Opt(Mod(state.count, 2) = 1 ? "BackgroundFFFFFF c000000" : "Background" AccentColor " cFFFFFF")
    dot.Redraw()
}

GetHudShowStr() {
    global HudPosition
    hudW := 80
    hudH := 6 * 28 + 8
    sw := A_ScreenWidth
    sh := A_ScreenHeight
    switch HudPosition {
        case "Top-Left":     return {x: 10, y: 80}
        case "Top-Right":    return {x: sw - hudW - 10, y: 80}
        case "Bottom-Left":  return {x: 10, y: sh - hudH - 20}
        case "Bottom-Right": return {x: sw - hudW - 10, y: sh - hudH - 20}
        default:             return {x: 10, y: 80}
    }
}

KeepHudOnTop() {
    global IndicatorHud, ShowSidebarIndicators
    if (!ShowSidebarIndicators)
        return
    try {
        WinSetAlwaysOnTop(1, "ahk_id " IndicatorHud.Hwnd)
        if (!WinExist("ahk_id " IndicatorHud.Hwnd) || !DllCall("IsWindowVisible", "Ptr", IndicatorHud.Hwnd)) {
            pos := GetHudShowStr()
            IndicatorHud.Show("x" pos.x " y" pos.y " NoActivate")
        }
    }
}

UpdateHudPosition(*) {
    global HudPosition, HudPosDDL, IndicatorHud, ShowSidebarIndicators
    HudPosition := HudPosDDL.Text
    if (ShowSidebarIndicators) {
        pos := GetHudShowStr()
        IndicatorHud.Show("x" pos.x " y" pos.y " NoActivate")
    }
}

ShowStatus(text, colorHex, xPos, force := false) {
    global AccentColor, ShowStatusNotifs
    if (!ShowStatusNotifs && !force)
        return
    static activeGuis := Map()
    if (activeGuis.Has(xPos) && activeGuis[xPos]) {
        activeGuis[xPos].Destroy()
    }
    
    statusGui := Gui("+AlwaysOnTop -Caption +ToolWindow")
    statusGui.BackColor := colorHex
    statusGui.SetFont("s9 Bold", "Consolas")
    statusGui.Add("Text", "c0xFFFFFF w140 Center", text)
    
    screenHeight := A_ScreenHeight
    statusGui.Show("x" xPos " y" (screenHeight - 80) " NoActivate")
    activeGuis[xPos] := statusGui
    SetTimer(() => (statusGui ? statusGui.Destroy() : ""), -1200)
}


;  RAW MOUSE INPUT REGISTRATION


RegisterRawMouseInput() {
    global RawInputRegistered, MainGui
    if (RawInputRegistered)
        return
    ridSize := 8 + A_PtrSize
    rid := Buffer(ridSize, 0)
    NumPut("UShort", 0x01, rid, 0)
    NumPut("UShort", 0x02, rid, 2)
    NumPut("UInt", 0x00000100, rid, 4) ; RIDEV_INPUTSINK
    NumPut("Ptr", MainGui.Hwnd, rid, 8)
    if DllCall("RegisterRawInputDevices", "Ptr", rid, "UInt", 1, "UInt", ridSize)
        RawInputRegistered := true
}


