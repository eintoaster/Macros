; --- Backdash 1-4: skill + S + Q down together, skill up right away, S + Q held ~100 ms, then up.
; The backdash key itself also goes through to the game (~). BDPing ("Ping timing"): S + Q come that many ms after
; the skill - with a very low ping the backdash sometimes did not take, with a higher ping it did.
ExecuteBackdash(n, *) {
    global BDRunning, IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked
    if (![IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked][n] || BDRunning[n] || !WinActive(GAME_EXE))
        return
    global BDPing
    BDRunning[n] := true
    if (BDPing <= 0) {
        Send("{" n " down}{s down}{q down}")
        Send("{" n " up}")
    } else {
        t0 := QMs()
        Send("{" n " down}")
        Send("{" n " up}")
        while (QMs() - t0 < BDPing)                           ; (performance counter: exact to the millisecond)
            DllCall("Sleep", "UInt", (BDPing - (QMs() - t0)) > 2 ? 1 : 0)
        Send("{s down}{q down}")
    }
    Sleep(100)
    Send("{s up}{q up}")
    BDRunning[n] := false
    SetTimer(ShowStatus.Bind("BACKDASH " n, "0x082A13", 300), -1)
    SetTimer(HudFlash.Bind("bd" n), -1)
}

