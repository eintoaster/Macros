; Stacks the sidebar rows; the selected tab expands to show its sub-tabs.
LayoutNav() {
    global TabRows, Tabs, CurrentTab, CurrentSubTab, NavW
    y := 42
    for idx, r in TabRows {
        sel := (idx = CurrentTab)
        r.row.Move(0, y)
        r.icon.Move(15, y)
        r.name.Move(40, y)
        r.icon.Opt("c" (sel ? C_Text : C_TextDim))
        r.name.Opt("c" (sel ? C_Text : C_TextDim))
        r.name.SetFont(sel ? "Bold" : "Norm")
        if (r.chev) {
            r.chev.Move(NavW - 30, y)
            r.chev.Text := sel ? Chr(0xE70D) : Chr(0xE76C)
        }
        y += 38
        for sIdx, s in r.subs {
            if (sel) {
                s.Move(40, y + 2 + (sIdx - 1) * 26)
                s.Opt("c" (sIdx = CurrentSubTab ? C_Accent : C_TextDim))
                s.Visible := true
                s.Redraw()
            } else {
                s.Visible := false
            }
        }
        if (sel && r.subs.Length)
            y += r.subs.Length * 26 + 6
        r.sep.Move(40, y)
        y += 1
        for c in [r.row, r.icon, r.name, r.sep]
            c.Redraw()
        if (r.chev)
            r.chev.Redraw()
    }
}

UpdateHeader() {
    global Tabs, CurrentTab, CurrentSubTab, HdrIcon, HdrName, HdrArrow, HdrSub, MainX
    t := Tabs[CurrentTab]
    HdrIcon.Text := t.icon
    HdrName.Text := t.name
    nameW := MeasureText(t.name, "s10 Bold", UI_Font)
    HdrName.Move(, , nameW + 4)
    if (t.subs.Length) {
        HdrName.Opt("c" C_TextDim)
        HdrArrow.Move(MainX + 40 + nameW + 8, 0)
        HdrSub.Move(MainX + 40 + nameW + 26, 0)
        HdrSub.Text := t.subs[CurrentSubTab]
        HdrArrow.Visible := true
        HdrSub.Visible := true
    } else {
        HdrName.Opt("c" C_Text)
        HdrArrow.Visible := false
        HdrSub.Visible := false
    }
    HdrName.Redraw()
}

SwitchTab(tabIndex, *) {
    global CurrentTab, PageControls, SubTabControls
    CurrentTab := tabIndex
    for i, ctrls in PageControls {
        for c in ctrls
            c.Visible := (i = tabIndex)
    }
    if (tabIndex = 1) {
        SwitchSubTab(CurrentSubTab)
        return
    }
    for ctrls in SubTabControls {
        for c in ctrls
            c.Visible := false
    }
    LayoutNav()
    UpdateHeader()
}

SwitchSubTab(subIndex, *) {
    global CurrentSubTab, SubTabControls
    CurrentSubTab := subIndex
    for i, ctrls in SubTabControls {
        for c in ctrls
            c.Visible := (i = subIndex)
    }
    LayoutNav()
    UpdateHeader()
}


