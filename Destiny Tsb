;  UI WIDGET HELPERS


Track(ctrl) {
    global BuildList
    BuildList.Push(ctrl)
    return ctrl
}

QueueRound(ctrl, r, mode := "all") {
    global RoundQueue
    RoundQueue.Push({ctrl: ctrl, r: r, mode: mode})
}

; Clips a control to a rounded shape. mode: all | top | bottom | ellipse
RoundCtrl(ctrl, r, mode := "all") {
    rc := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", ctrl.Hwnd, "Ptr", rc)
    w := NumGet(rc, 8, "Int"), h := NumGet(rc, 12, "Int")
    r := Round(r * A_ScreenDPI / 96)
    if (mode = "ellipse") {
        rgn := DllCall("CreateEllipticRgn", "Int", 0, "Int", 0, "Int", w + 1, "Int", h + 1, "Ptr")
    } else {
        y1 := (mode = "bottom") ? -r * 2 : 0
        y2 := (mode = "top") ? h + r * 2 : h + 1
        rgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", y1, "Int", w + 1, "Int", y2, "Int", r * 2, "Int", r * 2, "Ptr")
    }
    DllCall("SetWindowRgn", "Ptr", ctrl.Hwnd, "Ptr", rgn, "Int", true)
}

SetColor(ctrl, hex) {
    ctrl.Opt("c" hex)
    ctrl.Redraw()
}

; Card with a header strip (ui::begin_child). Returns the content origin.
Card(x, y, w, h, title) {
    bg := Track(MainGui.Add("Text", "x" x " y" y " w" w " h" h " Background" C_ChildBg))
    QueueRound(bg, 4)
    hd := Track(MainGui.Add("Text", "x" x " y" y " w" w " h33 Background" C_Header))
    QueueRound(hd, 4, "top")
    Track(MainGui.Add("Text", "x" x " y" (y + 33) " w" w " h1 Background" C_Line))
    t := Track(MainGui.Add("Text", "x" (x + 13) " y" y " w" (w - 26) " h33 +0x200 Background" C_Header " c" C_Text, title))
    t.SetFont("s9 Bold", UI_Font)
    return {x: x + 13, y: y + 49, w: w - 26}
}

Label(x, y, w, text, color := "", fontOpts := "s9", h := 18, fontName := "") {
    color := color = "" ? C_Text : color
    c := Track(MainGui.Add("Text", "x" x " y" y " w" w " h" h " Background" C_ChildBg " c" color, text))
    c.SetFont(fontOpts, fontName = "" ? UI_Font : fontName)
    return c
}

