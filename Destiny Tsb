; --- Macro 1: Instant Lethal ---
ExecuteExtender1(*) {
    global isExtender1Running, RobloxSensitivity, BaseSensitivity
    if (!IsExtender1Checked || isExtender1Running || !WinActive(GAME_EXE))
        return
    isExtender1Running := true
    ShowStatus("INSTANT LETHAL", "0x082A13", 100)
    BlinkIndicator(1)
    
    ; Sensitivity scaling (OREO Instant Lethal)
    a2 := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    b2 := (BaseSensitivity > 0) ? BaseSensitivity : 0.8
    f1_2 := 0
    g1_2 := 1360
    
    ; Straight dash
    Send("{Space down}")
    Sleep(10)
    Send("{q down}")
    Sleep(10)
    Send("{q up}")
    Send("{Space up}")
    Sleep(15)
    
    j1 := Round(f1_2 * (b2 / a2))
    if (j1 != 0)
        DllCall("mouse_event", "UInt", 0x0001, "Int", j1, "Int", 0, "UInt", 0, "UPtr", 0)
        
    Sleep(150)
    
    l1 := Round(g1_2 * (b2 / a2))
    DllCall("mouse_event", "UInt", 0x0001, "Int", l1, "Int", 0, "UInt", 0, "UPtr", 0)
    
    isExtender1Running := false
}

; --- Macro 2: Instant Twisted ---
ExecuteExtender2(*) {
    global isExtender2Running, RobloxSensitivity
    if (!IsExtender2Checked || isExtender2Running || !WinActive(GAME_EXE))
        return
    isExtender2Running := true
    ShowStatus("INSTANT TWISTED", "0x082A13", 200)
    BlinkIndicator(2)
    
    ; Universal sensitivity scaling (Twisted Macro)
    V2 := 900
    V3 := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    V4 := 90
    V5 := 110
    V6 := 10
    
    pxR :=  Round((V4 * V2) / (360 * V3))
    pxL := -Round((V5 * V2) / (360 * V3))
    
    DllCall("mouse_event", "UInt", 0x0001, "Int", pxR, "Int", 0, "UInt", 0, "UPtr", 0)
    Sleep(V6)
    Send("{q down}")
    Sleep(80)
    Send("{q up}")
    Sleep(V6)
    DllCall("mouse_event", "UInt", 0x0001, "Int", pxL, "Int", 0, "UInt", 0, "UPtr", 0)
    
    isExtender2Running := false
}

; --- Macro 3: Solitude Dash (Fast Left Arc + Right Torso Lock) ---
ExecuteExtender3(*) {
    global isExtender3Running, RobloxSensitivity
    if (!IsExtender3Checked || isExtender3Running || !WinActive(GAME_EXE))
        return
    isExtender3Running := true
    
    sens := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    baseSens := 0.36
    
    ; Faster timings & tighter right landing
    postQDelay    := 95     ; Faster forward launch before curve (ms)
    flick         := 1200   ; Total left sweep magnitude (px)
    flickSteps    := 14     ; Smooth sub-steps
    flickStepDelay:= 7      ; Faster step delay (ms) -> ~98ms curve duration
    correction    := 260    ; Stronger RIGHT snap to close the gap onto dummy torso (px)
    corrDelay     := 4      ; Immediate snap delay (ms)
    
    ; === 1. Q tap ===
    SendInput("{q down}")
    DllCall("Sleep", "UInt", 5)
    SendInput("{q up}")
    
    ; === 2. Forward flight ===
    DllCall("Sleep", "UInt", postQDelay)
    
    ; === 3. Fast LEFT arc ===
    scaledFlick := Round(flick * (baseSens / sens))
    perStep     := Round(scaledFlick / flickSteps)
    Loop flickSteps {
        DllCall("mouse_event", "UInt", 0x01, "Int", -perStep, "Int", 0, "UInt", 0, "UPtr", 0)
        DllCall("Sleep", "UInt", flickStepDelay)
    }
    
    ; === 4. Strong RIGHT snap — locks tight onto torso ===
    DllCall("Sleep", "UInt", corrDelay)
    scaledCorr := Round(correction * (baseSens / sens))
    DllCall("mouse_event", "UInt", 0x01, "Int", scaledCorr, "Int", 0, "UInt", 0, "UPtr", 0)
    
    SetTimer(() => ShowStatus("SOLITUDE DASH", "0x082A13", 300), -1)
    SetTimer(() => BlinkIndicator(3), -1)
    
    isExtender3Running := false
}

; --- Macro 4: Dripz Tech (Dripz Perfect Dash) ---
ExecuteExtender4(*) {
    global isExtender4Running, RobloxSensitivity, BaseSensitivity
    if (!IsExtender4Checked || isExtender4Running || !WinActive(GAME_EXE))
        return
    isExtender4Running := true
    SetTimer(() => ShowStatus("DRIPZ TECH", "0x082A13", 250), -1)
    SetTimer(() => BlinkIndicator(4), -1)
    
    a2 := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    b2 := (BaseSensitivity > 0) ? BaseSensitivity : 0.8
    postQDelay := 160
    flick := 1260
    flickSteps := 12
    flickStepDelay := 6
    correction := 120
    correctionDelay := 4
    
    ; === 1. Tap Q right away - dash fires FORWARD (no uppercut / M1 / jump first) ===
    SendInput("{q down}")
    DllCall("Sleep", "UInt", 5)
    SendInput("{q up}")
    
    ; === 2. Fly short distance (dripz tight timing) ===
    DllCall("Sleep", "UInt", postQDelay)
    
    ; === 3. Continuous Smooth Orbital Curve ===
    scaledFlick := Round(flick * (b2 / a2))
    perStep := Round(scaledFlick / flickSteps)
    
    Loop flickSteps {
        DllCall("mouse_event", "UInt", 0x01, "Int", perStep, "Int", 0, "UInt", 0, "UPtr", 0)
        DllCall("Sleep", "UInt", flickStepDelay)
    }
    
    ; === 4. Micro Landing Alignment ===
    if (correction != 0) {
        DllCall("Sleep", "UInt", correctionDelay)
        scaledCorr := Round(correction * (b2 / a2))
        DllCall("mouse_event", "UInt", 0x01, "Int", scaledCorr, "Int", 0, "UInt", 0, "UPtr", 0)
    }
    
    isExtender4Running := false
}

