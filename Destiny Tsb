; the sub pages under a tab: they slide open while the tab is selected
USubList(tab, subs, sel, prefix, animKey, goFn, y) {
    global CurrentTab, USide, UHover, UAlpha, F_Sm
    mo := ULerp(animKey, CurrentTab = tab ? 1 : 0, 0.18)
    if (mo <= 0.01)
        return y
    UClip(0, y - 2, USide, (subs.Length * 30 + 6) * mo + 2)
    UAlpha := mo
    ULine(38, y, 38, y + (subs.Length * 30 - 4) * mo, UCol("Border"))
    for i, nm in subs {
        iy := y + (i - 1) * 30 * mo
        st := ULerp(prefix i, sel = i ? 1 : 0, 0.2)
        hv := ULerp(prefix "h" i, UHover = prefix i ? 1 : 0, 0.25)
        URR(50, iy, USide - 64, 26, 8, UCol("Hover", Round(200 * Max(st * 0.9, hv * 0.6))))
        if (st > 0.02)
            UDisc(38, iy + 13, 3.5 * st, UAcc())
        UText(nm, 62, iy, sel = i ? UCol("Text") : UMix("Muted", "Text2", hv), F_Sm, 140, 26, 0, 1)
        if (mo > 0.9)
            UHit(prefix i, 50, iy, USide - 64, 26, goFn.Bind(i))
    }
    UAlpha := 1.0
    UClipReset()
    return y + (subs.Length * 30 + 6) * mo
}

UGoMiscSub(i, *) {
    global MiscSub, UScroll, UScrollT
    if (MiscSub = i)
