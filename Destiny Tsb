;  DYNAMIC HOTKEY BINDING ENGINE (KEYBOARD & MOUSE)


; Macro keys are only active while Roblox is the active window. HotIfWinActive is checked by the keyboard / mouse
; hook itself; the old function conditions (HotIf(Ext1Cond) ...) made every press of a bound key or button wait for the
; script's main thread, which is busy while a macro runs (DllCall Sleep) or the HUD draws: that was the input delay.
; A macro that is switched off has its key turned off, so the key reaches the game untouched.
RegisterHotkeys() {
    global curExtender1Key, curExtender2Key, curExtender3Key, curExtender4Key, curJumpBugKey, curLagKey
    global IsExtender1Checked, IsExtender2Checked, IsExtender3Checked, IsExtender4Checked, IsJumpBugChecked, IsLagSwitchChecked
    MacroKey(curExtender1Key, ExecuteExtender1, IsExtender1Checked)
    MacroKey(curExtender2Key, ExecuteExtender2, IsExtender2Checked)
    MacroKey(curExtender3Key, ExecuteExtender3, IsExtender3Checked)
    MacroKey(curExtender4Key, ExecuteExtender4, IsExtender4Checked)
    MacroKey(curJumpBugKey, ExecuteJumpBug, IsJumpBugChecked)
    MacroKey(curLagKey, ExecuteLagswitch, IsLagSwitchChecked, "~")
}

MacroKey(key, fn, on, prefix := "") {
    if (key = "" || key = "LButton")                         ; (left click is never a macro key: it is your M1)
        return
    HotIfWinActive(GAME_EXE)
    try Hotkey(prefix "*" key, fn, on ? "On" : "Off")
    HotIf()
}



InputKeyOrMouse() {
    ; Complete list of keys including mouse buttons
    MouseList := ["XButton1", "XButton2", "MButton", "RButton"]     ; (no LButton: left click is your M1, never a macro key)
    KeyList   := ["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z",
                  "1","2","3","4","5","6","7","8","9","0","Space","Tab","Enter","Shift","Ctrl","Alt","CapsLock",
                  "F1","F2","F3","F4","F5","F6","F7","F8","F9","F10","F11","F12",
                  "Numpad0","Numpad1","Numpad2","Numpad3","Numpad4","Numpad5","Numpad6","Numpad7","Numpad8","Numpad9"]
    
    ; Wait until LButton is fully released from the initial click
    while GetKeyState("LButton", "P")
        Sleep(10)
    
    Loop {
        Sleep(10)
        if GetKeyState("Escape", "P") {
            KeyWait("Escape")
            return "Escape"
        }
        ; Check mouse buttons first
        for m in MouseList {
            if GetKeyState(m, "P") {
                KeyWait(m)
                if (m = "LButton" && UMouseOverMenu())       ; a click on the menu itself is not a bind: keep listening
                    continue
                return m
            }
        }
        ; Check keyboard keys
        for k in KeyList {
            if GetKeyState(k, "P") {
                KeyWait(k)
                return k
            }
        }
    }
}

FormatKeyName(key) {
    if (key == "")
        return "NONE"
    if (key = "XButton1")
        return "Mouse 4 (Side 1)"
    if (key = "XButton2")
        return "Mouse 5 (Side 2)"
    if (key = "MButton")
        return "Mid Mouse"
    if (key = "LButton")
        return "Left Mouse"
    if (key = "RButton")
        return "Right Mouse"
    return StrUpper(key)
}

