; ---------- drawing ----------

; the recorded camera turn as a small animated graph: the curve draws itself in, a flowing gradient line with a
; glow and a soft fill, a playhead that runs along it at the real replay speed, and a pulsing Q marker
URecGraph(rec) {
    global UCX, UCY, UCW, F_Sm, F_Tiny, UAnim, URecLive
    URecLive := true                                          ; (keeps the page redrawing while it is open)
    x := UCX + 18, w := UCW - 36, y := UCY + 4, gh := 92
    now := A_TickCount
    URR(x, y, w, gh, 10, UCol("Pill"))
    Loop 3                                                    ; faint grid
        ULine(x + 10, y + gh * A_Index / 4, x + w - 10, y + gh * A_Index / 4, UCol("Border", 70))
    URRLine(x, y, w, gh, 10, UCol("Border"))
    span := Max(1, rec.t1 - rec.t0), pk := Max(10, rec.peak)
    if (rec.land)
        pk := Max(pk, Abs(SolLandDeg(rec)))
    px(t) => x + 10 + (t - rec.t0) / span * (w - 20)
    py(d) => y + gh / 2 - d / pk * (gh / 2 - 12)
    zy := y + gh / 2
    ULine(x + 8, zy, x + w - 8, zy, UCol("Border"))
    if (rec.land) {
        ld := SolLandDeg(rec)
        ULine(x + 10, py(ld), x + w - 10, py(ld), UCol("Green", 120))
    }
    ; the curve draws itself in when the page opens
    key := "rg" rec.file
    if (!UAnim.Has(key))
        UAnim[key] := 0.0
    prog := ULerp(key, 1, 0.05)
    pts := []
    for c in rec.curve
        pts.Push([px(c[1]), py(c[2])])
    n := Max(2, Min(pts.Length, Round(pts.Length * UEase(prog))))
    stops := GradStops(1), shift := now / 1000 * 0.15
    UGraphArea(pts, n, zy, x, w, stops, shift)
    UGraphLine(pts, n, x, w, stops, shift, 7, 0.22)           ; glow
    UGraphLine(pts, n, x, w, stops, shift, 2.4, 1.0)          ; line
    ; Q marker
    qx := px(0), pulse := 0.5 + 0.5 * Sin(now / 380)
    ULine(qx, y + 6, qx, y + gh - 6, UAcc(Round(90 + 110 * pulse)))
    UDisc(qx, y + 8, 3 + 1.5 * pulse, UAcc(Round(160 + 95 * pulse)))
    UText("Q", qx + 5, y + 2, UAcc(), F_Tiny, 20, 14, 0, 1)
    ; playhead: runs along the curve at the real replay speed (the Speed slider), then waits a moment
    if (prog > 0.98) {
        runMs := span * 100 / rec.speed
        tt := Mod(now, Round(runMs + 650))
        if (tt <= runMs) {
            t := rec.t0 + tt * rec.speed / 100
            i := Floor((t - rec.t0) / 10) + 1, f := ((t - rec.t0) - (i - 1) * 10) / 10
            i := Max(1, Min(rec.curve.Length - 1, i))
            v := rec.curve[i][2] + (rec.curve[i + 1][2] - rec.curve[i][2]) * Max(0, Min(1, f))
            hx := px(t), hy := py(v)
            ULine(hx, y + 6, hx, y + gh - 6, UC(255, 255, 255, 36))
            UDisc(hx, hy, 10, UAcc(40))
            UDisc(hx, hy, 6, UAcc(110))
            UDisc(hx, hy, 3.4, UC(255, 255, 255))
        }
    }
    UText("right", x + w - 46, y + 4, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    UText("left", x + w - 46, y + gh - 18, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    UCY += gh + 8
    land := ""
    if (rec.land) {
        turns := Round(rec.totalDeg / 360)
        land := "  ->  ends " (turns = 0 ? "back on start" : Abs(turns) " full turn" (Abs(turns) > 1 ? "s" : "")) (rec.fine ? " " (rec.fine > 0 ? "+" : "") rec.fine " deg" : "")
    }
    UText(rec.summary land, x, UCY, UCol("Text2"), F_Sm, w, 18, 0, 1)
    UCY += 26
}

; a polyline of the first n points as a GDI+ path
UGraphPath(pts, n) {
    buf := Buffer(8 * n)
    Loop n
        NumPut("Float", pts[A_Index][1], buf, (A_Index - 1) * 8), NumPut("Float", pts[A_Index][2], buf, (A_Index - 1) * 8 + 4)
    path := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", &path)
    DllCall("gdiplus\GdipAddPathLine2", "Ptr", path, "Ptr", buf, "Int", n)
    return path
}

; the curve stroked with the flowing gradient (round joins and ends)
UGraphLine(pts, n, x, w, stops, shift, wd, alpha) {
    global UG
    path := UGraphPath(pts, n)
    br := UGradBrush(x, 0, w, 0, stops, shift, alpha)
    pen := 0
    DllCall("gdiplus\GdipCreatePen2", "Ptr", br, "Float", wd, "Int", 2, "Ptr*", &pen)
    DllCall("gdiplus\GdipSetPenLineJoin", "Ptr", pen, "Int", 2)
    DllCall("gdiplus\GdipSetPenStartCap", "Ptr", pen, "Int", 2)
    DllCall("gdiplus\GdipSetPenEndCap", "Ptr", pen, "Int", 2)
    DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", pen, "Ptr", path)
    DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
    DllCall("gdiplus\GdipDeletePath", "Ptr", path)
}

; the soft fill between the curve and the centre line
UGraphArea(pts, n, zy, x, w, stops, shift) {
    global UG
    poly := [[pts[1][1], zy]]
    Loop n
        poly.Push(pts[A_Index])
    poly.Push([pts[n][1], zy])
    path := UGraphPath(poly, poly.Length)
    DllCall("gdiplus\GdipClosePathFigure", "Ptr", path)
    br := UGradBrush(x, 0, w, 0, stops, shift, 0.13)
    DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", path)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
    DllCall("gdiplus\GdipDeletePath", "Ptr", path)
}

