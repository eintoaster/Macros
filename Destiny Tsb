SaveProfileInternal(configName) {
    global ConfigDir, ConfigExt
    global IsExtender1Checked, IsExtender2Checked, IsExtender3Checked, IsExtender4Checked, IsLagSwitchChecked
    global IsBD1Checked, IsBD2Checked, IsBD3Checked, IsJumpBugChecked
    global FreezeDuration, RobloxSensitivity
