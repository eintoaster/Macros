RecRename(rec, newName) {
    global UPatternDir, SolRecs
    newName := Trim(RegExReplace(newName, '[\\/:*?"<>|]'))
    if (newName = "" || newName = rec.name)
        return
    for r in SolRecs {
        if (r != rec && r.name = newName) {
            UNotify("Rename", newName " already exists", false, "system")
            return
        }
    }
    RecFlush()
    dest := UPatternDir "\" newName ".txt"
    try FileMove(rec.file, dest)
    catch {
        UNotify("Rename", "could not rename", false, "system")
        return
    }
    old := rec.name
    rec.name := newName, rec.file := dest
    UNotify(old, "renamed to " newName, true, "system")
}

RecDelete(rec, *) {
    global RecMsg
    MacroKeyOff(rec.key)
    try FileDelete(rec.file)
    RecMsg := "Deleted " rec.name "."
    RecLoadAll()
}

