; the accent is saved by name; older configs saved its number in the old list (Ember first)
UAccentFind(v) {
    global AccentPresets
    if (IsNumber(v)) {
        old := ["Ember", "Crimson", "Violet", "Ocean", "Mint", "Gold", "Cosmic"]
        v := old[Max(1, Min(old.Length, Integer(v)))]
    }
    for i, p in AccentPresets
        if (p.name = v)
            return i
    return 1
}

UPickAccent(i) {
