RecBindKey(rec, *) {
    KeyWait("LButton")
    old := rec.key
    rec.box.Text := "[ Press Key... ]"
    Hotkey("~*Escape", CancelBind, "On")
    key := InputKeyOrMouse()
    try Hotkey("~*Escape", CancelBind, "Off")
