    global ReloadKey, MinimizeKey, MacroLockKey, ExitKey
    global ShowSidebarIndicators, ShowStatusNotifs, HudPosition, HudOpacity
    
    EnsureConfigDir()
    cfg := {
        macros: {
            ext1: IsExtender1Checked,
            ext2: IsExtender2Checked,
            ext3: IsExtender3Checked,
            ext4: IsExtender4Checked,
            bd1: IsBD1Checked,
            bd2: IsBD2Checked,
            bd3: IsBD3Checked,
            jump_bug: IsJumpBugChecked,
            lagswitch: IsLagSwitchChecked
        },
        timings: {
            freeze_dur: FreezeDuration,
            roblox_sens: RobloxSensitivity
        },
        keybinds: {
            ext1_key: Extender1Key,
            ext2_key: Extender2Key,
            ext3_key: Extender3Key,
            ext4_key: Extender4Key,
            jump_bug_key: JumpBugKey,
            lag_key: LagKey
        },
        system: {
            reload_key: ReloadKey,
            minimize_key: MinimizeKey,
