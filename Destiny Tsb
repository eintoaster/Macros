UArmedCount() {
    global SolRecs
    n := 0
    for v in [IsExtender1Checked, IsExtender2Checked, IsExtender4Checked, IsJumpBugChecked, IsLagSwitchChecked
        , IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked]
        n += v ? 1 : 0
    for rec in SolRecs
        n += rec.enabled ? 1 : 0
    return n
}

