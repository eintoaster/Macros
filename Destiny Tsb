    EnsureConfigDir()
    cfg := {
        macros: {
            ext1: IsExtender1Checked,
            ext2: IsExtender2Checked,
            ext3: IsExtender3Checked,
            ext4: IsExtender4Checked,
            bd1: IsBD1Checked,
            bd2: IsBD2Checked,
            bd3: IsBD3Checked,
