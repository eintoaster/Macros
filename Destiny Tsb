UPal(key) {
    static P := Map("Win", [15, 15, 18], "Side", [11, 11, 13], "Card", [22, 22, 26], "Hover", [31, 31, 37]
        , "Border", [37, 37, 44], "Text", [243, 243, 246], "Text2", [168, 168, 180], "Muted", [108, 108, 120]
        , "Off", [50, 50, 58], "Track", [38, 38, 46], "Pill", [28, 28, 33], "Red", [240, 88, 96], "Green", [52, 211, 153])
    return P[key]
}

UHexArr(hex) => [Integer("0x" SubStr(hex, 1, 2)), Integer("0x" SubStr(hex, 3, 2)), Integer("0x" SubStr(hex, 5, 2))]

UC(r, g, b, a := 255) {
    global UAlpha
    return (Max(0, Min(255, Round(a * UAlpha))) << 24) | (r << 16) | (g << 8) | b
}
UCol(key, a := 255) {
    c := UPal(key)
    return UC(c[1], c[2], c[3], a)
}
UMix(k1, k2, t, a := 255) {
    c1 := UPal(k1), c2 := UPal(k2)
    return UC(Round(c1[1] + (c2[1] - c1[1]) * t), Round(c1[2] + (c2[2] - c1[2]) * t), Round(c1[3] + (c2[3] - c1[3]) * t), a)
}
UAcc(a := 255) {
    c := UHexArr(AccentColor)
    return UC(c[1], c[2], c[3], a)
}
UAcc2(a := 255) {
    c := UHexArr(AccentColor2)
    return UC(c[1], c[2], c[3], a)
}
; a palette colour blended toward the accent
UAccMix(key, t, a := 255) {
    c := UPal(key), ac := UHexArr(AccentColor)
    return UC(Round(c[1] + (ac[1] - c[1]) * t), Round(c[2] + (ac[2] - c[2]) * t), Round(c[3] + (ac[3] - c[3]) * t), a)
}

; colour stops of the gradient presets (they loop: the last stop runs back into the first)
GradStops(idx) {
    switch idx {
        case 2: return [[16, 185, 129], [34, 211, 238], [99, 102, 241], [168, 85, 247]]
        case 3: return [[251, 146, 60], [244, 63, 94], [168, 85, 247]]
        case 4: return [[34, 211, 238], [59, 130, 246], [20, 184, 166]]
        case 5: return [[250, 204, 21], [249, 115, 22], [239, 68, 68]]
        case 6: return [[239, 68, 68], [250, 204, 21], [74, 222, 128], [34, 211, 238], [99, 102, 241], [217, 70, 239]]
        case 7: return [[244, 114, 182], [125, 211, 252], [134, 239, 172]]
        case 8: return [UPal("Text"), UPal("Muted")]
        default: return [UHexArr(AccentColor), UHexArr(AccentColor2)]
    }
}

GradSample(st, pos) {
    m := st.Length
    pos := pos - Floor(pos)
    q := pos * m, k := Floor(q), fr := q - k
    c1 := st[Mod(k, m) + 1], c2 := st[Mod(k + 1, m) + 1]
    return [Round(c1[1] + (c2[1] - c1[1]) * fr), Round(c1[2] + (c2[2] - c1[2]) * fr), Round(c1[3] + (c2[3] - c1[3]) * fr)]
}

