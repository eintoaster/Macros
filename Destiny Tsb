; look settings that belong to this PC, not to a config
USavePrefs() {
    SetTimer(USavePrefsNow, -400)
}

USavePrefsNow() {
    global UPrefsFile, HudCustom, HudCX, HudCY, UX, UY, Widgets
    ; (ui.ini only keeps where the menu and the HUD sit on this screen; every look setting is saved with the configs)
    try {
        f := UPrefsFile
        IniWrite(HudCustom ? 1 : 0, f, "hud", "custom")
        IniWrite(HudCX, f, "hud", "x")
        IniWrite(HudCY, f, "hud", "y")
        IniWrite(UX, f, "menu", "x")
        IniWrite(UY, f, "menu", "y")
        for id, wd in Widgets {
            IniWrite(wd.custom ? 1 : 0, f, "widgets", id "custom")
            IniWrite(wd.x, f, "widgets", id "x")
            IniWrite(wd.y, f, "widgets", id "y")
        }
    }
}

ULoadPrefs() {
    global UPrefsFile, HudCustom, HudCX, HudCY, UX, UY, Widgets
    f := UPrefsFile
    if (FileExist(f)) {
        try {
            HudCustom := IniRead(f, "hud", "custom", 0) = "1"
            HudCX := Integer(IniRead(f, "hud", "x", 10))
            HudCY := Integer(IniRead(f, "hud", "y", 80))
            UX := Integer(IniRead(f, "menu", "x", UX))
            UY := Integer(IniRead(f, "menu", "y", UY))
            for id, wd in Widgets {
                wd.custom := IniRead(f, "widgets", id "custom", 0) = "1"
                wd.x := Integer(IniRead(f, "widgets", id "x", 0))
                wd.y := Integer(IniRead(f, "widgets", id "y", 0))
            }
        }
    }
    UVisualsFrom({})                                          ; the look starts with the defaults; a loaded config sets it
}

; every Visuals setting (and the record length) for a config
UVisualsTo() {
    global
    nc := {}
    for c, on in NotifCats
        nc.%c% := on ? 1 : 0
    return {hud_show: ShowSidebarIndicators ? 1 : 0, hud_compact: HudCompact ? 1 : 0, hud_keys: HudShowKeys ? 1 : 0
        , hud_pos: HudPosition, hud_border: HudBorder, hud_grad: HudGrad, hud_size: HudScale, hud_opacity: HudOpacity
        , notifs: ShowStatusNotifs ? 1 : 0, notify: nc, accent: AccentPresets[AccentIdx].name, logo_grad: LogoGrad, logo_anim: LogoAnimated ? 1 : 0
        , grade: GradeAmt, vignette: IsLagVignette ? 1 : 0, vignette_px: VignetteThickness, rec_len: RecLen
        , widgets: WStyleTo()}
}

; sets the Visuals from a config's "visuals" part (anything missing = the default)
UVisualsFrom(v) {
    global
    g(name, def) => v.HasOwnProp(name) ? v.%name% : def
    ShowSidebarIndicators := g("hud_show", 1) ? true : false
    HudCompact := g("hud_compact", 0) ? true : false
    HudShowKeys := g("hud_keys", 1) ? true : false
    HudPosition := g("hud_pos", "Top-Left")
    if (!(HudPosition = "Top-Left" || HudPosition = "Top-Right" || HudPosition = "Bottom-Left" || HudPosition = "Bottom-Right"))
        HudPosition := "Top-Left"
    HudBorder := Max(1, Min(4, Integer(g("hud_border", 3))))
    HudGrad := Max(1, Min(GradNames.Length, Integer(g("hud_grad", 1))))
    HudScale := Max(50, Min(150, Integer(g("hud_size", 80))))
    HudOpacity := Max(26, Min(255, Integer(g("hud_opacity", 220))))
    ShowStatusNotifs := g("notifs", 1) ? true : false
    nc := g("notify", {})
    for c, def in Map("toggle", true, "fire", false, "slider", false, "pick", false, "key", false, "system", true)
        NotifCats[c] := (IsObject(nc) && nc.HasOwnProp(c)) ? (nc.%c% ? true : false) : def
    AccentIdx := UAccentFind(g("accent", "Cosmic"))
    AccentColor := AccentPresets[AccentIdx].a, AccentColor2 := AccentPresets[AccentIdx].b, DestinyAccent := AccentColor
    LogoGrad := Max(1, Min(GradNames.Length, Integer(g("logo_grad", 1))))
    LogoAnimated := g("logo_anim", 1) ? true : false
    GradeAmt := Max(0, Min(100, Integer(g("grade", 60))))
    IsLagVignette := g("vignette", 1) ? true : false
    VignetteThickness := Max(2, Min(30, Integer(g("vignette_px", 8))))
    RecLen := Max(400, Min(1500, Integer(g("rec_len", 900))))
    WStyleFrom(g("widgets", {}))
    AccentDDL.idx := AccentIdx, LogoGradDDL.idx := LogoGrad, HudGradDDL.idx := HudGrad, HudBorderDDL.idx := HudBorder
    HudPosDDL.Text := HudPosition
}

; after a config was loaded / reset: show the new look everywhere
UVisualsApply() {
    global ShowSidebarIndicators, HudVisible, HudLeaveAt
    DestroyVignette()
    WApply()
    if (ShowSidebarIndicators && (!HudVisible || HudLeaveAt))
        HudOn()
    else if (!ShowSidebarIndicators && HudVisible)
        HudOff()
    HudPlace()
    HudRequest()
    UReq()
}

; ==============================================================================
;  MACRO HUD  (click-through card; can be dragged while the menu is open)
; ==============================================================================

Global HudGui := "", HudS := 0, HudVisible := false, HudW := 200, HudMaxH := 460, HudH := 120, HudScale := 80

; HUD size on screen (the card is drawn at 100 % and scaled, so it stays sharp)
HudPx(v) => Round(v * HudScale / 100)
Global HudRowT := Map(), HudFlashAt := Map(), HudTimerOn := false, HudBusy := false
Global HudShowAt := 0, HudLeaveAt := 0, HudMoving := false, HudDragOff := 0, HudClickThru := true

HudEnsure() {
    global HudGui, HudS, HudW, HudMaxH
    if (IsObject(HudGui))
        return
    UGdipInit()
    HudGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny HUD")
    HudS := UMakeSurface(Ceil(HudW * 1.5), Ceil(HudMaxH * 1.5))
}

HudXY(h) {
    global HudPosition, HudCustom, HudCX, HudCY, HudW
    h := HudPx(h)
    w := HudPx(HudW)
    if (HudCustom)
        return {x: HudCX, y: HudCY}
    switch HudPosition {
        case "Top-Right":    return {x: A_ScreenWidth - w - 10, y: 80}
        case "Bottom-Left":  return {x: 10, y: A_ScreenHeight - h - 60}
        case "Bottom-Right": return {x: A_ScreenWidth - w - 10, y: A_ScreenHeight - h - 60}
        default:             return {x: 10, y: 80}
    }
}

HudPlace() {
    global HudGui, HudVisible, HudH, HudW
    if (!HudVisible || !IsObject(HudGui))
        return
    p := HudXY(HudH)
    HudGui.Move(p.x, p.y, HudPx(HudW), HudPx(HudH))
}

HudOn() {
    global HudGui, HudVisible, HudShowAt, HudLeaveAt, HudH, HudW
    HudEnsure()
    HudVisible := true, HudShowAt := A_TickCount, HudLeaveAt := 0
    p := HudXY(HudH)
    HudGui.Show("x" p.x " y" p.y " w" HudPx(HudW) " h" HudPx(HudH) " NA")
    HudKick()
    SetTimer(HudDragTick, 20)
}

HudOff() {
    global HudVisible, HudLeaveAt
    if (HudVisible && !HudLeaveAt) {
        HudLeaveAt := A_TickCount
        HudKick()
    }
}

; called whenever something the HUD shows changes
HudRequest() {
    global HudVisible
    if (HudVisible)
        HudKick()
}

HudFlash(i) {
    global HudFlashAt
    HudFlashAt[i] := A_TickCount
    HudRequest()
}

; the HUD flashes a row when its macro fires
BlinkIndicator(i) {
    static ids := Map(1, "ext1", 2, "ext2", 4, "ext4", 5, "jb", 6, "lag")
    if (ids.Has(i))
        HudFlash(ids[i])
}

HudKick() {
    global HudTimerOn
    if (!HudTimerOn) {
        HudTimerOn := true
        SetTimer(HudTick, 33)
    }
}

HudTick() {
    global HudVisible, HudBusy, HudTimerOn
    if (!HudVisible) {
        SetTimer(HudTick, 0)
        HudTimerOn := false
        return
    }
    HudRender()
    if (!HudBusy) {
        SetTimer(HudTick, 0)
        HudTimerOn := false
    }
}

HudRender() {
    global RecState
    if (RecState != "idle")
        return
    pc := A_IsCritical
    Critical
    try HudRenderInner()
    finally Critical(pc ? "On" : "Off")
}

HudRenderInner() {
    global HudGui, HudS, HudVisible, HudW, HudMaxH, HudH, HudRowT, HudFlashAt, HudBusy, HudShowAt, HudLeaveAt, HudMoving
    global HudOpacity, HudCompact, HudShowKeys, HudBorder, HudGrad, UG, UAlpha, F_B, F_Sm, F_UI, F_Tiny, IsMacrosLocked
    global Extender1Key, Extender2Key, Extender4Key, JumpBugKey, LagKey, MacroLockKey, SolRecs, BDKeys
    global IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked
    if (!HudVisible || !IsObject(HudGui))
        return
    now := A_TickCount
    busy := false
    ; appear / leave
    ap := 1.0
    if (HudLeaveAt) {
        t := (now - HudLeaveAt) / 240
        if (t >= 1) {
            HudVisible := false, HudLeaveAt := 0
            SetTimer(HudDragTick, 0)
            HudGui.Hide()
            return
        }
        ap := (1 - t) ** 2, busy := true
    } else if (now - HudShowAt < 420) {
        ap := UEase((now - HudShowAt) / 420), busy := true
    }
    ; rows: the built-in macros, every recorded dash, the macro lock
    rows := [["ext1", "Lethal", IsExtender1Checked, Extender1Key], ["ext2", "Twisted", IsExtender2Checked, Extender2Key]
        , ["ext4", "Dripz", IsExtender4Checked, Extender4Key], ["jb", "Jump Bug", IsJumpBugChecked, JumpBugKey]
        , ["lag", "Lagswitch", IsLagSwitchChecked, LagKey]]
    Loop 4
        rows.Push(["bd" A_Index, "Backdash " A_Index, [IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked][A_Index], BDKeys[A_Index]])
    for rec in SolRecs
        rows.Push(["rec:" rec.name, rec.name, rec.enabled && !IsMacrosLocked, rec.key])
    rows.Push(["lock", "Macro Lock", IsMacrosLocked, MacroLockKey])
    ; row animations and the card height
    cy := 46, any := false, ev := []
    for i, r in rows {
        id := r[1]
        on := r[3] ? 1 : 0
        any := any || (on && id != "lock")
        t := HudRowT.Get(id, on)
        t += (on - t) * 0.3
        if (Abs(on - t) < 0.02)
            t := on
        else
            busy := true
        HudRowT[id] := t
        vis := HudCompact ? Max(on, 0) : 1
        e := HudRowT.Get("v" id, vis)
        e += (vis - e) * 0.3
        if (Abs(vis - e) < 0.02)
            e := vis
        else
            busy := true
        HudRowT["v" id] := e
        ev.Push(e)
        cy += 28 * e
    }
    idle := HudCompact && !any && !IsMacrosLocked
    ia := HudRowT.Get("idle", idle ? 1 : 0)
    ia += ((idle ? 1 : 0) - ia) * 0.3
    if (Abs((idle ? 1 : 0) - ia) < 0.02)
        ia := idle ? 1 : 0
    else
        busy := true
    HudRowT["idle"] := ia
    cy += 28 * ia
    H := Max(56, Min(HudMaxH, Round(cy + 10)))
    static lastScale := 0
    if (H != HudH || HudScale != lastScale) {
        HudH := H, lastScale := HudScale
        if (!HudMoving) {
            p := HudXY(H)
            HudGui.Move(p.x, p.y, HudPx(HudW), HudPx(H))
        } else
            HudGui.Move(, , HudPx(HudW), HudPx(H))
    }

    prevG := UG, prevA := UAlpha
    UG := HudS.g
    base := Max(0.15, HudOpacity / 255)
    UAlpha := base * ap
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    sc := HudScale / 100
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", sc, "Float", sc, "Int", 0)
    if (ap < 1) {                                            ; grows from 88 % while it fades in
        k := 0.88 + 0.12 * ap
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", HudW / 2, "Float", H / 2, "Int", 0)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -HudW / 2, "Float", -H / 2, "Int", 0)
    }
    gst := GradStops(HudGrad)
    URR(2, 5, HudW - 4, H - 6, 16, UC(0, 0, 0, 60))
    URR(3, 3, HudW - 6, H - 7, 15, UCol("Card"))
    URR(3, 3, HudW - 6, H - 7, 15, UCol("Win", 120))
    UGradFill(3, 3, HudW - 6, 40, 15, [UHexArr(AccentColor), UPal("Card")], 0, 0.12, (HudW - 6) * 2)
    bs := HudMoving ? 4 : HudBorder
    if (bs = 1)
        URRLine(3, 3, HudW - 6, H - 7, 15, UCol("Border"))
    else if (bs = 2)
        URRLine(3, 3, HudW - 6, H - 7, 15, UAcc(200))
    else {
        URRLine(3, 3, HudW - 6, H - 7, 15, UCol("Border", 120))
        UGradBorder(3, 3, HudW - 6, H - 7, 15, bs = 4 ? GradStops(6) : gst, now / 1000 * 0.3, 1.8)
    }
    ; header: brand + enabled count
    st := gst, sh := now / 1000 * 0.22
    cx := 16
    Loop 7 {
        ch := SubStr("DESTINY", A_Index, 1)
        c := GradSample(st, (A_Index - 1) / 7 * 0.85 - sh)
        UText(ch, cx, 12, UC(c[1], c[2], c[3]), F_B, 30, 22, 0, 1)
        cx += UTextW(ch ch, F_B) - UTextW(ch, F_B) + 1.5
    }
    armed := UArmedCount()
    cnt := armed "/" UMacroTotal()
    cw := UTextW(cnt, F_Sm) + 16
    URR(HudW - 14 - cw, 13, cw, 20, 10, UCol("Pill"))
    UText(cnt, HudW - 14 - cw, 13, armed ? UAcc() : UCol("Muted"), F_Sm, cw, 20, 1, 1)
    ULine(14, 41, HudW - 14, 41, UCol("Border"))
    live := !isAppMinimized                                  ; (name flow, pulse and moving border only while the menu is open;
    busy := busy || live                                     ;  in game the HUD only redraws when something changes)

    ry := 46
    for i, r in rows {
        id := r[1], lab := r[2]
        e := ev[i]
        if (e < 0.03)
            continue
        UAlpha := base * ap * e
        t := HudRowT[id]
        red := (id = "lock")
        rc := red ? UPal("Red") : GradSample(gst, now / 1000 * 0.12 + i * 0.11)
        col := UC(rc[1], rc[2], rc[3])
        if (t > 0.01)
            URR(10, ry, HudW - 20, 24, 9, UC(rc[1], rc[2], rc[3], Round(34 * t)))
        fa := now - HudFlashAt.Get(id, -99999)
        if (fa < 600) {                                      ; fired: a white flash and a ring from the dot
            f := fa / 600
            URR(10, ry, HudW - 20, 24, 9, UC(255, 255, 255, Round(110 * (1 - f))))
            URing(24, ry + 12, 4 + 14 * UEase(f), UC(rc[1], rc[2], rc[3], Round(220 * (1 - f))), 1.6)
            busy := true
        }
        if (t > 0.5) {
            pulse := 0.5 + 0.5 * Sin(now / 300 + i)
            UDisc(24, ry + 12, 4 + 3 * pulse, UC(rc[1], rc[2], rc[3], 50))
        }
        UDisc(24, ry + 12, 3.6, UCol("Off"))
        if (t > 0.01)
            UDisc(24, ry + 12, 3.6, UC(rc[1], rc[2], rc[3], Round(255 * t)))
        UText(lab, 38, ry, t > 0.5 ? UCol("Text") : UCol("Text2", 170), F_UI, HudShowKeys ? 96 : 110, 24, 0, 1)
        if (HudShowKeys) {
            k := r[4] = "" ? "-" : StrUpper(RegExReplace(FormatKeyName(r[4]), " \(.*\)"))
            UText(k, HudW - 92, ry, t > 0.5 ? UC(rc[1], rc[2], rc[3]) : UCol("Muted"), F_Sm, 78, 24, 2, 1)
        } else if (t > 0.05)
            UText(red ? "LOCKED" : "ON", HudW - 74, ry, UC(rc[1], rc[2], rc[3], Round(255 * t)), F_Sm, 60, 24, 2, 1)
        ry += 28 * e
    }
    if (ia > 0.03) {
        UAlpha := base * ap * ia
        UText("nothing enabled", 14, ry, UCol("Muted"), F_Sm, HudW - 28, 24, 1, 1)
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    UG := prevG, UAlpha := prevA
    HudBusy := busy
    ULayered(HudGui.Hwnd, HudS.dc, HudPx(HudW), HudPx(H))
}

; the HUD can be picked up with the mouse while the menu is open; otherwise it is click-through
HudDragTick() {
    global HudGui, HudVisible, HudMoving, HudClickThru, HudDragOff, HudCX, HudCY, HudCustom, HudW, HudH, isAppMinimized
    static wasDown := false
    if (!HudVisible || !IsObject(HudGui))
        return
    menuOpen := !isAppMinimized
    if (menuOpen = HudClickThru) {
        HudClickThru := !menuOpen
        try WinSetExStyle(menuOpen ? "-0x20" : "+0x20", "ahk_id " HudGui.Hwnd)
    }
    if (!menuOpen) {
        HudMoving := false, wasDown := false
        return
    }
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    mx := NumGet(pt, 0, "Int"), my := NumGet(pt, 4, "Int")
    down := (DllCall("GetAsyncKeyState", "Int", 1, "Short") & 0x8000) != 0
    if (HudMoving) {
        if (down) {
            HudGui.Move(Max(0, Min(A_ScreenWidth - HudPx(HudW), mx - HudDragOff.x)), Max(0, Min(A_ScreenHeight - HudPx(HudH), my - HudDragOff.y)))
        } else {
            HudMoving := false
            HudGui.GetPos(&gx, &gy)
            HudCX := gx, HudCY := gy, HudCustom := true
            USavePrefs()
        }
        HudRequest()
    } else if (down && !wasDown) {
        HudGui.GetPos(&gx, &gy, &gw, &gh)
        if (mx >= gx && mx < gx + gw && my >= gy && my < gy + gh && DllCall("WindowFromPoint", "Int64", (mx & 0xFFFFFFFF) | (my << 32), "Ptr") = HudGui.Hwnd) {
            HudMoving := true
            HudDragOff := {x: mx - gx, y: my - gy}
            HudRequest()
        }
    }
    wasDown := down
}

