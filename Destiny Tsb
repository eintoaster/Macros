; started by the loader there is no script file to reload: the loader starts the newest version again
TsbReload(*) {
    global M0MLoaderPath, M0MLoaderDir
    if (IsSet(M0MLoaderPath) && M0MLoaderPath != "" && FileExist(M0MLoaderPath)) {
        try {
            Run('"' A_AhkPath '" "' M0MLoaderPath '" /launch', M0MLoaderDir)
            ExitApp
        }
    }
    Reload()
}

RegisterSystemHotkeys() {
    global curReloadKey, curMinimizeKey, curMacroLockKey, curExitKey
    ; no "*": the system keys only fire on their own, so Shift+F5 (Roblox FPS) etc. still reach the game
    if (curReloadKey != "")
        try Hotkey(curReloadKey, TsbReload, "On")
    if (curMinimizeKey != "")
        try Hotkey(curMinimizeKey, (*) => ToggleMainGui(), "On")
    if (curMacroLockKey != "")
        try Hotkey(curMacroLockKey, MacroLockToggle, "On")
    if (curExitKey != "")
        try Hotkey(curExitKey, (*) => ExitApp(), "On")
}

UnregisterSystemHotkeys() {
