; ---------- the polling timer (only while a widget is shown or the Input Monitor page is open) ----------
WKick() {
    global WTimerOn
    if (!WTimerOn) {
        WTimerOn := true
        SetTimer(WTick, 40)
        SetTimer(WDragTick, 20)
    }
}

WTick() {
    global WKeys, WDown, WAnimT, WLastSig, WFade, WTurnAcc, WTurnHist, WQuiet, WTimerOn, WRawWant, Widgets, WIdle, WWheelAt, RobloxSensitivity
    page := WPageOpen()
    if (!WAnyOn() && !page) {
        SetTimer(WTick, 0), SetTimer(WDragTick, 0)
        WTimerOn := false
        if (WRawWant) {
            WRawWant := false
            RawSync()
        }
        return
    }
    want := Widgets["turn"].on || page
    if (want != WRawWant) {
        WRawWant := want
        RawSync()
        WTurnHist := []
    }
    ; keys and buttons: the hook's physical state sees keys a macro swallows, GetAsyncKeyState sees keys a macro sends
    sig := ""
    for k in WKeys {
        d := ((DllCall("GetAsyncKeyState", "Int", k[2], "Short") & 0x8000) || GetKeyState(k[1], "P")) ? 1 : 0
        WDown[k[1]] := d
        sig .= d
        t := WAnimT.Get(k[1], 0)
        t += (d - t) * 0.55
        WAnimT[k[1]] := (Abs(d - t) < 0.02) ? d : t
    }
    if (sig != WLastSig)
        WFade := 10
    WLastSig := sig
    WFade := Max(0, WFade - 1)
    ; camera turn: signed side-to-side raw counts per tick -> degrees per second at the Roblox sens
    sens := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    WTurnHist.Push(WTurnAcc * sens / 2.5 * 25)
    if (WTurnHist.Length > 100)
        WTurnHist.RemoveAt(1)
    WQuiet := (WTurnAcc != 0) ? 0 : WQuiet + 1
    WTurnAcc := 0
    ; redraw only what changed (plus the release animation and the appear / leave animation)
    busyKeys := WFade > 0 || InStr(sig, "1") || WIdle
    now := A_TickCount
    for id, wd in Widgets {
        if (!wd.visible)
            continue
        anim := wd.leaveAt || (now - wd.showAt < 420)
        if (anim || (id = "keys" && busyKeys) || (id = "mbtn" && (busyKeys || now - WWheelAt < 400)) || (id = "turn" && WQuiet <= 104))
            WRender(wd)
    }
}

; ---------- drawing ----------
WRender(wd) {
    pc := A_IsCritical
    Critical
    try WRenderInner(wd)
    finally Critical(pc ? "On" : "Off")
}

WRenderInner(wd) {
    global UG, UAlpha, HudOpacity, RecState
    if (!wd.visible || !IsObject(wd.gui) || RecState != "idle")
        return
    now := A_TickCount
    ap := 1.0
    if (wd.leaveAt) {
        t := (now - wd.leaveAt) / 240
        if (t >= 1) {
            wd.visible := false, wd.leaveAt := 0
            wd.gui.Hide()
            return
        }
        ap := (1 - t) ** 2
    } else if (now - wd.showAt < 420)
        ap := UEase((now - wd.showAt) / 420)
    prevG := UG, prevA := UAlpha
    UG := wd.s.g
    UAlpha := Max(0.15, HudOpacity / 255) * ap
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    sc := wd.scale / 100
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", sc, "Float", sc, "Int", 0)
    if (ap < 1) {                                             ; grows from 88 % while it fades in
        k := 0.88 + 0.12 * ap
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", wd.w / 2, "Float", wd.h / 2, "Int", 0)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
        DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -wd.w / 2, "Float", -wd.h / 2, "Int", 0)
    }
    try WDrawFrame(wd)
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    UG := prevG, UAlpha := prevA
    ULayered(wd.gui.Hwnd, wd.s.dc, WPx(wd, wd.w), WPx(wd, wd.h))
}

; one widget at 0,0 in its design size (the real widget and the menu preview both use this)
WDrawFrame(wd) {
    global WDrag
    W := wd.w, H := wd.h
    if (wd.bg) {
        URR(1, 5, W - 2, H - 6, 16, UC(0, 0, 0, 45))
        URR(3, 3, W - 6, H - 8, 14, UCol("Card"))
        URR(3, 3, W - 6, H - 8, 14, UCol("Win", 120))
    }
    bs := (IsObject(WDrag) && WDrag.wd = wd) ? 4 : wd.bstyle
    if (bs = 2)
        URRLine(3, 3, W - 6, H - 8, 14, UAcc(210))
    else if (bs >= 3)
        UGradBorder(4, 4, W - 8, H - 10, 13, bs = 4 ? GradStops(6) : GradStops(wd.grad), A_TickCount / 1000 * 0.3, 2)
    switch wd.id {
        case "keys": WDrawKeys(wd)
        case "mbtn": WDrawMouse(wd)
        case "turn": WDrawTurn(wd)
    }
}

; a key cap: lifts when pressed, gradient fill and outline, a soft halo; the gradient flows across the keys
WCap(id, label, x, y, w, h, gst) {
    global WAnimT, WIdle, F_B
    t := WAnimT.Get(id, 0)
    sh := A_TickCount / 1000 * 0.4 - x / 140
    yy := y + 3 - 2 * t
    c := GradSample(gst, sh)
    if (t > 0.01) {
        URR(x - 5, yy - 5, w + 10, h + 10, 13, UC(c[1], c[2], c[3], Round(36 * t)))
        URR(x - 2.5, yy - 2.5, w + 5, h + 5, 11, UC(c[1], c[2], c[3], Round(72 * t)))
    }
    URR(x, yy, w, h, 9, UCol("Pill"))
    if (t > 0.03)
        UGradFill(x, yy, w, h, 9, gst, sh, 0.8 * t, 140)
    if (t > 0.3)
        UGradBorder(x, yy, w, h, 9, gst, sh, 2)
    else {
        URRLine(x, yy, w, h, 9, UCol("Border"))
        if (WIdle)
            UGradBorder(x, yy, w, h, 9, gst, sh, 1.4, 0.55)
    }
    UText(label, x, yy, UMix("Text2", "Text", t), F_B, w, h, 1, 1)
}

; 1 2 3 4 / Q W / A S D F G / space bar, staggered like a keyboard
WDrawKeys(wd) {
    gst := GradStops(wd.grad)
    sz := 34, gap := 6
    for i, k in ["1", "2", "3", "4"]
        WCap(k, k, 14 + (i - 1) * (sz + gap), 12, sz, sz, gst)
    for i, k in ["q", "w"]
        WCap(k, StrUpper(k), 22 + (i - 1) * (sz + gap), 52, sz, sz, gst)
    for i, k in ["a", "s", "d", "f", "g"]
        WCap(k, StrUpper(k), 30 + (i - 1) * (sz + gap), 92, sz, sz, gst)
    WCap("Space", "SPACE", 50, 132, 154, 28, gst)
}

; a rounded rectangle with its own radius per corner (top left, top right, bottom right, bottom left)
UPathC(x, y, w, h, tl, tr, br, bl) {
    p := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", &p)
    tl := Max(0.5, tl), tr := Max(0.5, tr), br := Max(0.5, br), bl := Max(0.5, bl)
    f := Min(1, w / (tl + tr), w / (bl + br), h / (tl + bl), h / (tr + br))   ; (corners never overlap)
    tl *= f, tr *= f, br *= f, bl *= f
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x, "Float", y, "Float", tl * 2, "Float", tl * 2, "Float", 180, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x + w - tr * 2, "Float", y, "Float", tr * 2, "Float", tr * 2, "Float", 270, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x + w - br * 2, "Float", y + h - br * 2, "Float", br * 2, "Float", br * 2, "Float", 0, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", p, "Float", x, "Float", y + h - bl * 2, "Float", bl * 2, "Float", bl * 2, "Float", 90, "Float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "Ptr", p)
    return p
}

; one part of the mouse (button / wheel / side button): idle outline, or glow + gradient fill + outline when pressed
WMousePart(id, x, y, w, h, tl, tr, br, bl, gst, ph) {
    global UG, WAnimT, WIdle
    t := WAnimT.Get(id, 0)
    p := UPathC(x, y, w, h, tl, tr, br, bl)
    c := GradSample(gst, A_TickCount / 1000 * 0.4 + ph)
    if (t > 0.01) {
        g := UPathC(x - 3, y - 3, w + 6, h + 6, tl + 3, tr + 3, br + 3, bl + 3)
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", UBrush(UC(c[1], c[2], c[3], Round(60 * t))), "Ptr", g)
        DllCall("gdiplus\GdipDeletePath", "Ptr", g)
        br_ := UGradBrush(x, y, w, h, gst, A_TickCount / 1000 * 0.4 + ph, 0.8 * t)
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br_, "Ptr", p)
        DllCall("gdiplus\GdipDeleteBrush", "Ptr", br_)
    }
    if (t > 0.3 || WIdle) {
        br_ := UGradBrush(x, y, w, h, gst, A_TickCount / 1000 * 0.4 + ph, t > 0.3 ? 1.0 : 0.55)
        pen := 0
        DllCall("gdiplus\GdipCreatePen2", "Ptr", br_, "Float", t > 0.3 ? 2 : 1.6, "Int", 2, "Ptr*", &pen)
        DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", pen, "Ptr", p)
        DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
        DllCall("gdiplus\GdipDeleteBrush", "Ptr", br_)
    } else
        DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", UPen(UCol("Border"), 1), "Ptr", p)
    DllCall("gdiplus\GdipDeletePath", "Ptr", p)
    return t
}

; the mouse: body, left / right buttons, wheel (lights up on middle click and scrolling), M4 / M5 on the side
WDrawMouse(wd) {
    global UG, WWheelAt, WWheelDir, F_Tiny, F_Sm
    gst := GradStops(wd.grad)
    ox := 48, oy := 18
    body := UPathC(ox, oy, 100, 164, 48, 48, 38, 38)
    DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", UBrush(UCol("Pill")), "Ptr", body)
    DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", UPen(UCol("Border"), 1), "Ptr", body)
    DllCall("gdiplus\GdipDeletePath", "Ptr", body)
    WMousePart("LButton", ox + 3, oy + 3, 45, 76, 45, 4, 4, 4, gst, 0)
    WMousePart("RButton", ox + 52, oy + 3, 45, 76, 4, 45, 4, 4, gst, 0.25)
    ULine(ox + 3, oy + 84, ox + 97, oy + 84, UCol("Border"))
    UText("M1", ox + 3, oy + 50, UCol("Muted"), F_Tiny, 45, 20, 1, 1)
    UText("M2", ox + 52, oy + 50, UCol("Muted"), F_Tiny, 45, 20, 1, 1)
    ; wheel
    URR(ox + 42, oy + 20, 16, 34, 8, UCol("Card"))
    WMousePart("MButton", ox + 43, oy + 21, 14, 32, 7, 7, 7, 7, gst, 0.5)
    age := A_TickCount - WWheelAt
    if (age < 320) {
        wt := 1 - age / 320
        c := GradSample(gst, A_TickCount / 1000 * 0.4)
        cy := WWheelDir > 0 ? oy + 13 : oy + 61, d := WWheelDir > 0 ? -1 : 1
        ULine(ox + 44, cy - 3 * d, ox + 50, cy + 3 * d, UC(c[1], c[2], c[3], Round(255 * wt)), 2.2)
        ULine(ox + 56, cy - 3 * d, ox + 50, cy + 3 * d, UC(c[1], c[2], c[3], Round(255 * wt)), 2.2)
    }
    ; side buttons: M5 (front) above M4 (back)
    WMousePart("XButton2", ox - 9, oy + 92, 12, 24, 6, 2, 2, 6, gst, 0.75)
    WMousePart("XButton1", ox - 9, oy + 122, 12, 24, 6, 2, 2, 6, gst, 0.9)
    UText("M5", ox - 40, oy + 92, UCol("Text2"), F_Tiny, 28, 24, 2, 1)
    UText("M4", ox - 40, oy + 122, UCol("Text2"), F_Tiny, 28, 24, 2, 1)
}

; the camera turn: the last 4 s of side-to-side mouse movement in degrees per second (right up, left down)
WDrawTurn(wd) {
    global WTurnHist, F_B, F_Sm, F_Tiny
    W := wd.w, H := wd.h
    gst := GradStops(wd.grad)
    now := A_TickCount
    UText("Camera turn", 16, 10, UCol("Text"), F_B, 160, 22, 0, 1)
    px := 16, py := 40, pw := W - 32, ph := 74
    mid := py + ph / 2
    hist := WTurnHist, n := hist.Length
    hi := 180
    for v in hist
        hi := Max(hi, Abs(v))
    last := n ? hist[n] : 0
    ; live value + which way
    dirTxt := Abs(last) < 20 ? "" : (last > 0 ? Chr(0x2192) " right" : Chr(0x2190) " left")
    c := GradSample(gst, now / 1000 * 0.2)
    UText(Round(Abs(last)) " deg/s", W - 180, 10, Abs(last) < 20 ? UCol("Muted") : UC(c[1], c[2], c[3]), F_Sm, 164, 22, 2, 1)
    if (dirTxt != "")
        UText(dirTxt, W - 180, 26, UCol("Text2"), F_Tiny, 164, 14, 2, 1)
    URR(px, py, pw, ph, 8, UCol("Pill", 160))
    ULine(px + 4, mid, px + pw - 4, mid, UCol("Border"))
    UText("right", px + pw - 44, py + 2, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    UText("left", px + pw - 44, py + ph - 16, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    if (n >= 2) {
        pts := []
        Loop n {
            i := A_Index
            a := hist[Max(1, i - 1)], b := hist[i], cc := hist[Min(n, i + 1)]
            v := (a + b + cc) / 3                             ; (smoothed a little)
            pts.Push([px + pw * (100 - n + i - 1) / 99, mid - v / hi * (ph / 2 - 6)])
        }
        UGraphArea(pts, n, mid, px, pw, gst, now / 1000 * 0.15)
        UGraphLine(pts, n, px, pw, gst, now / 1000 * 0.15, 6, 0.22)
        UGraphLine(pts, n, px, pw, gst, now / 1000 * 0.15, 2.2, 1.0)
        lp := pts[n]
        UDisc(lp[1], lp[2], 5, UC(c[1], c[2], c[3], 60))
        UDisc(lp[1], lp[2], 3, UC(255, 255, 255))
    }
    UText("-4s", px, py + ph + 2, UCol("Muted"), F_Tiny, 40, 14, 0, 1)
    UText("now", px + pw - 40, py + ph + 2, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
}

; ---------- dragging (only while the menu is open; otherwise the widgets let clicks through) ----------
WDragTick() {
    global Widgets, WDrag, isAppMinimized
    static wasDown := false
    menuOpen := !isAppMinimized
    for id, wd in Widgets {
        if (!wd.visible || !IsObject(wd.gui))
            continue
        if (menuOpen = wd.thru) {
            wd.thru := !menuOpen
            try WinSetExStyle(menuOpen ? "-0x20" : "+0x20", "ahk_id " wd.gui.Hwnd)
        }
    }
    if (!menuOpen) {
        WDrag := 0, wasDown := false
        return
    }
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    mx := NumGet(pt, 0, "Int"), my := NumGet(pt, 4, "Int")
    down := (DllCall("GetAsyncKeyState", "Int", 1, "Short") & 0x8000) != 0
    if (IsObject(WDrag)) {
        wd := WDrag.wd
        if (down) {
            wd.gui.Move(Max(0, Min(A_ScreenWidth - WPx(wd, wd.w), mx - WDrag.ox)), Max(0, Min(A_ScreenHeight - WPx(wd, wd.h), my - WDrag.oy)))
        } else {
            wd.gui.GetPos(&gx, &gy)
            wd.x := gx, wd.y := gy, wd.custom := true
            WDrag := 0
            USavePrefs()
        }
        WRender(wd)
    } else if (down && !wasDown) {
        hw := DllCall("WindowFromPoint", "Int64", (mx & 0xFFFFFFFF) | (my << 32), "Ptr")
        for id, wd in Widgets {
            if (wd.visible && IsObject(wd.gui) && hw = wd.gui.Hwnd) {
                wd.gui.GetPos(&gx, &gy)
                WDrag := {wd: wd, ox: mx - gx, oy: my - gy}
                WRender(wd)
                break
            }
        }
    }
    wasDown := down
}

; ---------- settings ----------
WPickSel(i) {
    global WSelId, WIds
    WSelId := WIds[i]
}
WPickBorder(i) {
    wd := WSelWd()
    wd.bstyle := i
    WRedrawAll()
}
WPickGrad(i) {
    wd := WSelWd()
    wd.grad := i
    WRedrawAll()
}
WToggleBg(*) {
    wd := WSelWd()
    wd.bg := !wd.bg
    WRedrawAll()
}
WSetScale(v) {
    wd := WSelWd()
    wd.scale := v
    WPlace(wd)
    WRedrawAll()
}

; ---------- the page (Misc > Input Monitor) ----------
UPageInput(top) {
    global UCY, UCX, UCW, UG, Widgets, WIdle, WSelId, WSelDDL, WBorderDDL, WGradDDL, URecLive
    URecLive := true                                          ; (the preview keeps moving while the page is open)
    WKick()
    UColumn(1, top)
    UCardBegin("c_wid", "Widgets", Chr(0xE7F4))
    UToggleRow("t_wkeys", "Keys", "W A S D, Q, F, G, 1 2 3 4, space", Widgets["keys"].on, WToggle.Bind("keys"))
    UToggleRow("t_wmbtn", "Mouse buttons", "M1, M2, middle, M4, M5", Widgets["mbtn"].on, WToggle.Bind("mbtn"))
    UToggleRow("t_wturn", "Camera turn", "how fast and which way your camera turns", Widgets["turn"].on, WToggle.Bind("turn"))
    UToggleRow("t_widle", "Animate when idle", "", WIdle, WToggleIdle)
    UTextRow("Drag them anywhere while the menu is open.", "", 1)
    UCardEnd()
    wd := WSelWd()
    WSelDDL.idx := (WSelId = "keys") ? 1 : (WSelId = "mbtn") ? 2 : 3
    WBorderDDL.idx := wd.bstyle, WGradDDL.idx := wd.grad
    UCardBegin("c_wset", "Widget Settings", Chr(0xE713))
    UDropRow("d_wsel", "Settings for", WSelDDL)
    UToggleRow("t_wbg", "Background", "", wd.bg, WToggleBg)
    UDropRow("d_wbord", "Border", WBorderDDL)
    UDropRow("d_wgrad", "Gradient", WGradDDL)
    USliderRow("s_wsize", "Size", 60, 160, wd.scale, WSetScale, "{}%")
    UCardEnd()
    b1 := UCY
    UColumn(2, top)
    UCardBegin("c_wprev", "Preview", Chr(0xE890))
    ; the selected widget, drawn by the same code as on screen, scaled into the card
    k := Min(1.0, (UCW - 36) / wd.w)
    x := UCX + 18 + ((UCW - 36) - wd.w * k) / 2, y := UCY + 4
    m := 0
    DllCall("gdiplus\GdipCreateMatrix", "Ptr*", &m)
    DllCall("gdiplus\GdipGetWorldTransform", "Ptr", UG, "Ptr", m)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", x, "Float", y, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
    try WDrawFrame(wd)
    DllCall("gdiplus\GdipSetWorldTransform", "Ptr", UG, "Ptr", m)
    DllCall("gdiplus\GdipDeleteMatrix", "Ptr", m)
    UCY += wd.h * k + 12
    UCardEnd()
    return Max(b1, UCY)
}

; ---------- configs (the look and on / off) and ui.ini (positions) ----------
WStyleTo() {
    global Widgets, WIdle
    o := {idle: WIdle ? 1 : 0}
    for id, wd in Widgets
        o.%id% := {on: wd.on ? 1 : 0, bg: wd.bg ? 1 : 0, border: wd.bstyle, grad: wd.grad, size: wd.scale}
    return o
}

WGet(v, name, def) => (IsObject(v) && v.HasOwnProp(name)) ? v.%name% : def

WStyleFrom(o) {
    global Widgets, WIdle
    WIdle := (IsObject(o) && o.HasOwnProp("idle")) ? (o.idle ? true : false) : false
    for id, wd in Widgets {
        v := (IsObject(o) && o.HasOwnProp(id)) ? o.%id% : {}
        wd.on := WGet(v, "on", 0) ? true : false
        wd.bg := WGet(v, "bg", id = "turn" ? 1 : 0) ? true : false
        wd.bstyle := Max(1, Min(4, Integer(WGet(v, "border", id = "turn" ? 3 : 1))))
        wd.grad := Max(1, Min(GradNames.Length, Integer(WGet(v, "grad", 1))))
        wd.scale := Max(60, Min(160, Integer(WGet(v, "size", 100))))
    }
}

; shows / hides the widgets after a config was loaded or reset
WApply() {
    global Widgets
    for id, wd in Widgets {
        want := wd.on
        if (want && (!wd.visible || wd.leaveAt))
            WSet(id, true)
        else if (!want && wd.visible)
            WSet(id, false)
        else if (wd.visible) {
            WPlace(wd)
            WRender(wd)
        }
    }
}

; ==============================================================================
;  WELCOME SCREEN (cosmic scene), CLOSING / RELOADING CARD
; ==============================================================================

Global SplashW := 760, SplashH := 400
Global Splash := ""                        ; the running welcome screen
Global SplashStars := []
Global ExitCard := "", ExitBusy := false

; the stars (built once): x / y in 0..1, depth, twinkle phase, size
SplashBuildStars() {
    global SplashStars
    if (SplashStars.Length)
        return
    Loop 130
        SplashStars.Push({x: Random(0.0, 1.0), y: Random(0.0, 1.0), z: Random(0.25, 1.0), ph: Random(0.0, 6.28), sz: Random(0.5, 1.6)})
}

SplashPlay(done) {
    global Splash, SplashW, SplashH
    UGdipInit()
    SplashBuildStars()
    g := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny welcome")
    s := UMakeSurface(SplashW, SplashH)
    Splash := {g: g, s: s, start: 0, skipAt: 0, done: done, user: A_UserName
        , fBig: UMakeFont("Segoe UI Black", 46, 0), fUser: UMakeFont("Segoe UI Semibold", 19, 0)}
    g.Show("x" ((A_ScreenWidth - SplashW) // 2) " y" ((A_ScreenHeight - SplashH) // 2 - 40) " w" SplashW " h" SplashH " NA")
    SetTimer(SplashTick, 16)
}

SplashTick() {
    global Splash
    if (!IsObject(Splash)) {
        SetTimer(SplashTick, 0)
        return
    }
    if (!Splash.start)
        Splash.start := A_TickCount
    t := A_TickCount - Splash.start
    typeEnd := 950 + StrLen(Splash.user) * 65
    holdEnd := Max(2800, typeEnd + 1000)
    if (!Splash.skipAt && t > 300 && GetKeyState("Escape", "P"))
        Splash.skipAt := t
    fadeStart := (Splash.skipAt && Splash.skipAt < holdEnd) ? Splash.skipAt : holdEnd
    fo := t >= fadeStart ? Min(1.0, (t - fadeStart) / 380) : 0.0
    SplashRender(t, fo)
    if (fo >= 1) {
        SetTimer(SplashTick, 0)
        sp := Splash, Splash := ""
        sp.g.Destroy()
        SurfaceFree(sp.s)
        DllCall("gdiplus\GdipDeleteFont", "Ptr", sp.fBig)
        DllCall("gdiplus\GdipDeleteFont", "Ptr", sp.fUser)
        if (sp.done)
            sp.done.Call()
    }
}

SurfaceFree(s) {
    hb := DllCall("GetCurrentObject", "Ptr", s.dc, "UInt", 7, "Ptr")
    DllCall("gdiplus\GdipDeleteGraphics", "Ptr", s.g)
    DllCall("DeleteDC", "Ptr", s.dc)
    if (hb)
        DllCall("DeleteObject", "Ptr", hb)
}

SplashRender(t, fo) {
    pc := A_IsCritical
    Critical
    try SplashRenderInner(t, fo)
    finally Critical(pc ? "On" : "Off")
}

; t: ms since the start, fo: 0..1 fading out
SplashRenderInner(t, fo) {
    global Splash, SplashW, SplashH, UG, UAlpha, LogoGrad, F_Sm, F_Tiny, F_B, DestinyVersion
    W := SplashW, H := SplashH
    prevG := UG, prevA := UAlpha
    UG := Splash.s.g, UAlpha := 1.0
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    ; the card grows in with a small overshoot, and zooms a little while it fades away
    ci := Min(1.0, t / 520)
    k := 0.86 + 0.14 * (1 + 2.2 * (ci - 1) ** 3 + 1.2 * (ci - 1) ** 2) + 0.05 * fo
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", W / 2, "Float", H / 2, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -W / 2, "Float", -H / 2, "Int", 0)
    alpha := UEase(t / 420) * (1 - fo) ** 1.4
    x0 := 20, y0 := 20, cw := W - 40, ch := H - 40
    st := GradStops(LogoGrad)
    sh := t / 1000 * 0.3
    try {
        URR(x0 - 4, y0 + 12, cw + 8, ch, 30, UC(0, 0, 0, 90))
        URR(x0 - 1, y0 + 4, cw + 2, ch, 28, UC(0, 0, 0, 60))
        card := UPath(x0, y0, cw, ch, 26)
        DllCall("gdiplus\GdipSetClipPath", "Ptr", UG, "Ptr", card, "Int", 0)
        ; deep space
        br := UGradBrush(x0, y0, cw, ch * 0.6, [[7, 7, 20], [22, 10, 44], [12, 6, 30]], 0)
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", card)
        DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
        ; nebula clouds, slowly drifting and breathing
        ts := t / 1000
        ac := GradSample(st, 0)
        acc := (ac[1] << 16) | (ac[2] << 8) | ac[3]
        UGlow(520 + 30 * Sin(ts * 0.5), 120 + 14 * Cos(ts * 0.4), 260, 150, 0x6D28D9, 70)
        UGlow(660 + 20 * Cos(ts * 0.6), 300, 200, 120, 0xDB2777, 46)
        UGlow(200, 150 + 16 * Sin(ts * 0.7), 230, 190, 0x4338CA, 66)
        UGlow(380, 150, 200, 70, 0xA21CAF, Round(34 + 12 * Sin(ts * 0.9)))
        UGlow(120, 340, 180, 110, acc, Round(40 + 14 * Sin(ts * 1.3)))
        SplashStarsDraw(x0, y0, cw, ch, t, 1.0)
        ; a shooting star every few seconds
        sp := Mod(t + 900, 2600)
        if (sp < 620) {
            q := sp / 620
            hx := 760 - 520 * q, hy := 40 + 150 * q
            Loop 14 {
                f := A_Index / 14
                ULine(hx + 9 * f * 12, hy - 2.6 * f * 12 - 0, hx + 9 * (f + 1 / 14) * 12, hy - 2.6 * (f + 1 / 14) * 12, UC(255, 255, 255, Round(200 * (1 - f) * Sin(q * 3.1416))), 1.6)
            }
            UDisc(hx, hy, 1.8, UC(255, 255, 255, Round(255 * Sin(q * 3.1416))))
        }
        DllCall("gdiplus\GdipResetClip", "Ptr", UG)
        ; moving gradient border
        UGradBorder(x0, y0, cw, ch, 26, st, sh, 2.2, Min(1.0, t / 300))
        SplashText(t, st, sh)
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    UG := prevG, UAlpha := prevA
    ULayered(Splash.g.Hwnd, Splash.s.dc, W, H, Round(255 * alpha))
}

; stars in three depths drifting left, twinkling (dens: share of the stars drawn)
SplashStarsDraw(x0, y0, cw, ch, t, dens) {
    global SplashStars
    n := Round(SplashStars.Length * dens)
    for i, s in SplashStars {
        if (i > n)
            break
        x := x0 + Mod(s.x * cw - t * 0.012 * s.z + cw * 4, cw)
        y := y0 + s.y * ch
        tw := 0.55 + 0.45 * Sin(t / 1000 * (1.2 + s.z * 2) + s.ph)
        a := Round(255 * s.z * tw)
        r := s.sz * (0.6 + 0.6 * s.z)
        UDisc(x, y, r, UC(235, 230, 255, a))
        if (s.sz > 1.4 && s.z > 0.7) {                        ; the bright ones sparkle
            ULine(x - r * 3, y, x + r * 3, y, UC(220, 210, 255, Round(a * 0.5)), 0.8)
            ULine(x, y - r * 3, x, y + r * 3, UC(220, 210, 255, Round(a * 0.5)), 0.8)
        }
    }
}

; the pink star: a streak of light that ignites from left to right under WELCOME, a flare at its tip that keeps pulsing
SplashStar(t, st, cx, cy, len) {
    ts := t / 1000
    e := UEase((t - 650) / 520)
    if (e <= 0.01)
        return
    pu := 0.85 + 0.15 * Sin(ts * 5)
    x1 := cx - len / 2, x2 := x1 + len * e, y1 := cy + 6, y2 := cy - 6 * (2 * e - 1)
    c := GradSample(st, ts * 0.3)
    UGlow((x1 + x2) / 2, (y1 + y2) / 2, 40 + len * 0.35 * e, 16, 0xA855F7, Round(110 * e * pu))
    ULine(x1, y1, x2, y2, UC(c[1], c[2], c[3], Round(110 * e)), 9)
    ULine(x1, y1, x2, y2, UC(216, 180, 254, Round(200 * e)), 4.5)
    ULine(x1, y1, x2, y2, UC(255, 255, 255, Round(255 * e * pu)), 1.8)
    fl := 80 + 70 * e
    UGlow(x2, y2, 24 * pu, 24 * pu, 0xFFFFFF, Round(210 * e))
    UGlow(x2, y2, 60 * pu, 40 * pu, 0xD946EF, Round(90 * e))
    ULine(x2 - fl, y2, x2 + fl, y2, UC(240, 220, 255, Round(150 * e * pu)), 1.2)
    ULine(x2, y2 - fl * 0.35, x2, y2 + fl * 0.35, UC(240, 220, 255, Round(110 * e * pu)), 1)
}

; WELCOME, the pink star, the name typing in, the brand: all centred
SplashText(t, st, sh) {
    global Splash, SplashW, UAlpha, F_Sm, F_Tiny, F_B, DestinyVersion
    fBig := Splash.fBig, fUser := Splash.fUser
    mid := SplashW / 2
    ; WELCOME: letters drop in one by one in the logo gradient
    txt := "WELCOME", n := StrLen(txt)
    advs := [], total := 0
    Loop n {
        chr_ := SubStr(txt, A_Index, 1)
        advs.Push(UTextW(chr_ chr_, fBig) - UTextW(chr_, fBig) + 2)
        total += advs[A_Index]
    }
    x := mid - total / 2
    Loop n {
        chr_ := SubStr(txt, A_Index, 1)
        kk := UEase((t - 250 - (A_Index - 1) * 60) / 260)
        if (kk > 0.01) {
            c := GradSample(st, (A_Index - 1) / n * 0.85 - sh)
            UAlpha := kk
            yy := 62 - (1 - kk) * 22
            UText(chr_, x, yy + 3, UC(c[1], c[2], c[3], 70), fBig, 80, 70, 0, 1)
            UText(chr_, x, yy, UC(c[1], c[2], c[3]), fBig, 80, 70, 0, 1)
            UAlpha := 1.0
        }
        x += advs[A_Index]
    }
    ; a gradient line draws out from the middle, the pink star streaks across it
    lw := 340 * UEase((t - 720) / 360)
    if (lw > 2)
        UGradFill(mid - lw / 2, 146, lw, 3, 1.5, st, sh, 0.8, 340)
    SplashStar(t, st, mid, 147, 300)
    ; the user name types into a pill
    pe := UEase((t - 820) / 260)
    if (pe > 0.01) {
        user := Splash.user, un := StrLen(user)
        pw := Min(320, UTextW(user, fUser) + 70)
        px := mid - pw / 2, py := 176 + (1 - pe) * 10
        UAlpha := pe
        URR(px, py, pw, 44, 22, UC(20, 16, 40, 230))
        UGradBorder(px, py, pw, 44, 22, st, sh, 1.2, 0.6)
        c1 := GradSample(st, -sh)
        UDisc(px + 22, py + 22, 4.5, UC(c1[1], c1[2], c1[3]))
        u := Max(0, Min(un, (t - 950) // 65))
        typed := SubStr(user, 1, u)
        UText(typed, px + 38, py, UC(243, 243, 246), fUser, pw - 46, 44, 0, 1)
        if (u < un || Mod(t // 260, 2) = 0) {
            cx := px + 38 + (u > 0 ? UTextW(typed, fUser) - 2 : 0)
            URR(cx, py + 11, 2.4, 22, 1.2, UC(c1[1], c1[2], c1[3]))
        }
        UAlpha := 1.0
    }
    ; the brand and version
    sk := UEase((t - 1150) / 420)
    if (sk > 0.01) {
        UAlpha := sk
        UText("D E S T I N Y   //   T S B", 0, 248, UC(200, 196, 220), F_B, SplashW, 22, 1, 1)
        vw := UTextW(DestinyVersion, F_Tiny) + 22
        sub := "The Strongest Battlegrounds"
        rw := vw + 10 + UTextW(sub, F_Tiny)
        vx := mid - rw / 2
        URR(vx, 282, vw, 22, 11, UC(255, 255, 255, 14))
        c2 := GradSample(st, 0.3 - sh)
        UText(DestinyVersion, vx, 282, UC(c2[1], c2[2], c2[3]), F_Tiny, vw, 22, 1, 1)
        UText(sub, vx + vw + 10, 282, UC(150, 146, 172), F_Tiny, 240, 22, 0, 1)
        UText("Esc to skip", 0, 344, UC(120, 116, 140), F_Tiny, SplashW, 18, 1, 1)
        UAlpha := 1.0
    }
}

; ---------- closing / reloading: the menu and the widgets fade away, a small card says what is happening ----------
DestinyExit(*) {
    DestinyLeave("Closing Destiny", () => ExitApp())
}

DestinyLeave(text, then) {
    global ExitBusy, UShown, Widgets
    if (ExitBusy)
        return
    ExitBusy := true
    SetTimer(then, -2600)                                     ; (safety: it goes on even if the animation fails)
    try HudOff()
    for id, wd in Widgets
        try WSet(id, false)
    if (UShown)
        try UHide()
    try ExitCardShow(text, then)
    catch
        then.Call()
}

ExitCardShow(text, then) {
    global ExitCard
    UGdipInit()
    SplashBuildStars()
    g := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny closing")
    s := UMakeSurface(340, 90)
    ExitCard := {g: g, s: s, text: text, then: then, start: A_TickCount}
    ExitCardRender(0, 0)
    g.Show("x" ((A_ScreenWidth - 340) // 2) " y" ((A_ScreenHeight - 90) // 2) " w340 h90 NA")
    SetTimer(ExitCardTick, 15)
}

ExitCardTick() {
    global ExitCard
    if (!IsObject(ExitCard)) {
        SetTimer(ExitCardTick, 0)
        return
    }
    el := A_TickCount - ExitCard.start
    ExitCardRender(Min(1.0, el / 1100), el)
    if (el >= 1100) {
        SetTimer(ExitCardTick, 0)
        ExitCard.then.Call()
    }
}

ExitCardRender(t, el) {
    pc := A_IsCritical
    Critical
    try ExitCardRenderInner(t, el)
    finally Critical(pc ? "On" : "Off")
}

; t: 0..1 over the whole card
ExitCardRenderInner(t, el) {
    global ExitCard, UG, UAlpha, LogoGrad, F_B, F_Tiny
    prevG := UG, prevA := UAlpha
    UG := ExitCard.s.g, UAlpha := 1.0
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    a := Min(1.0, t * 5)
    if (t > 0.84)
        a := Max(0.0, 1 - (t - 0.84) / 0.16)
    k := 0.9 + 0.1 * UEase(t * 5)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", 170, "Float", 45, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -170, "Float", -45, "Int", 0)
    st := GradStops(LogoGrad)
    sh := el / 1000 * 0.5
    try {
        URR(6, 12, 328, 72, 20, UC(0, 0, 0, 80))
        card := UPath(6, 6, 328, 72, 19)
        br := UGradBrush(6, 6, 328, 72, [[8, 8, 22], [24, 12, 46], [12, 7, 30]], 0)
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", card)
        DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
        DllCall("gdiplus\GdipSetClipPath", "Ptr", UG, "Ptr", card, "Int", 0)
        UGlow(260, 20, 120, 50, 0x6D28D9, 60)
        SplashStarsDraw(6, 6, 328, 72, el * 3, 0.45)
        DllCall("gdiplus\GdipResetClip", "Ptr", UG)
        UGradBorder(6, 6, 328, 72, 19, st, sh, 2)
        ; a small orb that spins
        c := GradSample(st, -sh)
        UGlow(34, 42, 16, 16, (c[1] << 16) | (c[2] << 8) | c[3], 150)
        UDisc(34, 42, 5, UC(255, 255, 255))
        ang := el / 1000 * 5
        URing(34, 42, 11, UC(c[1], c[2], c[3], 120), 1.2)
        UDisc(34 + 11 * Cos(ang), 42 + 11 * Sin(ang), 2.2, UC(255, 255, 255))
        dots := SubStr("...", 1, Mod(Floor(el / 110), 3) + 1)
        UText(ExitCard.text dots, 58, 16, UC(243, 243, 246), F_B, 260, 24, 0, 1)
        e := 1 - (1 - Min(1.0, t * 1.08)) ** 2
        URR(58, 52, 254, 6, 3, UC(255, 255, 255, 22))
        if (e > 0.01)
            UGradFill(58, 52, Max(6, 254 * e), 6, 3, st, sh, 1.0, 254)
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    UG := prevG, UAlpha := prevA
    ULayered(ExitCard.g.Hwnd, ExitCard.s.dc, 340, 90, Round(255 * a))
}

