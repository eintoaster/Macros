;  LAGSWITCH SYSTEM (NTDLL NT-SUSPEND)


ApplyLagSettings(*) {
    global FreezeDuration, EditLagDur, LagStatusText
    val := Integer(EditLagDur.Value)
    if (val < 1 || val > 10000)
        val := 250
    FreezeDuration := val
    EditLagDur.Value := val
    LagStatusText.Text := "Status: Applied (" FreezeDuration "ms)"
}

TestFreeze(*) {
    global LagStatusText
    LagStatusText.Text := "Status: Testing Freeze..."
    ExecuteLagswitch()
    LagStatusText.Text := "Status: Ready"
}

ExecuteLagswitch(*) {
    global FreezeDuration, TargetProcess, LagKey, IsLagPrecision, IsLagBurst, LagBurstCount, IsLagHold, IsLagVignette, LagStatusText
    
    RobloxPID := ProcessExist(TargetProcess)
    if (!RobloxPID) {
        LagStatusText.Text := "Status: Roblox not running!"
        return
    }
    
    if (IsLagVignette)
        ShowVignette()
    
    if (IsLagPrecision)
        DllCall("winmm\timeBeginPeriod", "UInt", 1)
        
    hProcess := DllCall("OpenProcess", "UInt", 0x1F0FFF, "Int", 0, "UInt", RobloxPID)
    if (hProcess) {
        BlinkIndicator(4)
        if (IsLagHold && LagKey != "") {
            LagStatusText.Text := "Status: Freezing (Hold)..."
            DllCall("ntdll\NtSuspendProcess", "Ptr", hProcess)
            cleanKey := RegExReplace(LagKey, "^[~*$&<>]", "")
            try KeyWait(cleanKey)
            DllCall("ntdll\NtResumeProcess", "Ptr", hProcess)
            LagStatusText.Text := "Status: Resumed"
        } else if (IsLagBurst) {
            LagStatusText.Text := "Status: Freeze Burst..."
            baseBurst := Max(10, Round(FreezeDuration / LagBurstCount))
            Loop LagBurstCount {
                DllCall("ntdll\NtSuspendProcess", "Ptr", hProcess)
                Sleep(baseBurst)
                DllCall("ntdll\NtResumeProcess", "Ptr", hProcess)
                if (A_Index < LagBurstCount)
                    Sleep(15)
            }
        } else {
            LagStatusText.Text := "Status: Frozen " FreezeDuration "ms"
            DllCall("ntdll\NtSuspendProcess", "Ptr", hProcess)
            Sleep(FreezeDuration)
            DllCall("ntdll\NtResumeProcess", "Ptr", hProcess)
        }
        DllCall("CloseHandle", "Ptr", hProcess)
    }
    
    if (IsLagPrecision)
        DllCall("winmm\timeEndPeriod", "UInt", 1)
        
    if (IsLagVignette)
        HideVignette()
        
    SetTimer(() => LagStatusText.Text := "Status: Ready", -2000)
}

ShowVignette() {
    global VignetteGuis, VignetteColor, VignetteThickness
    if (VignetteGuis.Length = 0) {
        sw := A_ScreenWidth
        sh := A_ScreenHeight
