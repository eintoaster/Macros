; Label + value on one line, thin track with accent fill underneath.
class FlatSlider {
    __New(x, y, w, text, min, max, val, fmt, onChange) {
        this.min := min, this.max := max, this.w := w, this.fmt := fmt, this.onChange := onChange
        lbl := Track(MainGui.Add("Text", "x" x " y" y " w" (w - 60) " h18 +0x200 Background" C_ChildBg " c" C_Text, text))
        lbl.SetFont("s9", UI_Font)
        this.valLbl := Track(MainGui.Add("Text", "x" (x + w - 60) " y" y " w60 h18 Right +0x200 Background" C_ChildBg " c" C_TextDim))
        this.valLbl.SetFont("s9", UI_Font)
        this.track := Track(MainGui.Add("Text", "x" x " y" (y + 24) " w" w " h8 Background" C_Frame))
        this.fill := Track(MainGui.Add("Text", "x" x " y" (y + 24) " w1 h8 Background" C_Accent))
        this.x := x, this.y := y + 24
        drag := ObjBindMethod(this, "Drag")
        this.track.OnEvent("Click", drag)
        this.fill.OnEvent("Click", drag)
        this.Value := val
    }
    Value {
        get => this.val
        set {
            this.val := Max(this.min, Min(this.max, Round(value)))
            fw := Max(1, Round((this.val - this.min) / (this.max - this.min) * this.w))
            this.fill.Move(this.x, this.y, fw, 8)
            this.fill.Redraw()
            this.valLbl.Text := Format(this.fmt, this.val)
        }
    }
    Drag(*) {
        rc := Buffer(16, 0)
        DllCall("GetWindowRect", "Ptr", this.track.Hwnd, "Ptr", rc)
        left := NumGet(rc, 0, "Int"), right := NumGet(rc, 8, "Int")
        last := ""
        while GetKeyState("LButton", "P") {
            MouseGetPos(&mx)
            ratio := Max(0, Min(1, (mx - left) / (right - left)))
            this.Value := this.min + ratio * (this.max - this.min)
            if (this.val != last) {
                last := this.val
                if (this.onChange)
                    this.onChange.Call(this.val)
            }
            Sleep(15)
        }
    }
}

; Box showing the selected item; click opens a popup menu.
; Exposes .Text, .Delete() and .Add() like a DropDownList.
class FlatDropdown {
    __New(x, y, w, items, onChange) {
        this.items := [], this.cur := "", this.onChange := onChange
        Track(MainGui.Add("Text", "x" x " y" y " w" w " h27 Background" C_Border))
        this.box := Track(MainGui.Add("Text", "x" (x + 1) " y" (y + 1) " w" (w - 2) " h25 +0x200 Background" C_Frame " c" C_Text))
        this.box.SetFont("s9", UI_Font)
        this.arrow := Track(MainGui.Add("Text", "x" (x + w - 24) " y" (y + 1) " w20 h25 Center +0x200 Background" C_Frame " c" C_TextDim, Chr(0xE70D)))
        this.arrow.SetFont("s7", UI_Icons)
        open := ObjBindMethod(this, "Open")
        this.box.OnEvent("Click", open)
        this.arrow.OnEvent("Click", open)
        this.Add(items)
    }
    Text {
        get => this.cur
        set {
            this.cur := value
            this.box.Text := "   " value
        }
    }
    Add(arr) {
        for it in arr
            this.items.Push(it)
        if (this.cur = "" && this.items.Length)
            this.Text := this.items[1]
    }
    Delete() {
        this.items := []
        this.Text := ""
    }
    Open(*) {
        if (!this.items.Length)
            return
        m := Menu()
        for it in this.items {
            m.Add(it, ObjBindMethod(this, "Pick", it))
            if (it = this.cur)
                m.Check(it)
        }
        rc := Buffer(16, 0)
        DllCall("GetWindowRect", "Ptr", this.box.Hwnd, "Ptr", rc)
        m.Show(NumGet(rc, 0, "Int") - 1, NumGet(rc, 12, "Int") + 1)
    }
    Pick(it, *) {
        this.Text := it
        if (this.onChange)
            this.onChange.Call()
    }
}


;  HOVER TRACKING


AddHover(ctrl, onFn, offFn) {
    global HoverItems
    HoverItems[ctrl.Hwnd] := {on: onFn, off: offFn}
}

WM_MOUSEMOVE(wParam, lParam, msg, hwnd) {
    global HoverHwnd, HoverItems
    if (hwnd = HoverHwnd)
        return
    if (HoverHwnd && HoverItems.Has(HoverHwnd))
        HoverItems[HoverHwnd].off.Call()
    HoverHwnd := HoverItems.Has(hwnd) ? hwnd : 0
    if (HoverHwnd) {
        HoverItems[HoverHwnd].on.Call()
        SetTimer(HoverLeaveCheck, 50)
    }
}

HoverLeaveCheck() {
    global HoverHwnd, HoverItems
    if (!HoverHwnd) {
        SetTimer(HoverLeaveCheck, 0)
        return
    }
    rc := Buffer(16, 0)
    DllCall("GetWindowRect", "Ptr", HoverHwnd, "Ptr", rc)
    MouseGetPos(&mx, &my)
    inside := mx >= NumGet(rc, 0, "Int") && mx < NumGet(rc, 8, "Int") && my >= NumGet(rc, 4, "Int") && my < NumGet(rc, 12, "Int")
    if (!inside || !DllCall("IsWindowVisible", "Ptr", HoverHwnd)) {
        if HoverItems.Has(HoverHwnd)
            HoverItems[HoverHwnd].off.Call()
        HoverHwnd := 0
        SetTimer(HoverLeaveCheck, 0)
    }
}

