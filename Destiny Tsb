SaveCustomProfile(*) {
    global EditProfileName
    name := Trim(EditProfileName.Value)
    if (name = "") {
        ShowStatus("ENTER PROFILE NAME", "0x2A0808", 500)
        return
    }
    SaveProfileInternal(name)
    RefreshProfileList()
}

LoadCustomProfile(*) {
    global ProfileDDL
    name := ProfileDDL.Text
    if (name = "") {
        ShowStatus("SELECT PROFILE", "0x2A0808", 500)
        return
    }
    LoadProfileInternal(name)
}

DeleteCustomProfile(*) {
    global ProfileDDL, ConfigDir, ConfigExt
    name := ProfileDDL.Text
    if (name = "")
        return
    filePath := ConfigDir "\" name ConfigExt
    try FileDelete(filePath)
    RefreshProfileList()
    ShowStatus("PROFILE DELETED", "0x2A0808", 500)
}

RefreshProfileList() {
    global ConfigDir, ConfigExt, ProfileDDL
    EnsureConfigDir()
    ProfileDDL.Delete()
    Loop Files, ConfigDir "\*" ConfigExt {
        ProfileDDL.Add([SubStr(A_LoopFileName, 1, -StrLen(ConfigExt))])
    }
}

