Global ChangeLog := [["Destiny v1 Beta", [
    "New Destiny Menu",
    "Added New Macro HUD",
    "Added Notifications",
    "Keybinds saving",
    "Backdash cancel macros",
    "Dash Recorder: record your own extender",
    "Misc tab: Visuals and Input Monitor (keys with space, mouse buttons, camera turn)",
    "Configs Saving"]]]

UBulletRow(text) {
    global UCX, UCY, UCW, F_Sm
    tw := UCW - 54
    lines := Max(1, Ceil(UTextW(text, F_Sm) / (tw - 6)))
    h := lines * 17 + 6
    UDisc(UCX + 24, UCY + 12, 2.6, UAcc())
    UText(text, UCX + 34, UCY + 3, UCol("Text2"), F_Sm, tw, h, 0, 0, true)
    UCY += h + 3
}

UChangelogCard() {
    global ChangeLog, UCX, UCY, UCW, F_B, F_Tiny
    UCardBegin("c_log", "Changelog", Chr(0xE81C))
    for i, v in ChangeLog {
        UText(v[1], UCX + 18, UCY + 2, UCol("Text"), F_B, 200, 24, 0, 1)
        if (i = 1) {
            URR(UCX + UCW - 76, UCY + 3, 58, 20, 10, UAcc(40))
            UText("latest", UCX + UCW - 76, UCY + 3, UAcc(), F_Tiny, 58, 20, 1, 1)
        }
        UCY += 30
        for line in v[2]
            UBulletRow(line)
        UCY += 6
    }
    UCardEnd()
}

