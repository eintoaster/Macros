isAppMinimized := false

MinimizeApp(*) {
    global MainGui, isAppMinimized
    MainGui.Hide()
    isAppMinimized := true
}

ToggleMainGui(*) {
    global MainGui, isAppMinimized
    if (isAppMinimized) {
        MainGui.Show()
        isAppMinimized := false
    } else {
        MainGui.Hide()
        isAppMinimized := true
    }
}

