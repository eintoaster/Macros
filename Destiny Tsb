class UVal {
    __New(v := "") {
        this._v := v
    }
    Value {
        get => this._v
        set {
            this._v := value
            UReq()
        }
    }
    Text {
        get => this._v
        set {
            this._v := value
            if (InStr(value, "Press"))                       ; a key box starts listening: show it right now
                UShowListening()
            UReq()
        }
    }
}

UMouseOverMenu() {
