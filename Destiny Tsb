; A card grows / shrinks smoothly to the height its rows needed in the last frame.
UCardBegin(id, title, icon := "") {
    global UCX, UCY, UCW, UCardTop, UCardId, UCardH, F_B, F_IconSm
    UCardId := id, UCardTop := UCY
    h := ULerp("ch" id, UCardH.Get(id, 120), 0.25)
    URR(UCX, UCY + 3, UCW, h, 16, UC(0, 0, 0, 40))
    URR(UCX, UCY, UCW, h, 16, UCol("Card", 235))
    UGradFill(UCX, UCY, UCW, 46, 16, [UHexArr(AccentColor), UPal("Card")], 0, 0.07, UCW * 2)
    URRLine(UCX, UCY, UCW, h, 16, UCol("Border"))
    tx := UCX + 18
    if (icon != "") {
        URR(UCX + 16, UCY + 14, 22, 22, 7, UAcc(38))
        UText(icon, UCX + 16, UCY + 14, UAcc(), F_IconSm, 22, 22, 1, 1)
        tx := UCX + 46
    }
    UText(title, tx, UCY + 14, UCol("Text"), F_B, UCW - 70, 22, 0, 1)
    ULine(UCX + 16, UCY + 46, UCX + UCW - 16, UCY + 46, UCol("Border"))
    UCY += 54
}

UCardEnd() {
    global UCY, UCardTop, UCardId, UCardH, UAnimating
    UCY += 8
    h := UCY - UCardTop
    if (!UCardH.Has(UCardId))
        UAnimSet("ch" UCardId, h)                           ; (first time: no growing out of a guess)
    if (UCardH.Get(UCardId, 0) != h) {
        UCardH[UCardId] := h
        UAnimating := true
    }
    UCY := UCardTop + h + 16
}

URowHover(id, h) {
    global UCX, UCY, UCW, UHover
    hv := ULerp("h" id, UHover = id ? 1 : 0, 0.22)
    if (hv > 0.01)
        URR(UCX + 6, UCY, UCW - 12, h, 11, UCol("Hover", Round(255 * hv)))
    return hv
}

UToggleRow(id, label, desc, on, fn) {
    global UCX, UCY, UCW, F_UI, F_Sm
    two := (desc != "" && UTextW(desc, F_Sm) > UCW - 96)       ; (a long description gets a second line)
    h := (desc = "") ? 40 : two ? 68 : 52
    URowHover(id, h)
    t := ULerp(id, on ? 1 : 0, 0.2)
    if (desc = "") {
        UText(label, UCX + 18, UCY, UCol("Text"), F_UI, UCW - 90, h, 0, 1)
    } else {
        UText(label, UCX + 18, UCY + 7, UCol("Text"), F_UI, UCW - 90, 20, 0, 1)
        UText(desc, UCX + 18, UCY + 27, UCol("Muted"), F_Sm, UCW - 96, two ? 36 : 18, 0, 0, two)
    }
    sx := UCX + UCW - 18 - 42, sy := UCY + h / 2 - 11.5
    URR(sx, sy, 42, 23, 11.5, UCol("Off"))
    if (t > 0.01) {
        UGradFill(sx, sy, 42, 23, 11.5, GradStops(1), 0, t, 84)
        URR(sx - 3, sy - 3, 48, 29, 14.5, UAcc(Round(26 * t)))
    }
    UDisc(sx + 11.5 + 19 * t, sy + 11.5, 8.5, UC(255, 255, 255))
    UHitP(id, UCX + 6, UCY, UCW - 12, h, UToggleAct.Bind(fn, label, on))
    UCY += h + 2
}

USliderRow(id, label, minv, maxv, val, setter, fmt := "{}") {
    global UCX, UCY, UCW, USlider, UHover, F_UI, F_Sm
    h := 56
    drag := IsObject(USlider) && USlider.id = id
    URowHover(id, h)
    t := ULerp(id, (Max(minv, Min(maxv, val)) - minv) / (maxv - minv), drag ? 0.6 : 0.2)
    UText(label, UCX + 18, UCY + 6, UCol("Text"), F_UI, UCW - 110, 22, 0, 1)
    txt := Format(fmt, val)
    cw := UTextW(txt, F_Sm) + 18
    URR(UCX + UCW - 18 - cw, UCY + 7, cw, 20, 10, drag ? UAcc(50) : UCol("Pill"))
    UText(txt, UCX + UCW - 18 - cw, UCY + 7, drag ? UCol("Text") : UCol("Text2"), F_Sm, cw, 20, 1, 1)
    tx := UCX + 20, tw := UCW - 40, ty := UCY + 38
    URR(tx, ty, tw, 5, 2.5, UCol("Track"))
    UGradFill(tx, ty, Max(5, tw * t), 5, 2.5, GradStops(1), 0, 1.0, tw)
    hot := drag || UHover = id
    gl := ULerp(id "g", hot ? 1 : 0, 0.25)
    if (gl > 0.01)
        UDisc(tx + tw * t, ty + 2.5, 12, UAcc(Round(55 * gl)))
    UDisc(tx + tw * t, ty + 2.5, 7, UC(255, 255, 255))
    UHitP(id, tx - 10, UCY + 26, tw + 20, 26, "slider", {id: id, min: minv, max: maxv, tx: tx, tw: tw, setter: setter, last: val, label: label, fmt: fmt})
    UCY += h + 2
}

UKeyRow(id, label, box, starter) {
    global UCX, UCY, UCW, F_UI, F_Sm
    h := 42
    URowHover(id, h)
    UText(label, UCX + 18, UCY, UCol("Text"), F_UI, UCW - 160, h, 0, 1)
    listening := InStr(box.Text, "Press") ? true : false
    txt := listening ? "press a key..." : box.Text
    none := (txt = "NONE")
    cw := Max(70, UTextW(txt, F_Sm) + 24)
    bx := UCX + UCW - 18 - cw, by := UCY + 8
    URR(bx, by, cw, 26, 9, UCol("Pill"))
    if (listening) {
        p := 0.5 + 0.5 * Sin(A_TickCount / 160)
        URR(bx, by, cw, 26, 9, UAcc(Round(30 + 30 * p)))
        URRLine(bx, by, cw, 26, 9, UAcc(Round(150 + 105 * p)))
    } else
        URRLine(bx, by, cw, 26, 9, UCol("Border"))
    UText(txt, bx, by, listening ? UCol("Text") : (none ? UCol("Muted") : UCol("Text2")), F_Sm, cw, 26, 1, 1)
    UHitP(id, UCX + 6, UCY, UCW - 12, h, UKeyAct.Bind(starter, label, box))
    UCY += h + 2
}

UDropRow(id, label, list) {
    global UCX, UCY, UCW, UDD, UHover, F_UI, F_Sm, F_IconSm
    h := 42
    URowHover(id, h)
    UText(label, UCX + 18, UCY, UCol("Text"), F_UI, UCW - 190, h, 0, 1)
    pw := Min(Max(160, UTextW(list.Text, F_Sm) + 64), UCW - 150)     ; (long items get a wider box)
    bx := UCX + UCW - 18 - pw, by := UCY + 8
    isOpen := IsObject(UDD) && UDD.id = id && UDD.open
    URR(bx, by, pw, 26, 9, UCol("Pill"))
    URRLine(bx, by, pw, 26, 9, isOpen ? UAcc(200) : UCol("Border"))
    txt := list.Text
    tx := bx + 12
    if (list = AccentDDL && list.Value) {
        p := AccentPresets[list.Value]
        UGradFill(bx + 10, by + 8, 18, 10, 5, [UHexArr(p.a), UHexArr(p.b)])
        tx := bx + 36
    } else if ((list = LogoGradDDL || list = HudGradDDL) && list.Value) {
        UGradFill(bx + 10, by + 8, 18, 10, 5, GradStops(list.Value), A_TickCount / 1000 * 0.2, 1.0, 36)
        tx := bx + 36
    }
    UText(txt = "" ? "none yet" : txt, tx, by, txt = "" ? UCol("Muted") : UCol("Text"), F_Sm, pw - (tx - bx) - 24, 26, 0, 1)
    UText(isOpen ? Chr(0xE70E) : Chr(0xE70D), bx + pw - 24, by, UCol("Muted"), F_IconSm, 18, 26, 1, 1)
    if (IsObject(UDD) && UDD.id = id)
        UDD.ax := bx, UDD.ay := by, UDD.aw := pw
    UHitP(id, UCX + 6, UCY, UCW - 12, h, UOpenDD.Bind(id, list, label))
    UCY += h + 2
}

UEditRow(id, label, value, kind, setter, suffix := "") {
    global UCX, UCY, UCW, UEdit, F_UI, F_Sm
    h := 42
    URowHover(id, h)
    UText(label, UCX + 18, UCY, UCol("Text"), F_UI, UCW - 170, h, 0, 1)
    editing := IsObject(UEdit) && UEdit.id = id
    fw := (kind = "text") ? 150 : 100
    bx := UCX + UCW - 18 - fw, by := UCY + 8
    URR(bx, by, fw, 26, 9, UCol("Pill"))
    URRLine(bx, by, fw, 26, 9, editing ? UAcc(220) : UCol("Border"))
    if (editing) {
        caret := Mod(A_TickCount // 500, 2) ? "" : "|"
        UText(UEdit.buf caret, bx + 10, by, UCol("Text"), F_Sm, fw - 20, 26, 0, 1)
    } else {
        UText(value, bx + 10, by, UCol("Text2"), F_Sm, fw - 20 - (suffix != "" ? 22 : 0), 26, 0, 1)
        if (suffix != "")
            UText(suffix, bx, by, UCol("Muted"), F_Sm, fw - 10, 26, 2, 1)
    }
    UHitP(id, UCX + 6, UCY, UCW - 12, h, UEditStart.Bind(id, value, kind, setter))
    UCY += h + 2
